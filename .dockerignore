# ============================================
# Docker 忽略文件清单
# ============================================
# 减小构建上下文大小，加快构建速度

# Python 相关
__pycache__/
**/__pycache__/
*.py[cod]
**/*.pyc
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.manifest
*.spec

# 虚拟环境
.venv/
venv/
ENV/
env/
virtualenv/

# IDE 和编辑器
.superpowers/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.project
.pydevproject
.settings/
*.sublime-project
*.sublime-workspace

# 测试和覆盖率
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.log
reports/
!reports/release-provider/
!reports/release-provider/**
.cache
.mypy_cache/
.dmypy.json
dmypy.json
ruff_cache/

# 数据库
*.sql
*.sqlite
*.db
docker_data/
backups/

# 日志
logs/
*.log

# 环境变量 (使用 docker-compose 环境变量)
.env
.env.local
.env.*.local

# Git
.git/
.gitignore
.gitattributes

# Docker 相关
Dockerfile*
docker-compose*.yml
!Dockerfile
!docker-compose.yml
!docker-compose.deploy.yml
!docker-compose.ci-heavy.yml
!docker-compose.frontend.yml
!docker-compose.test-deploy.yml
!docker-compose.wms-acceptance.yml
.dockerignore
.docker/

# 文档
README.md
docs/
*.md
!README.md

# CI tests require plugin template docs inside the testing image.
!docs/
!docs/plugin_development_guide.md
!docs/templates/
!docs/templates/workline_plugin/
!docs/templates/workline_plugin/**

# 临时文件
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
backups/

# 操作系统
.DS_Store
Thumbs.db
desktop.ini

# 项目特定
migrations/versions/*.pyc
locustfiles/
nginx/*
!nginx/nginx.conf
!nginx/conf.d/
!nginx/conf.d/default.conf
redis/
!redis/
!redis/**
postgresql/

# 开发工具配置
.ruff.toml
.mypy.ini
pytest.ini
.setup.py

# 锁文件
!uv.lock

# Node.js (如果有前端资源)
node_modules/
npm-debug.log
yarn-error.log
package-lock.json
yarn.lock

# 其他
*.pid
*.seed
*.pid.lock
.editorconfig
.prettierrc
.eslintrc
