PROJECT_NAME=P9 WES
VERSION=0.1.0
DESCRIPTION=英伟达休斯顿 P9 仓库自动化执行系统
DATETIME_FORMAT=%Y-%m-%d
API_PATH=/api

APP_DEBUG=True
APP_HOST=0.0.0.0
APP_PORT=8001

# Redis URL 会根据下方配置自动构建
# 格式: redis://:[PASSWORD]@[HOST]:[PORT]/[DB]
# 无需手动设置 REDIS_URL

# Celery 配置（使用 Redis）
CELERY_BROKER_URL=redis://:CHANGE_THIS_REQUIRED@redis:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_THIS_REQUIRED@redis:6379/2

WMS_BASE_URL=http://localhost:8001
WMS_API_KEY=your-api-key-here


# ========================================
# 日志 配置
# ========================================

# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# 日志目录 (相对于项目根目录)
LOG_DIR=logs
# 日志文件轮转大小
LOG_ROTATION_SIZE=100 MB
# 日志保留天数
LOG_RETENTION_DAYS=7 days
# 生产环境启用JSON格式输出
LOG_JSON_OUTPUT=False
# 日志压缩格式
LOG_COMPRESSION=zip


# ========================================
# 数据库 配置
# ========================================

# 数据库主机名（本地开发用 localhost，Docker Compose 用 db）
POSTGRES_HOST=localhost
# 数据库端口
POSTGRES_PORT=5432
# 数据库用户名
POSTGRES_USER=wes_user
# 数据库密码（⚠️ 必须修改 - 使用强随机密码）
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=CHANGE_THIS_REQUIRED
# 数据库名称
POSTGRES_DB=wes_db

# DATABASE_URL 会根据上方配置自动构建
# 格式: postgresql+asyncpg://[USER]:[PASSWORD]@[HOST]:[PORT]/[DB]
# 无需手动设置 DATABASE_URL

# ========================================
# Redis 配置
# ========================================

# Redis 主机名
REDIS_HOST=redis
# Redis 端口
REDIS_PORT=6379
# Redis 密码（⚠️ 生产环境必须启用）
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(16))"
REDIS_PASSWORD=CHANGE_THIS_REQUIRED
# Redis 数据库编号
REDIS_DB=0

# ========================================
# 雪花ID 配置（分布式唯一ID生成 - 53位方案）
# ========================================

# 是否启用雪花 ID 作为默认主键
# 部署说明：
# - true（推荐）：使用雪花算法生成全局唯一ID，适合分布式系统
# - false：使用数据库自增ID，适合单机应用
# - 启用后，所有使用 PrimaryKeyMixin 的模型将自动使用雪花ID
# - 修改此配置需要创建数据库迁移
USE_SNOWFLAKE_ID=false

# 数据中心 ID（0-7，用于标识不同数据中心或机房）
# 部署说明：
# - 单机部署：使用默认值 0
# - 多机房部署：每个机房使用不同的 ID（如：北京=0, 上海=1, 广州=2）
SNOWFLAKE_DATACENTER_ID=0

# 工作机器 ID（0-7，用于标识同一数据中心内的不同服务器）
# 部署说明：
# - 单实例：使用默认值 0
# - 多实例部署：每个实例使用不同的 ID（如：实例1=0, 实例2=1）
SNOWFLAKE_WORKER_ID=0

# 纪元时间戳（EPOCH）- 雪花ID的时间起点（毫秒级Unix时间戳）
# 默认值：1704067200000（2024-01-01 00:00:00 UTC）
# ⚠️ 重要提示：
# 1. 所有节点必须使用相同的 EPOCH，否则会生成重复 ID
# 2. 修改 EPOCH 会导致生成的 ID 格式发生变化
# 3. 仅在以下情况修改：
#    - 时间戳即将耗尽（约2093年）
#    - 测试环境需要特殊的时间窗口
# 4. 滚动 EPOCH 策略：将 EPOCH 向前移动，使时间戳差值重新从0开始
# 获取时间戳：python -c "import time; print(int(time.time() * 1000))"
# 或指定日期：python -c "from datetime import datetime; print(int(datetime(2024,1,1).timestamp() * 1000))"
SNOWFLAKE_EPOCH=1704067200000


# ========================================
# JWT 认证配置
# ========================================

# JWT 密钥（⚠️ 生产环境必须使用强随机密钥）
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_THIS_REQUIRED_MIN_32_CHARS

# JWT 算法（默认: HS256）
JWT_ALGORITHM=HS256

# Access Token 过期时间（秒，默认: 3600 = 1小时）
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=3600

# Refresh Token 过期时间（秒，默认: 604800 = 7天）
JWT_REFRESH_TOKEN_EXPIRE_SECONDS=604800