PROJECT_NAME=P9 WES
VERSION=0.1.0
DESCRIPTION=英伟达休斯顿 P9 仓库自动化执行系统
DATETIME_FORMAT=%Y-%m-%d
API_PATH=/api

APP_DEBUG=True
APP_HOST=0.0.0.0
APP_PORT=8001

REDIS_URL=redis://localhost:6379/0

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

WMS_BASE_URL=http://localhost:8001
WMS_API_KEY=your-api-key-here


# ========================================
# 日志 配置
# ========================================

# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# 日志目录 (相对于项目根目录)
LOG_DIR=logs
# 日志文件轮转大小
LOG_ROTATION_SIZE=100 MB
# 日志保留天数
LOG_RETENTION_DAYS=7 days
# 生产环境启用JSON格式输出
LOG_JSON_OUTPUT=False
# 日志压缩格式
LOG_COMPRESSION=zip


# ========================================
# 数据库 配置
# ========================================

# 数据库主机名（Docker Compose 内部 DNS）
POSTGRES_HOST=db
# 数据库端口
POSTGRES_PORT=5432
# 数据库用户名
POSTGRES_USER=wes_user
# 数据库密码（⚠️ 生产环境必须修改为强密码）
POSTGRES_PASSWORD=changeme123
# 数据库名称
POSTGRES_DB=wes_db
# 数据库连接地址
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ========================================
# Redis 配置
# ========================================

# Redis 主机名
REDIS_HOST=redis
# Redis 端口
REDIS_PORT=6379
# Redis 密码（可选，⚠️ 生产环境建议启用）
REDIS_PASSWORD=