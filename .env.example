PROJECT_NAME=P9 WES
VERSION=0.1.0
DESCRIPTION=仓库执行系统
DATETIME_FORMAT=%Y-%m-%d
API_PATH=/api

APP_DEBUG=True
APP_HOST=0.0.0.0
APP_PORT=8001

# 日志配置
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# 日志目录 (相对于项目根目录)
LOG_DIR=logs
# 日志文件轮转大小
LOG_ROTATION_SIZE=100 MB
# 日志保留天数
LOG_RETENTION_DAYS=7 days
# 生产环境启用JSON格式输出
LOG_JSON_OUTPUT=False
# 日志压缩格式
LOG_COMPRESSION=zip

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wes
REDIS_URL=redis://localhost:6379/0

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

WMS_BASE_URL=http://localhost:8001
WMS_API_KEY=your-api-key-here
