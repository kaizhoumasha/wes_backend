#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
PROFILE="${WES_GIT_QUALITY_PROFILE:-quality}"

# Phase 2 launch PR 起:强制 ARCHITECTURE_PHASE=phase1,确保 pre-commit
# 触发 R-I3a/b/c + C1/C2/C4 + wlr guardrail,不留 phase0 fallback 缺口。
# 允许通过 WES_ARCHITECTURE_PHASE_OVERRIDE 环境变量临时回退 (测试/调试场景)。
export ARCHITECTURE_PHASE="${WES_ARCHITECTURE_PHASE_OVERRIDE:-phase1}"

echo "[pre-commit] Running quality gate profile: $PROFILE (ARCHITECTURE_PHASE=$ARCHITECTURE_PHASE)"

cd "$REPO_ROOT"
exec ./scripts/git-quality-gate.sh --profile "$PROFILE"
