#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
PROFILE="${WES_GIT_QUALITY_PROFILE:-quality}"

# 默认以 enforced 模式触发 stable architecture guardrails。
# 允许通过 WES_ARCHITECTURE_GUARDRAIL_MODE_OVERRIDE 环境变量临时回退 (测试/调试场景)。
export ARCHITECTURE_GUARDRAIL_MODE="${WES_ARCHITECTURE_GUARDRAIL_MODE_OVERRIDE:-enforced}"

echo "[pre-commit] Running quality gate profile: $PROFILE (ARCHITECTURE_GUARDRAIL_MODE=$ARCHITECTURE_GUARDRAIL_MODE)"

cd "$REPO_ROOT"
exec ./scripts/git-quality-gate.sh --profile "$PROFILE"
