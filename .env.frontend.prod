# ============================================
# 前端环境配置 - 生产环境
# ============================================
# 说明:
# - 当前 docker-compose.frontend.yml 主要用于开发/测试前端 dev server。
# - 该文件用于保留前端生产变量的独立入口，后续若接入前端生产容器可直接复用。

FRONTEND_PORT=4173
FRONTEND_APP_TITLE=P9 WES

VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://api:8001
VITE_SSE_URL=/api/v1/events/stream
VITE_APP_TITLE=P9 WES
VITE_APP_DEV=false

NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
COREPACK_ENABLE_AUTO_PIN=0
CHOKIDAR_USEPOLLING=false
CHOKIDAR_INTERVAL=300
HUSKY=0
