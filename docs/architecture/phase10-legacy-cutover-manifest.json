    {"id": "workline.effect_reconciliation_resolve", "source": "src/app/workline/v1/operation.py", "identity": "resolve_effect_reconciliation", "route": "/reconciliations/effects/{dispatch_key}/resolve"},
    {"id": "runtime.system_capability_intent_create", "source": "src/app/runtime/orchestration/services/intent/system_capability_intent_service.py", "identity": "SystemCapabilityIntentService.prepare_and_claim"},
