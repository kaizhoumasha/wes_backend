    {"id": "core.enqueue_runtime_inbox", "source": "src/core/task_queue_gateway.py", "identity": "CeleryTaskQueueGateway.enqueue_runtime_inbox", "task5_relation": "remove_legacy_method"},
    {"id": "core.enqueue_legacy_outbox", "source": "src/core/task_queue_gateway.py", "identity": "CeleryTaskQueueGateway.enqueue_outbox", "task5_relation": "adapt_remove_legacy_targets"},
    {"id": "core.enqueue_internal_signal", "source": "src/core/task_queue_gateway.py", "identity": "CeleryTaskQueueGateway.enqueue_internal_signal", "task5_relation": "remove_legacy_method"},
    {"id": "core.enqueue_wms_effect_status", "source": "src/core/task_queue_gateway.py", "identity": "CeleryTaskQueueGateway.enqueue_wms_effect_status", "task5_relation": "remove_legacy_method"},
    {"id": "core.direct_celery_send_task", "source": "src/core/task_queue_gateway.py", "identity": "CeleryTaskQueueGateway._send_task", "task5_relation": "adapt_target_only"}
  ],
  "excluded_target_producers": [
    "CeleryTaskQueueGateway.enqueue_transport_evidence",
    "CeleryTaskQueueGateway.enqueue_execution_facts",
    "CeleryTaskQueueGateway.enqueue_wms_confirmations",
    "CeleryTaskQueueGateway.enqueue_device_commands",
    "CeleryTaskQueueGateway.enqueue_safety_drain"
  ],
  "paired_outbox_contract": {
