      "wms.inventory.release_reservation@v1",
      "wms.inventory.confirm_inbound@v1",
      "wms.inventory.confirm_outbound@v1",
      "wms.inventory.transfer_inventory@v1",
      "wms.inventory.confirm_return_putaway@v1",
      "wms.fulfillment.notify_pkg_binding@v1",
      "wms.fulfillment.request_rack_supply@v1",
      "wms.fulfillment.change_rack_face@v1",
      "wms.fulfillment.publish_manual_task@v1",
      "wms.fulfillment.cancel_request@v1"
    ]
  },
  "broker": {
    "legacy_task_names": [
      "src.celery_app.tasks.runtime_inbox.process_runtime_inbox_batch",
      "src.celery_app.tasks.runtime_inbox.process_signal",
      "src.celery_app.tasks.sys.dispatch_system_outbox_batch",
      "src.celery_app.tasks.sys.dispatch_wms_data_outbox_batch",
      "src.celery_app.tasks.sys.dispatch_wms_fulfillment_outbox_batch",
      "src.celery_app.tasks.sys.process_signal",
      "src.celery_app.tasks.workline.check_wms_effect_status",
      "src.celery_app.tasks.workline.scan_wms_effect_status_batch",
      "src.celery_app.tasks.workline.process_signal"
    ],
    "legacy_beat_schedule": {
      "process-runtime-inbox-batch": "src.celery_app.tasks.runtime_inbox.process_runtime_inbox_batch",
      "dispatch-outbox-batch": "src.celery_app.tasks.sys.dispatch_system_outbox_batch",
      "dispatch-wms-data-outbox-batch": "src.celery_app.tasks.sys.dispatch_wms_data_outbox_batch",
      "dispatch-wms-fulfillment-outbox-batch": "src.celery_app.tasks.sys.dispatch_wms_fulfillment_outbox_batch",
      "scan-wms-effect-status-batch": "src.celery_app.tasks.workline.scan_wms_effect_status_batch"
    },
    "inspect_states": ["active", "reserved", "scheduled"],
    "required_worker_nodes": [
      "celery@wes_backend_test-celery-1",
      "celery@wes_backend_test-celery-wms-fulfillment-1"
    ],
    "shared_queues": ["celery", "device-command", "wms-fulfillment"],
    "purge_shared_queues": false,
    "direct_redis_task_producers": [],
    "excluded_generic_redis_publishers": [
      "src/utils/event_publisher.py:RedisEventPublisher.publish",
      "src/app/sys/services/event_stream_service.py:EventStreamService.publish"
    ]
  },
  "observations": {
    "producer_freeze_timestamp_required": true,
    "legacy_stable_zero_observations": 2,
    "candidate_ready_observations": 2,
    "interval_seconds": 30,
    "during_interval_require_no_new_legacy_rows": true
  },
  "manual_disposition": {
    "output": "original identity investigation items only",
    "automatic_actions": []
  },
  "cutover": {
    "old_services": {
      "entrypoint": "nginx",
      "api": "api",
      "beat": "celery_beat",
      "workers": ["celery", "celery-wms-fulfillment", "flower"]
    },
    "candidate_readiness_command": "scripts/check_release_operational_readiness.py",
    "candidate_readiness_service": "candidate_backend_python",
    "legacy_readiness_command": "scripts/check_legacy_drain_readiness.py",
    "immutable_digest_inputs": [
      "DEPLOY_SOURCE_COMMIT_SHA",
      "BACKEND_CANDIDATE_DIGEST",
      "FRONTEND_CANDIDATE_DIGEST",
      "CHECKER_DIGEST_VALUE",
      "effective-facts.json"
    ],
    "maintenance_steps": [
      {"id": "stop_entrypoint", "target": "nginx", "verify": "old public listener absent", "on_failure": "CUTOVER_FAILED_MAINTENANCE_HELD"},
      {"id": "stop_api", "target": "api", "verify": "old API process absent", "on_failure": "CUTOVER_FAILED_MAINTENANCE_HELD"},
      {"id": "stop_beat", "target": "celery_beat", "verify": "old scheduler process absent", "on_failure": "CUTOVER_FAILED_MAINTENANCE_HELD"},
      {"id": "observe_legacy_drain", "target": "scripts/check_legacy_drain_readiness.py", "verify": "two consecutive READY observations", "on_failure": "CUTOVER_FAILED_MAINTENANCE_HELD"},
      {"id": "observe_candidate_readiness", "target": "scripts/check_release_operational_readiness.py", "verify": "two consecutive READY observations", "on_failure": "CUTOVER_FAILED_MAINTENANCE_HELD"},
      {"id": "stop_old_workers", "target": "celery,celery-wms-fulfillment,flower", "verify": "old worker processes absent after drain", "on_failure": "CUTOVER_FAILED_MAINTENANCE_HELD"},
      {"id": "switch_immutable_candidate", "target": "candidate deployment", "verify": "all immutable digest inputs equal approved values", "on_failure": "CUTOVER_FAILED_MAINTENANCE_HELD"}
    ]
  }
}
