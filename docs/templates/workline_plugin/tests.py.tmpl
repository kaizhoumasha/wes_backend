MANIFEST_TOP_LEVEL_FIELDS = (
    "plugin_key",
    "contract_version",
    "devices",
    "positions",
    "topology",
    "commands",
    "events",
    "resource_boundaries",
)
REMOVED_MANIFEST_RUNTIME_FIELDS = (
    "business_key_resolver",
    "result_classifier",
    "context_model",
    "material_identity_resolver",
    "ng_reason_catalog",
)


def make_ctx(context_json=None):
    return SimpleNamespace(
        session=SimpleNamespace(id=1, context_json=context_json or {}),
        run_mode="SIMULATION",
        next=PluginNext(),
    )


def test_manifest_contract() -> None:
    manifest = {{PLUGIN_CLASS}}.manifest

    assert tuple(field.name for field in fields(manifest)) == MANIFEST_TOP_LEVEL_FIELDS
    assert manifest.plugin_key == "{{PLUGIN_KEY}}"
    assert manifest.contract_version == "{{CONTRACT_VERSION}}"
    assert manifest.devices[0].role == "ENTRY_SENSOR"
    assert manifest.positions[0].code == "ENTRY_POSITION"
    assert isinstance(manifest.events[0], EventBinding)
    assert manifest.events[0].event == "ITEM_ARRIVED"
    assert manifest.events[0].source_device_roles == ("ENTRY_SENSOR",)
    assert isinstance(manifest.commands[0], CommandBinding)
    assert manifest.commands[0].command == "MEASURE_ITEM"
    assert manifest.commands[0].target_device_role == "MEASURE_DEVICE"
    assert manifest.commands[0].position_args[0].position_ref == "MEASURE_POSITION"
    assert manifest.commands[0].position_args[1].source.kind is PositionArgSourceKind.EVENT_PAYLOAD
    assert isinstance(manifest.resource_boundaries[0], ResourceBoundary)
    assert manifest.resource_boundaries[0].position_code == "MEASURE_POSITION"

    for field_name in REMOVED_MANIFEST_RUNTIME_FIELDS:
        assert not hasattr(manifest, field_name)


def test_plugin_runtime_helpers_live_on_plugin_instance() -> None:
    plugin = {{PLUGIN_CLASS}}()
    event_payload = {
        "device_code": "ENTRY01",
        "event_type": "ITEM_ARRIVED",
        "timestamp": 1777046400000,
        "data": {
            "business_key": "ITEM-001",
            "item_id": "ITEM-001",
            "station_code": "QC01",
            "expected_value": 10.0,
            "tolerance": 0.5,
        },
    }

    identity = plugin.resolve_material_identity(
        MaterialIdentityInput(source_payload={"data": {"business_key": "ITEM-001", "item_id": "ITEM-001"}})
    )

    assert plugin.resolve_business_key(event_payload) == "ITEM-001"
    assert callable(plugin.resolve_business_key)
    assert plugin.classify_result({"result": "FAILED", "data": {}}) == "hardware_failure"
    assert callable(plugin.classify_result)
    assert plugin.get_context_model() is {{CONTEXT_CLASS}}
    assert callable(plugin.get_context_model)
    assert identity.resolution_status == MaterialIdentityResolutionStatus.RESOLVED
    assert identity.idempotency_key == "{{PLUGIN_KEY}}:ITEM-001"
    assert [reason.canonical_code for reason in plugin.list_ng_reasons()] == ["VALUE_OUT_OF_TOLERANCE"]
    assert callable(plugin.resolve_material_identity)
    assert callable(plugin.list_ng_reasons)


