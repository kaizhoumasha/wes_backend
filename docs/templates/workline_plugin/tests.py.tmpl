def test_command_params_helpers() -> None:
    assert build_measure_params(business_key="ITEM-001", item_id="ITEM-001", station_code="QC01") == {
        "business_key": "ITEM-001",
        "item_id": "ITEM-001",
        "station_code": "QC01",
    }
    assert build_divert_params(
        business_key="ITEM-001",
        item_id="ITEM-001",
        destination_lane="PASS_LANE",
        reason_code="VALUE_OK",
    )["destination_lane"] == "PASS_LANE"


@pytest.mark.asyncio()
async def test_happy_path_event_creates_measure_command() -> None:
    plugin = {{PLUGIN_CLASS}}()
    ctx = make_ctx()
    event = ItemArrivedPayload.model_validate(
        {
            "device_code": "ENTRY01",
            "event_type": "ITEM_ARRIVED",
            "timestamp": 1777046400000,
            "data": {
                "business_key": "ITEM-001",
                "item_id": "ITEM-001",
                "station_code": "QC01",
                "expected_value": 10.0,
                "tolerance": 0.5,
            },
        }
    )

    intents = await plugin.handle_item_arrived(ctx, event)

    assert [intent.kind for intent in intents] == [
        RuntimeIntentKind.UPDATE_CONTEXT,
        RuntimeIntentKind.COMMAND,
    ]
    assert intents[0].context_patch["business_key"] == "ITEM-001"
    assert intents[0].context_patch["item_id"] == "ITEM-001"
    assert intents[1].action == "MEASURE_ITEM"
    assert intents[1].device_role == "MEASURE_DEVICE"
    assert intents[1].payload_json["business_key"] == "ITEM-001"
    assert intents[1].payload_json["item_id"] == "ITEM-001"
    assert intents[1].timeout_seconds == 120


@pytest.mark.asyncio()
async def test_measure_success_completes_session() -> None:
    plugin = {{PLUGIN_CLASS}}()
    ctx = make_ctx({"expected_value": 10.0, "tolerance": 0.5})
    command_result = NormalizedCommandResult(
        command_code="CMD-001",
        source_result="SUCCESS",
        normalized_result="SUCCESS",
        command_type="MEASURE_ITEM",
        device_code="MEASURE01",
        data={"business_key": "ITEM-001", "item_id": "ITEM-001", "actual_value": 10.1},
    )

    intent = await plugin.handle_measure_success(ctx, command_result)

    assert intent.kind == RuntimeIntentKind.COMPLETE


@pytest.mark.asyncio()
async def test_measure_failure_blocks_session() -> None:
    plugin = {{PLUGIN_CLASS}}()
    ctx = make_ctx({"expected_value": 10.0, "tolerance": 0.5})
    command_result = NormalizedCommandResult(
        command_code="CMD-001",
        source_result="FAILED",
        normalized_result="TERMINAL_FAILURE",
        command_type="MEASURE_ITEM",
        device_code="MEASURE01",
        data={"error_message": "measure device alarm"},
    )

    intent = await plugin.handle_measure_failed(ctx, command_result)

    assert intent.kind == RuntimeIntentKind.BLOCK
    assert intent.reason_code == "MEASURE_ITEM_FAILED"
    assert intent.message == "measure device alarm"


