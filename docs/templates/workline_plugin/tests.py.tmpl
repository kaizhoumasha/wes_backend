"""{{PLUGIN_NAME}} 插件测试模板。"""

from __future__ import annotations

from types import SimpleNamespace

import pytest

from src.workline_runtime.plugin_sdk.contracts import NormalizedCommandResult
from src.workline_runtime.plugin_next import PluginNext
from src.workline_runtime.runtime_intent import RuntimeIntentKind
from src.workline_plugins.{{PLUGIN_MODULE}}.context import {{CONTEXT_CLASS}}
from src.workline_plugins.{{PLUGIN_MODULE}}.contract import (
    ItemArrivedPayload,
    build_divert_params,
    build_measure_params,
    resolve_business_key,
)
from src.workline_plugins.{{PLUGIN_MODULE}}.plugin import {{PLUGIN_CLASS}}


def make_ctx(context_json=None):
    return SimpleNamespace(
        session=SimpleNamespace(id=1, context_json=context_json or {}),
        run_mode="SIMULATION",
        next=PluginNext(),
    )


def test_manifest_contract() -> None:
    manifest = {{PLUGIN_CLASS}}.manifest
    assert manifest.plugin_key == "{{PLUGIN_KEY}}"
    assert manifest.context_model is {{CONTEXT_CLASS}}
    assert manifest.event_source_roles["ITEM_ARRIVED"] == ("ENTRY_SENSOR",)
    assert manifest.command_target_roles["MEASURE_ITEM"] == ("MEASURE_DEVICE",)


def test_event_payload_uses_data_boundary() -> None:
    payload = {
        "device_code": "ENTRY01",
        "event_type": "ITEM_ARRIVED",
        "timestamp": 1777046400000,
        "data": {
            "business_key": "ITEM-001",
            "station_code": "QC01",
            "expected_value": 10.0,
            "tolerance": 0.5,
        },
    }
    assert resolve_business_key(payload) == "ITEM-001"
    assert ItemArrivedPayload.model_validate(payload).data.business_key == "ITEM-001"


def test_command_params_helpers() -> None:
    assert build_measure_params(business_key="ITEM-001", station_code="QC01") == {
        "business_key": "ITEM-001",
        "station_code": "QC01",
    }
    assert build_divert_params(
        business_key="ITEM-001",
        destination_lane="PASS_LANE",
        reason_code="VALUE_OK",
    )["destination_lane"] == "PASS_LANE"


@pytest.mark.asyncio
async def test_happy_path_event_creates_measure_command() -> None:
    plugin = {{PLUGIN_CLASS}}()
    ctx = make_ctx()
    event = ItemArrivedPayload.model_validate(
        {
            "device_code": "ENTRY01",
            "event_type": "ITEM_ARRIVED",
            "timestamp": 1777046400000,
            "data": {
                "business_key": "ITEM-001",
                "station_code": "QC01",
                "expected_value": 10.0,
                "tolerance": 0.5,
            },
        }
    )

    intents = await plugin.handle_item_arrived(ctx, event)

    assert [intent.kind for intent in intents] == [
        RuntimeIntentKind.UPDATE_CONTEXT,
        RuntimeIntentKind.COMMAND,
    ]
    assert intents[0].context_patch["business_key"] == "ITEM-001"
    assert intents[1].action == "MEASURE_ITEM"
    assert intents[1].device_role == "MEASURE_DEVICE"
    assert intents[1].payload_json["business_key"] == "ITEM-001"
    assert intents[1].timeout_seconds == 120


@pytest.mark.asyncio
async def test_business_ng_is_decision_not_failure() -> None:
    plugin = {{PLUGIN_CLASS}}()
    ctx = make_ctx({"expected_value": 10.0, "tolerance": 0.5})
    command_result = NormalizedCommandResult(
        command_type="MEASURE_ITEM",
        command_code="CMD-001",
        device_code="MEASURE01",
        result="SUCCESS",
        data={"business_key": "ITEM-001", "actual_value": 11.0},
    )

    intents = await plugin.handle_measure_success(ctx, command_result)

    assert [intent.kind for intent in intents] == [
        RuntimeIntentKind.UPDATE_CONTEXT,
        RuntimeIntentKind.MARK_NG,
        RuntimeIntentKind.COMMAND,
    ]
    assert intents[1].reason_code == "VALUE_OUT_OF_TOLERANCE"
    assert intents[2].action == "DIVERT_ITEM"
