"""{{PLUGIN_NAME}} 状态机。"""

from __future__ import annotations

from enum import StrEnum

from transitions import Machine


class {{STATE_ENUM}}(StrEnum):
    IDLE = "IDLE"
    WAITING_MEASURE = "WAITING_MEASURE"
    WAITING_DIVERT = "WAITING_DIVERT"
    MANUAL_HOLD = "MANUAL_HOLD"
    COMPLETED = "COMPLETED"
    ERROR = "ERROR"


class {{STATE_MACHINE_CLASS}}:
    states = [state.value for state in {{STATE_ENUM}}]
    transitions = [
        {"trigger": "item_arrived", "source": {{STATE_ENUM}}.IDLE.value, "dest": {{STATE_ENUM}}.WAITING_MEASURE.value},
        {
            "trigger": "measure_ok",
            "source": {{STATE_ENUM}}.WAITING_MEASURE.value,
            "dest": {{STATE_ENUM}}.WAITING_DIVERT.value,
        },
        {
            "trigger": "measure_ng",
            "source": {{STATE_ENUM}}.WAITING_MEASURE.value,
            "dest": {{STATE_ENUM}}.WAITING_DIVERT.value,
        },
        {
            "trigger": "divert_ok",
            "source": {{STATE_ENUM}}.WAITING_DIVERT.value,
            "dest": {{STATE_ENUM}}.COMPLETED.value,
        },
        {
            "trigger": "manual_hold",
            "source": {{STATE_ENUM}}.WAITING_DIVERT.value,
            "dest": {{STATE_ENUM}}.MANUAL_HOLD.value,
        },
        {
            "trigger": "fail",
            "source": [
                {{STATE_ENUM}}.IDLE.value,
                {{STATE_ENUM}}.WAITING_MEASURE.value,
                {{STATE_ENUM}}.WAITING_DIVERT.value,
                {{STATE_ENUM}}.MANUAL_HOLD.value,
            ],
            "dest": {{STATE_ENUM}}.ERROR.value,
        },
    ]

    def __init__(self, initial: str = {{STATE_ENUM}}.IDLE.value):
        self.state = initial
        self.machine = Machine(
            model=self,
            states=self.states,
            transitions=self.transitions,
            initial=initial,
            auto_transitions=False,
            ignore_invalid_triggers=False,
        )

    def may_trigger(self, trigger: str) -> bool:
        return bool(getattr(self, f"may_{trigger}", lambda: False)())
