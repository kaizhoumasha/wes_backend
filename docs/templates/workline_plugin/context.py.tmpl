"""{{PLUGIN_NAME}} 插件类型化上下文。"""

from __future__ import annotations

from typing import Any

from pydantic import BaseModel, ConfigDict

from src.workline_runtime.plugin_context import PluginContext


class {{CONTEXT_CLASS}}(BaseModel):
    """Session context_json 的插件业务数据视图。"""

    model_config = ConfigDict(extra="ignore")

    business_key: str | None = None
    station_code: str | None = None
    expected_value: float | None = None
    actual_value: float | None = None
    tolerance: float | None = None
    destination_lane: str | None = None
    reason_code: str | None = None

    @classmethod
    def from_mapping(cls, value: dict[str, Any] | None) -> "{{CONTEXT_CLASS}}":
        return cls.model_validate(value or {})

    @classmethod
    def from_session(cls, ctx: PluginContext) -> "{{CONTEXT_CLASS}}":
        return cls.from_mapping(ctx.session.context_json)

    def to_patch(self) -> dict[str, Any]:
        return self.model_dump(exclude_none=True)


def parse_context(ctx: PluginContext) -> {{CONTEXT_CLASS}}:
    return {{CONTEXT_CLASS}}.from_session(ctx)
