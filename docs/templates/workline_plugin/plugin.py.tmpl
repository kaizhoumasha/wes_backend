"""{{PLUGIN_NAME}} 插件入口。"""

from __future__ import annotations

from src.workline_runtime.plugin_base import (
    WorklinePlugin,
    build_payload_invalid_block,
    on_command,
    on_event,
    resolve_normalized_command_envelope,
    resolve_normalized_command_failure,
)
from src.workline_runtime.plugin_manifest import DeviceRoleRequirement, WorklinePluginManifest
from src.workline_runtime.plugin_sdk.contracts import NormalizedCommandResult
from src.workline_runtime.runtime_intent import BlockScope

from .context import {{CONTEXT_CLASS}}, parse_context
from .contract import (
    ItemArrivedPayload,
    MeasureCompletedData,
    build_divert_params,
    build_measure_params,
    classify_result,
    resolve_business_key,
)


class {{PLUGIN_CLASS}}(WorklinePlugin):
    plugin_key = "{{PLUGIN_KEY}}"
    contract_version = "{{CONTRACT_VERSION}}"
    manifest = WorklinePluginManifest(
        plugin_key=plugin_key,
        contract_version=contract_version,
        required_device_roles=(
            DeviceRoleRequirement("ENTRY_SENSOR", min_count=1, max_count=1, capabilities=frozenset({"scan_item"})),
            DeviceRoleRequirement("MEASURE_DEVICE", min_count=1, max_count=1, capabilities=frozenset({"measure_item"})),
            DeviceRoleRequirement("DIVERT_DEVICE", min_count=1, max_count=1, capabilities=frozenset({"divert_item"})),
        ),
        business_key_resolver=resolve_business_key,
        result_classifier=classify_result,
        context_model={{CONTEXT_CLASS}},
        event_source_roles={"ITEM_ARRIVED": "ENTRY_SENSOR"},
        command_target_roles={"MEASURE_ITEM": "MEASURE_DEVICE", "DIVERT_ITEM": "DIVERT_DEVICE"},
        supported_events=frozenset({"ITEM_ARRIVED"}),
        supported_commands=frozenset({"MEASURE_ITEM", "DIVERT_ITEM"}),
    )

    @on_event("ITEM_ARRIVED")
    async def handle_item_arrived(self, ctx, event: ItemArrivedPayload):
        return [
            ctx.next.update_context(
                {{CONTEXT_CLASS}}(
                    business_key=event.data.business_key,
                    station_code=event.data.station_code,
                    expected_value=event.data.expected_value,
                    tolerance=event.data.tolerance,
                ).to_patch()
            ),
            ctx.next.command(
                device_role="MEASURE_DEVICE",
                action="MEASURE_ITEM",
                payload=build_measure_params(
                    business_key=event.data.business_key,
                    station_code=event.data.station_code,
                ),
                destination_role="MEASURE_DEVICE",
                timeout_seconds=120,
            ),
        ]

    @on_command("MEASURE_ITEM", result="SUCCESS")
    async def handle_measure_success(self, ctx, result: NormalizedCommandResult):
        if resolve_normalized_command_envelope(result) is None:
            return build_payload_invalid_block("MEASURE_ITEM 成功回调缺少 command_code 或 device_code")
        try:
            measure_data = MeasureCompletedData.model_validate(result.data)
        except Exception:
            return build_payload_invalid_block("MEASURE_ITEM 成功回调 data 非法")

        business_ctx = parse_context(ctx)
        if business_ctx.expected_value is None or business_ctx.tolerance is None:
            return build_payload_invalid_block("缺少业务上下文")

        is_ng = abs(measure_data.actual_value - business_ctx.expected_value) > business_ctx.tolerance
        destination_lane = "HOLD_LANE" if is_ng else "PASS_LANE"
        reason_code = "VALUE_OUT_OF_TOLERANCE" if is_ng else "VALUE_OK"
        intents = [
            ctx.next.update_context(
                {{CONTEXT_CLASS}}(
                    business_key=measure_data.business_key,
                    actual_value=measure_data.actual_value,
                    destination_lane=destination_lane,
                    reason_code=reason_code,
                ).to_patch()
            )
        ]
        if is_ng:
            intents.append(
                ctx.next.mark_ng(
                    reason_code=reason_code,
                    message="业务检测超出允差，分流到异常线",
                    payload={
                        "business_key": measure_data.business_key,
                        "expected_value": business_ctx.expected_value,
                        "actual_value": measure_data.actual_value,
                        "tolerance": business_ctx.tolerance,
                    },
                )
            )
        intents.append(
            ctx.next.command(
                device_role="DIVERT_DEVICE",
                action="DIVERT_ITEM",
                payload=build_divert_params(
                    business_key=measure_data.business_key,
                    destination_lane=destination_lane,
                    reason_code=reason_code,
                ),
                destination_role="DIVERT_DEVICE",
                timeout_seconds=120,
            )
        )
        return intents

    @on_command("MEASURE_ITEM", result="FAILED")
    async def handle_measure_failed(self, ctx, result: NormalizedCommandResult):
        error_code, error_message = resolve_normalized_command_failure(
            result,
            default_code="MEASURE_DEVICE_FAILED",
            default_message="测量设备执行失败",
        )
        return ctx.next.block(
            scope=BlockScope.COMMAND,
            reason_code=error_code,
            message=error_message,
            suggested_action="检查测量设备后重试",
        )

    @on_command("DIVERT_ITEM", result="SUCCESS")
    async def handle_divert_success(self, ctx, result: NormalizedCommandResult):
        if resolve_normalized_command_envelope(result) is None:
            return build_payload_invalid_block("DIVERT_ITEM 成功回调缺少 command_code 或 device_code")
        return ctx.next.complete()

    @on_command("DIVERT_ITEM", result="FAILED")
    async def handle_divert_failed(self, ctx, result: NormalizedCommandResult):
        error_code, error_message = resolve_normalized_command_failure(
            result,
            default_code="DIVERT_DEVICE_FAILED",
            default_message="分流设备执行失败",
        )
        return [
            ctx.next.update_context({{CONTEXT_CLASS}}(reason_code=error_code).to_patch()),
            ctx.next.block(
                scope=BlockScope.MATERIAL,
                reason_code=error_code,
                message=error_message,
                suggested_action="转人工处理分流异常",
            ),
        ]


{{PLUGIN_INSTANCE}} = {{PLUGIN_CLASS}}()
