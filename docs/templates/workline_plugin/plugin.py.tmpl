"""{{PLUGIN_NAME}} 插件入口。"""

from __future__ import annotations

from typing import Any

from src.workline_runtime.material_identity import MaterialIdentity, MaterialIdentityInput
from src.workline_runtime.ng_reason import NgReasonDefinition
from src.workline_runtime.plugin_base import WorklinePlugin, on_command, on_event
from src.workline_runtime.plugin_manifest import (
    CommandBinding,
    CommandResultBinding,
    DeviceRequirement,
    EventBinding,
    EventCategory,
    FlowEdge,
    FlowEdgeType,
    NodeRef,
    NodeRefKind,
    Position,
    PositionArg,
    PositionArgRole,
    PositionArgSource,
    PositionArgSourceKind,
    PositionCarrierCapability,
    ResourceBoundary,
    TopologySpec,
    WorklinePluginManifest,
)
from src.workline_runtime.plugin_sdk.contracts import NormalizedCommandResult
from src.workline_runtime.runtime_intent import BlockScope

from .context import {{CONTEXT_CLASS}}
from .contract import (
    PLUGIN_NG_REASONS,
    ItemArrivedPayload,
    build_measure_params,
    classify_result,
    resolve_business_key,
    resolve_material_identity,
)

POSITION_ENTRY = "ENTRY_POSITION"
POSITION_MEASURE = "MEASURE_POSITION"


class {{PLUGIN_CLASS}}(WorklinePlugin):
    """示例插件。

    manifest 只保留可序列化静态事实；registry helper 通过插件实例方法读取运行时行为。
    positions 只声明 WES-managed rack docking positions / inventory-fact anchors，不枚举所有物理点位。
    MATERIAL_FLOW 只表达 rack position 到 rack position；设备动作边使用 `FlowEdgeType.OPERATION`。
    PositionArg 静态位置使用 `position_ref`，`position_ref` 与 `source` 互斥；
    `PositionArgSource` 不支持 `STATIC`。
    """

    plugin_key = "{{PLUGIN_KEY}}"
    contract_version = "{{CONTRACT_VERSION}}"

    manifest = WorklinePluginManifest(
        plugin_key=plugin_key,
        contract_version=contract_version,
        devices=(
            DeviceRequirement(role="ENTRY_SENSOR", min_count=1, max_count=1, hardware_capabilities=("scan_item",)),
            DeviceRequirement(
                role="MEASURE_DEVICE",
                min_count=1,
                max_count=1,
                hardware_capabilities=("measure_item",),
            ),
        ),
        # WES-managed rack docking positions / inventory-fact anchors，不枚举设备内部所有物理点位。
        positions=(
            Position(
                code=POSITION_ENTRY,
                role="ENTRY",
                station_code="ENTRY_STATION",
                carrier_capability=PositionCarrierCapability(allowed_rack_kinds=("SINGLE_LAYER",)),
            ),
            Position(
                code=POSITION_MEASURE,
                role="WORK",
                station_code="MEASURE_STATION",
                carrier_capability=PositionCarrierCapability(allowed_rack_kinds=("SINGLE_LAYER",)),
            ),
        ),
        topology=TopologySpec(
            flow_edges=(
                FlowEdge(
                    from_node=NodeRef(NodeRefKind.DEVICE_ROLE, "ENTRY_SENSOR"),
                    to_node=NodeRef(NodeRefKind.POSITION, POSITION_ENTRY),
                    type=FlowEdgeType.OPERATION,
                ),
                FlowEdge(
                    from_node=NodeRef(NodeRefKind.POSITION, POSITION_ENTRY),
                    to_node=NodeRef(NodeRefKind.POSITION, POSITION_MEASURE),
                    type=FlowEdgeType.MATERIAL_FLOW,
                ),
            )
        ),
        events=(
            EventBinding(
                event="ITEM_ARRIVED",
                source_device_roles=("ENTRY_SENSOR",),
                category=EventCategory.ENTRY_DEVICE,
                payload_schema_ref="ItemArrivedPayload",
            ),
        ),
        commands=(
            CommandBinding(
                command="MEASURE_ITEM",
                target_device_role="MEASURE_DEVICE",
                position_args=(
                    PositionArg(name="work_position", role=PositionArgRole.TARGET, position_ref=POSITION_MEASURE),
                    PositionArg(
                        name="source_position",
                        role=PositionArgRole.SOURCE,
                        required=False,
                        source=PositionArgSource(
                            kind=PositionArgSourceKind.EVENT_PAYLOAD,
                            path="data.position_code",
                            fallback_position_ref=POSITION_ENTRY,
                        ),
                    ),
                ),
                payload_schema_ref="MeasureParams",
                result_bindings=(
                    CommandResultBinding(
                        result="SUCCESS",
                        event="MEASURE_ITEM_RESULT",
                        category=EventCategory.COMMAND_RESULT,
                        classification="success",
                    ),
                    CommandResultBinding(
                        result="FAILED",
                        event="MEASURE_ITEM_RESULT",
                        category=EventCategory.COMMAND_RESULT,
                        classification="hardware_failure",
                        terminal=True,
                    ),
                ),
            ),
        ),
        resource_boundaries=(
            ResourceBoundary(
                position_code=POSITION_MEASURE,
                rack_kind="SINGLE_LAYER",
                business_demand_type="MEASURE_WORK_RACK",
                wms_operation_type="SUPPLY_MEASURE_RACK",
                snapshot_kind="ACTIVE_MEASURE_RACK",
                lease_scope="STATION",
            ),
        ),
    )

    def resolve_business_key(self, payload_json: dict[str, Any]) -> str | None:
        return resolve_business_key(payload_json)

    def classify_result(self, payload_json: dict[str, Any]) -> str | None:
        return classify_result(payload_json)

    def get_context_model(self) -> type[{{CONTEXT_CLASS}}]:
        return {{CONTEXT_CLASS}}

    def resolve_material_identity(self, input_value: MaterialIdentityInput) -> MaterialIdentity:
        return resolve_material_identity(input_value)

    def list_ng_reasons(self) -> tuple[NgReasonDefinition, ...]:
        return PLUGIN_NG_REASONS

    @on_event("ITEM_ARRIVED")
    async def handle_item_arrived(self, ctx, event: ItemArrivedPayload):
        return [
            ctx.next.update_context(
                {{CONTEXT_CLASS}}(
                    business_key=event.data.business_key,
                    item_id=event.data.item_id,
                    station_code=event.data.station_code,
                    expected_value=event.data.expected_value,
                    tolerance=event.data.tolerance,
                ).to_patch()
            ),
            ctx.next.command(
                device_role="MEASURE_DEVICE",
                action="MEASURE_ITEM",
                payload=build_measure_params(
                    business_key=event.data.business_key,
                    item_id=event.data.item_id,
                    station_code=event.data.station_code,
                ),
                destination_role="MEASURE_DEVICE",
                timeout_seconds=120,
            ),
        ]

    @on_command("MEASURE_ITEM", result="SUCCESS")
    async def handle_measure_success(self, ctx, result: NormalizedCommandResult):
        return ctx.next.complete({"command_code": result.command_code})

    @on_command("MEASURE_ITEM", result="FAILED")
    async def handle_measure_failed(self, ctx, result: NormalizedCommandResult):
        return ctx.next.block(
            scope=BlockScope.MATERIAL,
            reason_code="MEASURE_ITEM_FAILED",
            message=result.data.get("error_message") or result.error_detail.get("message") or "测量设备失败，需人工确认",
            suggested_action="检查测量设备状态和当前物料后人工处理",
            payload={
                "command_code": result.command_code,
                "device_code": result.device_code,
                "error_detail": result.error_detail or result.data,
            },
        )


{{PLUGIN_INSTANCE}} = {{PLUGIN_CLASS}}()
