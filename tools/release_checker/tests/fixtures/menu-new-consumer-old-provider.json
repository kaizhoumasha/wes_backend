{
  "openapi": "3.0.3",
  "info": {
    "title": "Old provider for new menu consumer",
    "version": "1.0.0"
  },
  "paths": {
    "/auth/my.menus": {
      "get": {
        "operationId": "getMyMenus",
        "responses": {
          "200": {
            "description": "Menus",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MenuEnvelope": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SystemStatus": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "legacyLabel": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    }
  }
}
