{
  "openapi": "3.0.3",
  "info": {
    "title": "Provider with unused changes",
    "version": "1.0.0"
  },
  "paths": {
    "/orders/{order_id}": {
      "get": {
        "operationId": "getOrder",
        "parameters": [
          {
            "in": "path",
            "name": "order_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderEnvelope"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "replaceOrder",
        "parameters": [
          {
            "in": "path",
            "name": "order_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Order"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ack"
                }
              }
            }
          }
        }
      }
    },
    "/unused": {
      "get": {
        "operationId": "getUnused",
        "responses": {
          "200": {
            "description": "Unused payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnusedEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/unused-new": {
      "get": {
        "operationId": "getUnusedNew",
        "responses": {
          "204": {
            "description": "No content"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Ack": {
        "type": "object",
        "required": [
          "accepted"
        ],
        "properties": {
          "accepted": {
            "type": "boolean"
          }
        }
      },
      "Order": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "OrderEnvelope": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Order"
          }
        }
      },
      "UnusedEnvelope": {
        "type": "object",
        "required": [
          "payload"
        ],
        "properties": {
          "payload": {
            "$ref": "#/components/schemas/UnusedPayload"
          }
        }
      },
      "UnusedPayload": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "integer"
          }
        }
      }
    }
  }
}
