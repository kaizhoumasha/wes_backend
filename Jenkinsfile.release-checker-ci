pipeline {
    agent {
        label 'WES'
    }

    environment {
        REGISTRY_URL = '192.168.0.220:5050'
        CHECKER_IMAGE_REPO = '192.168.0.220:5050/wes/wes_backend/release_checker'
        DOCKER_BUILDKIT = '1'
    }

    options {
        buildDiscarder(logRotator(daysToKeepStr: '14', numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
        skipDefaultCheckout(true)
        disableConcurrentBuilds(abortPrevious: true)
        timestamps()
    }

    stages {
        stage('Checkout Checker Source') {
            steps {
                script {
                    String sourceBranch = env.gitlabSourceBranch ?: env.gitlabBranch ?: env.BRANCH_NAME ?: 'develop'
                    String targetBranch = env.gitlabTargetBranch ?: ''
                    String gitlabActionType = (env.gitlabActionType ?: env.GITLAB_OBJECT_KIND ?: '').trim().toUpperCase()
                    String beforeCommit = (env.gitlabBefore ?: '').trim()
                    String afterCommit = (env.gitlabAfter ?: '').trim()
                    boolean hasMergeRequestId = ((env.gitlabMergeRequestId ?: '').trim()) as boolean
                    boolean isMergeRequest = gitlabActionType.contains('MERGE') || hasMergeRequestId
                    boolean isProtectedPush = gitlabActionType == 'PUSH' && sourceBranch in ['develop', 'main'] && !isMergeRequest
                    boolean isManualBuild = !isMergeRequest && !gitlabActionType && !beforeCommit && !afterCommit
                    String mergeRequestCommit = (env.gitlabMergeRequestLastCommit ?: '').trim()
                    String trustedSourceCommit = isMergeRequest ? mergeRequestCommit : afterCommit
                    if (isMergeRequest && !targetBranch) {
                        error('Merge request build requires gitlabTargetBranch')
                    }

                    env.CI_SOURCE_BRANCH = sourceBranch
                    env.CI_TARGET_BRANCH = targetBranch
                    env.CI_EVENT_TYPE = isManualBuild ? 'MANUAL' : (gitlabActionType ?: 'UNKNOWN')
                    env.CI_IS_MERGE_REQUEST = isMergeRequest ? 'true' : 'false'
                    env.CI_RELEASE_GATE_READY = 'false'
                    env.CHECKER_INPUT_CHANGED = 'true'

                    withCredentials([usernamePassword(
                        credentialsId: 'gitlab-http-creds',
                        usernameVariable: 'GITLAB_USERNAME',
                        passwordVariable: 'GITLAB_PASSWORD'
                    )]) {
                        deleteDir()
                        sh '''
                            set +x
                            set -eu
                            git init
                            git remote add origin http://192.168.0.220:9080/wes/wes_backend.git
                            fetch_ref() {
                                refspec="$1"
                                for attempt in 1 2 3; do
                                    if timeout --kill-after=10s 180s git -c credential.helper= \
                                        -c 'credential.helper=!f() { printf "%s\\n" \
                                            "username=$GITLAB_USERNAME" "password=$GITLAB_PASSWORD"; }; f' \
                                        fetch --no-tags --force --filter=blob:none origin "$refspec"; then
                                        return 0
                                    fi
                                    [ "$attempt" -ge 3 ] || sleep 10
                                done
                                return 1
                            }
                            fetch_ref "+refs/heads/${CI_SOURCE_BRANCH}:refs/remotes/origin/${CI_SOURCE_BRANCH}"
                            if [ -n "${CI_TARGET_BRANCH:-}" ] && [ "${CI_TARGET_BRANCH:-}" != "${CI_SOURCE_BRANCH}" ]; then
                                fetch_ref "+refs/heads/${CI_TARGET_BRANCH}:refs/remotes/origin/${CI_TARGET_BRANCH}"
                            fi
                            git checkout --detach "refs/remotes/origin/${CI_SOURCE_BRANCH}"
                        '''
                    }

                    String fetchedSourceCommit = sh(
                        returnStdout: true,
                        script: 'git rev-parse "refs/remotes/origin/${CI_SOURCE_BRANCH}^{commit}"'
                    ).trim()
                    if (isManualBuild) {
                        trustedSourceCommit = fetchedSourceCommit
                    }
                    if (!(trustedSourceCommit ==~ /^[0-9a-fA-F]{40}$/) || trustedSourceCommit ==~ /^0{40}$/) {
                        error('Source event requires a non-zero 40-character trusted commit')
                    }
                    if (!trustedSourceCommit.equalsIgnoreCase(fetchedSourceCommit)) {
                        error('Fetched source ref must match the trusted event commit')
                    }

                    String fullCommit = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
                    String diffBase = ''
                    if (isMergeRequest) {
                        diffBase = sh(
                            returnStdout: true,
                            script: 'git rev-parse "refs/remotes/origin/${CI_TARGET_BRANCH}^{commit}"'
                        ).trim()
                    } else if (beforeCommit ==~ /^[0-9a-fA-F]{40}$/ && !(beforeCommit ==~ /^0{40}$/)) {
                        diffBase = beforeCommit.toLowerCase()
                    }
                    if (isProtectedPush) {
                        if (!(beforeCommit ==~ /^[0-9a-fA-F]{40}$/) || beforeCommit ==~ /^0{40}$/) {
                            error('Protected push requires a non-zero 40-character gitlabBefore')
                        }
                        if (!(afterCommit ==~ /^[0-9a-fA-F]{40}$/) || !afterCommit.equalsIgnoreCase(fullCommit)) {
                            error('Protected push gitlabAfter must match the checked out HEAD')
                        }
                        int ancestryStatus = sh(
                            returnStatus: true,
                            script: "git merge-base --is-ancestor '${beforeCommit}' '${fullCommit}'"
                        )
                        if (ancestryStatus != 0) {
                            error('Protected push must fast-forward from gitlabBefore')
                        }
                        env.CI_RELEASE_GATE_READY = 'true'
                    }
                    if (diffBase) {
                        int diffStatus = sh(
                            returnStatus: true,
                            script: "git diff --quiet '${diffBase}' '${fullCommit}' -- tools/release_checker Jenkinsfile.release-checker-ci tests/deployment/test_release_checker_ci.py"
                        )
                        if (!(diffStatus in [0, 1])) {
                            error('Checker input diff failed')
                        }
                        env.CHECKER_INPUT_CHANGED = diffStatus == 1 ? 'true' : 'false'
                    }

                    String checkerSourceCommit = sh(returnStdout: true, script: 'git log -1 --format=%H -- tools/release_checker Jenkinsfile.release-checker-ci tests/deployment/test_release_checker_ci.py').trim()
                    if (!(checkerSourceCommit ==~ /[0-9a-f]{40}/)) {
                        error('无法确定唯一 checker owner commit')
                    }
                    String channelTag = sourceBranch == 'main' ? 'prod' : sourceBranch.replaceAll(/[^A-Za-z0-9_.-]+/, '-')
                    env.CI_COMMIT_SHA = fullCommit
                    env.CHECKER_SOURCE_COMMIT = checkerSourceCommit
                    env.CHECKER_TEST_IMAGE = "wes-release-checker-test:${env.BUILD_NUMBER}-${fullCommit.take(7)}"
                    env.CHECKER_IMAGE_LOCAL = "wes-release-checker:${env.BUILD_NUMBER}-${fullCommit.take(7)}"
                    env.CHECKER_IMAGE_IMMUTABLE = "${env.CHECKER_IMAGE_REPO}:${checkerSourceCommit}"
                    env.CHECKER_IMAGE_CHANNEL = "${env.CHECKER_IMAGE_REPO}:${channelTag}"
                }
            }
        }

        stage('Checker Pipeline') {
            when {
                expression { env.CHECKER_INPUT_CHANGED == 'true' }
            }
            stages {
                stage('Build Checker Test Image') {
                    steps {
                        sh '''
                            set -eu
                            docker build \
                                --provenance=false \
                                --sbom=false \
                                --target testing \
                                -t "${CHECKER_TEST_IMAGE}" \
                                tools/release_checker
                        '''
                    }
                }

                stage('Checker Tests and Fixtures') {
                    steps {
                        sh '''
                            set -eu
                            docker run --rm \
                                -e OASDIFF_BIN=/usr/local/bin/oasdiff \
                                "${CHECKER_TEST_IMAGE}" \
                                /opt/tools/release_checker/tests -q
                            docker run --rm \
                                --entrypoint python \
                                -v "$WORKSPACE:/workspace:ro" \
                                -w /workspace \
                                "${CHECKER_TEST_IMAGE}" \
                                -m pytest -c /dev/null -p no:cacheprovider \
                                --confcutdir=tests/deployment tests/deployment/test_release_checker_ci.py -q
                        '''
                    }
                }

                stage('Build Checker Production Image') {
                    steps {
                        sh '''
                            set -eu
                            docker build \
                                --provenance=false \
                                --sbom=false \
                                --target production \
                                -t "${CHECKER_IMAGE_LOCAL}" \
                                tools/release_checker
                            docker run --rm "${CHECKER_IMAGE_LOCAL}" --help >/dev/null
                        '''
                    }
                }

                stage('Push Checker Image') {
                    when {
                        expression {
                            env.CI_EVENT_TYPE == 'PUSH' &&
                            env.CI_IS_MERGE_REQUEST != 'true' &&
                            env.CI_RELEASE_GATE_READY == 'true' &&
                            (env.CI_SOURCE_BRANCH == 'develop' || env.CI_SOURCE_BRANCH == 'main')
                        }
                    }
                    steps {
                        withCredentials([usernamePassword(credentialsId: 'gitlab-http-creds', usernameVariable: 'GITLAB_USER', passwordVariable: 'GITLAB_TOKEN')]) {
                            sh '''
                                set -eu
                                export REGISTRY_URL="${REGISTRY_URL}"
                                sh ./docker/test/registry-login.sh
                                mkdir -p reports
                                docker tag "${CHECKER_IMAGE_LOCAL}" "${CHECKER_IMAGE_IMMUTABLE}"
                                docker tag "${CHECKER_IMAGE_LOCAL}" "${CHECKER_IMAGE_CHANNEL}"
                                docker push "${CHECKER_IMAGE_IMMUTABLE}"
                                docker push "${CHECKER_IMAGE_CHANNEL}"
                                docker inspect --format='{{index .RepoDigests 0}}' "${CHECKER_IMAGE_IMMUTABLE}" \
                                    > reports/release-checker-image-digest.txt
                            '''
                        }
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'reports/release-checker-image-digest.txt', allowEmptyArchive: true, fingerprint: true
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            sh '''
                docker image rm -f "${CHECKER_TEST_IMAGE}" >/dev/null 2>&1 || true
                docker image rm -f "${CHECKER_IMAGE_LOCAL}" >/dev/null 2>&1 || true
                docker image rm -f "${CHECKER_IMAGE_IMMUTABLE}" >/dev/null 2>&1 || true
                docker image rm -f "${CHECKER_IMAGE_CHANNEL}" >/dev/null 2>&1 || true
            '''
            cleanWs()
        }
    }
}
