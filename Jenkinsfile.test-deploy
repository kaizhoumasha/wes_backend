pipeline {
    agent {
        label 'WES'
    }

    parameters {
        choice(name: 'DEPLOY_SCOPE', choices: ['FRONTEND', 'BACKEND', 'BOTH'], description: '本次候选范围')
        string(name: 'FRONTEND_CANDIDATE_DIGEST', defaultValue: '', description: 'FRONTEND/BOTH 必填：sha256:<64 hex>')
        string(name: 'BACKEND_CANDIDATE_DIGEST', defaultValue: '', description: 'BACKEND/BOTH 必填：sha256:<64 hex>')
        string(name: 'DEPLOY_SOURCE_COMMIT_SHA', description: '部署编排源码的完整 commit SHA')
        booleanParam(name: 'FORCE_FULL', defaultValue: false, description: '只允许把自动 FAST 升级为 FULL')
        text(name: 'WARN_APPROVAL_REASON', defaultValue: '', description: 'WARN 时绑定精确 digest/diff 的单次批准理由')
    }

    environment {
        REGISTRY_URL = '192.168.0.220:5050'
        BACKEND_IMAGE_REPO = '192.168.0.220:5050/wes/wes_backend'
        FRONTEND_IMAGE_REPO = '192.168.0.220:5050/wes/wes_frontend'
        CHECKER_IMAGE_REPO = '192.168.0.220:5050/wes/wes_backend/release_checker'
        DEPLOY_PATH = '/opt/wes_backend'
        DEPLOY_ENV_FILE = '.env'
        DEPLOY_COMPOSE_FILE = 'docker-compose.test-deploy.yml'
        WMS_PROVIDER_PROFILE_HOST_FILE = '/etc/wes/wms-provider.yaml'
        CURRENT_RELEASE_EVIDENCE_DIR = '/srv/wes/releases/current'
        RELEASE_EVIDENCE_ROOT = '/srv/wes/releases'
        HEALTH_CHECK_URL = 'http://127.0.0.1:8001/ready'
        IMAGE_PULL_RETRIES = '24'
    }

    options {
        buildDiscarder(logRotator(daysToKeepStr: '14', numToKeepStr: '20', artifactDaysToKeepStr: '14', artifactNumToKeepStr: '20'))
        timeout(time: 45, unit: 'MINUTES')
        skipDefaultCheckout(true)
        disableConcurrentBuilds(abortPrevious: false)
        timestamps()
    }

    stages {
        stage('Checkout Deploy Source') {
            steps {
                script {
                    String deployScope = params.DEPLOY_SCOPE?.trim()?.toUpperCase()
                    String frontendDigest = params.FRONTEND_CANDIDATE_DIGEST?.trim()
                    String backendDigest = params.BACKEND_CANDIDATE_DIGEST?.trim()
                    String deploySourceCommit = params.DEPLOY_SOURCE_COMMIT_SHA?.trim()

                    if (!(deployScope in ['FRONTEND', 'BACKEND', 'BOTH'])) {
                        error('DEPLOY_SCOPE 必须是 FRONTEND、BACKEND 或 BOTH')
                    }
                    if (!(deploySourceCommit ==~ /[0-9a-f]{40}/)) {
                        error('DEPLOY_SOURCE_COMMIT_SHA 必须是 40 位小写 commit SHA')
                    }
                    if (frontendDigest && !(frontendDigest ==~ /sha256:[0-9a-f]{64}/)) {
                        error('FRONTEND_CANDIDATE_DIGEST 必须是 immutable sha256 digest')
                    }
                    if (backendDigest && !(backendDigest ==~ /sha256:[0-9a-f]{64}/)) {
                        error('BACKEND_CANDIDATE_DIGEST 必须是 immutable sha256 digest')
                    }
                    if (deployScope == 'FRONTEND' && (!frontendDigest || backendDigest)) {
                        error('FRONTEND scope 只接受 frontend candidate digest')
                    }
                    if (deployScope == 'BACKEND' && (!backendDigest || frontendDigest)) {
                        error('BACKEND scope 只接受 backend candidate digest')
                    }
                    if (deployScope == 'BOTH' && (!frontendDigest || !backendDigest)) {
                        error('BOTH scope 必须同时提供两个 candidate digest')
                    }

                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: deploySourceCommit]],
                        userRemoteConfigs: [[
                            name: 'origin',
                            url: 'http://192.168.0.220:9080/wes/wes_backend.git',
                            credentialsId: 'gitlab-http-creds',
                            refspec: '+refs/heads/*:refs/remotes/origin/*'
                        ]],
                        extensions: [[$class: 'CleanBeforeCheckout']]
                    ])
                    sh "git reset --hard '${deploySourceCommit}'"
                    String actualCommit = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
                    if (actualCommit != deploySourceCommit) {
                        error('部署仓库未固定到 DEPLOY_SOURCE_COMMIT_SHA')
                    }
                    String checkerSourceCommit = sh(
                        returnStdout: true,
                        script: 'git log -1 --format=%H -- tools/release_checker Jenkinsfile.release-checker-ci tests/deployment/test_release_checker_ci.py'
                    ).trim()
                    if (!(checkerSourceCommit ==~ /[0-9a-f]{40}/)) {
                        error('部署源码无法确定唯一 checker owner commit')
                    }

                    env.DEPLOY_SCOPE = deployScope
                    env.DEPLOY_SOURCE_COMMIT_SHA = deploySourceCommit
                    env.CHECKER_SOURCE_COMMIT = checkerSourceCommit
                    env.FRONTEND_CANDIDATE_DIGEST = frontendDigest
                    env.BACKEND_CANDIDATE_DIGEST = backendDigest
                    env.FORCE_FULL_VALUE = params.FORCE_FULL ? 'true' : 'false'
                    env.WARN_APPROVAL_REASON_VALUE = params.WARN_APPROVAL_REASON ?: ''
                    String releaseContainerOwner = "${env.BUILD_TAG ?: ''}-${deploySourceCommit.take(12)}"
                        .toLowerCase().replaceAll(/[^a-z0-9-]/, '-').replaceAll(/-+/, '-')
                    if (!(releaseContainerOwner ==~ /[a-z0-9][a-z0-9-]{0,180}-[0-9a-f]{12}/)) {
                        error('无法生成安全的 release-readiness container owner')
                    }
                    env.RELEASE_ID = "test-${env.BUILD_NUMBER}-${deploySourceCommit.take(12)}"
                    env.CHECKER_CONTAINER_NAME = "wes-release-checker-${env.BUILD_NUMBER}-${deploySourceCommit.take(12)}"
                    env.RELEASE_READINESS_CONTAINER_NAME = "wes-release-readiness-${releaseContainerOwner}"
                }
            }
        }

        stage('Deploy Test Environment') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'gitlab-http-creds', usernameVariable: 'GITLAB_USER', passwordVariable: 'GITLAB_TOKEN'),
                    usernamePassword(credentialsId: 'wes-test-bootstrap-admin', usernameVariable: 'BOOTSTRAP_ADMIN_USERNAME', passwordVariable: 'BOOTSTRAP_ADMIN_PASSWORD')
                ]) {
                    sh '''
                        set -eu
                        set -o pipefail
                        umask 077

                        cd "${WORKSPACE}"
                        [ "$(git rev-parse HEAD)" = "${DEPLOY_SOURCE_COMMIT_SHA}" ] || exit 1

                        if [ -z "${WMS_PROVIDER_PROFILE_HOST_FILE:-}" ]; then
                            echo "PRE-CUTOVER_ABORTED: 未配置 WMS Provider profile 路径"
                            exit 1
                        fi
                        if [ ! -f "${WMS_PROVIDER_PROFILE_HOST_FILE}" ]; then
                            echo "PRE-CUTOVER_ABORTED: WMS Provider profile 不是普通文件"
                            exit 1
                        fi
                        if [ ! -r "${WMS_PROVIDER_PROFILE_HOST_FILE}" ]; then
                            echo "PRE-CUTOVER_ABORTED: WMS Provider profile 不可读"
                            exit 1
                        fi
                        if [ ! -r "${DEPLOY_PATH}/${DEPLOY_ENV_FILE}" ]; then
                            echo "PRE-CUTOVER_ABORTED: TEST runtime env 不可读"
                            exit 1
                        fi
                        export REGISTRY_URL="${REGISTRY_URL}"
                        export WMS_PROVIDER_PROFILE_HOST_FILE="${WMS_PROVIDER_PROFILE_HOST_FILE}"
                        sh ./docker/test/registry-login.sh

                        PREFLIGHT_DIR=$(mktemp -d "${WORKSPACE}/.release-preflight.XXXXXX")
                        STAGED_DEPLOY_PATH="${PREFLIGHT_DIR}/deploy-source"
                        STAGED_RUNTIME_ENV_FILE="${PREFLIGHT_DIR}/runtime.env"
                        mkdir "${STAGED_DEPLOY_PATH}"
                        git archive "${DEPLOY_SOURCE_COMMIT_SHA}" | tar -x -C "${STAGED_DEPLOY_PATH}"
                        cp "${DEPLOY_PATH}/${DEPLOY_ENV_FILE}" "${STAGED_RUNTIME_ENV_FILE}"
                        cp "${STAGED_RUNTIME_ENV_FILE}" "${STAGED_DEPLOY_PATH}/.env"
                        COMPOSE_PROJECT_DIR="${STAGED_DEPLOY_PATH}"
                        COMPOSE_ENV_FILE="${STAGED_RUNTIME_ENV_FILE}"
                        COMPOSE_FILE="${STAGED_DEPLOY_PATH}/${DEPLOY_COMPOSE_FILE}"
                        REPORT_DIR="${WORKSPACE}/reports/${RELEASE_ID}"
                        REPORT_FILE="${REPORT_DIR}/compatibility-report.json"
                        RELEASE_DIR="${RELEASE_EVIDENCE_ROOT}/${RELEASE_ID}"
                        mkdir -p "${REPORT_DIR}"
                        FRONTEND_EXTRACT_CONTAINER=""
                        BACKEND_EXTRACT_CONTAINER=""
                        MAINTENANCE_MODE=false
                        CUTOVER_STAGE=preflight

                        compose() {
                            docker compose --env-file "${COMPOSE_ENV_FILE}" --project-directory "${COMPOSE_PROJECT_DIR}" -f "${COMPOSE_FILE}" "$@"
                        }
                        cleanup_private_inputs() {
                            [ -z "${FRONTEND_EXTRACT_CONTAINER}" ] || docker rm -f "${FRONTEND_EXTRACT_CONTAINER}" >/dev/null 2>&1 || true
                            [ -z "${BACKEND_EXTRACT_CONTAINER}" ] || docker rm -f "${BACKEND_EXTRACT_CONTAINER}" >/dev/null 2>&1 || true
                            docker rm -f "${CHECKER_CONTAINER_NAME}" >/dev/null 2>&1 || true
                            docker rm -f "${RELEASE_READINESS_CONTAINER_NAME}" >/dev/null 2>&1 || true
                            rm -rf "${PREFLIGHT_DIR}"
                        }
                        hold_entrypoint_on_failure() {
                            status=$?
                            cleanup_private_inputs
                            if [ "$status" -ne 0 ]; then
                                if [ "${MAINTENANCE_MODE}" = true ]; then
                                    echo "CUTOVER_FAILED_MAINTENANCE_HELD: ${CUTOVER_STAGE}"
                                    compose stop nginx >/dev/null 2>&1 || true
                                else
                                    echo "PRE-CUTOVER_ABORTED: ${CUTOVER_STAGE}"
                                fi
                            fi
                            exit "$status"
                        }
                        trap hold_entrypoint_on_failure EXIT
                        abort_pre_cutover() {
                            CUTOVER_STAGE="$1"
                            return 1
                        }
                        wait_for_image() {
                            image_ref="$1"
                            retries="$2"
                            attempt=1
                            while [ "$attempt" -le "$retries" ]; do
                                docker pull "$image_ref" >/dev/null 2>&1 && return 0
                                attempt=$((attempt + 1))
                                sleep 5
                            done
                            return 1
                        }
                        # TEST_CHECKER_CONTAINER_RUNNER_BEGIN
                        remove_checker_container() {
                            docker rm -f "${CHECKER_CONTAINER_NAME}" >/dev/null 2>&1 || true
                        }
                        run_checker_container() {
                            checker_timeout_seconds="$1"
                            shift
                            remove_checker_container
                            set +e
                            timeout --signal=KILL "${checker_timeout_seconds}s" docker run \
                                --name "${CHECKER_CONTAINER_NAME}" "$@"
                            checker_container_status=$?
                            set -e
                            remove_checker_container
                            return "$checker_container_status"
                        }
                        # TEST_CHECKER_CONTAINER_RUNNER_END
                        discover_live_image() {
                            service="$1"
                            container_id=$(compose ps -a -q "$service")
                            [ -n "$container_id" ] || return 1
                            docker inspect --format '{{ .Config.Image }}' "$container_id"
                        }
                        discover_live_digest() {
                            service="$1"
                            image_ref=$(discover_live_image "$service") || return 1
                            case "$image_ref" in
                                *@sha256:[0-9a-f]*) printf '%s\n' "${image_ref##*@}" ;;
                                *) return 1 ;;
                            esac
                        }
                        discover_current_backend_topology() {
                            CURRENT_BACKEND_IMAGE=""
                            CURRENT_BACKEND_DIGEST=""
                            for service in api celery celery-wms-fulfillment celery_beat flower; do
                                service_image=$(discover_live_image "$service") || return 1
                                case "$service_image" in
                                    *@sha256:[0-9a-f]*) service_digest="${service_image##*@}" ;;
                                    *) return 1 ;;
                                esac
                                if [ -z "${CURRENT_BACKEND_DIGEST}" ]; then
                                    CURRENT_BACKEND_IMAGE="$service_image"
                                    CURRENT_BACKEND_DIGEST="$service_digest"
                                else
                                    [ "$service_digest" = "${CURRENT_BACKEND_DIGEST}" ] || return 1
                                fi
                            done
                            export CURRENT_BACKEND_IMAGE CURRENT_BACKEND_DIGEST
                        }
                        validate_selected_image_revision() {
                            image_ref="$1"
                            revision=$(docker image inspect --format '{{ index .Config.Labels "org.opencontainers.image.revision" }}' "$image_ref") || return 1
                            case "$revision" in
                                [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
                                *) echo "image revision 必须是 40 位小写 commit SHA"; return 1 ;;
                            esac
                        }
                        pin_checker_image() {
                            CHECKER_IMAGE_TAG="${CHECKER_IMAGE_REPO}:${CHECKER_SOURCE_COMMIT}"
                            wait_for_image "${CHECKER_IMAGE_TAG}" "${IMAGE_PULL_RETRIES}" || return 1
                            docker image inspect --format '{{ json .RepoDigests }}' "${CHECKER_IMAGE_TAG}" \
                                >"${PREFLIGHT_DIR}/checker-repo-digests.json" || return 1
                            CHECKER_IMAGE=$(python3 - "${PREFLIGHT_DIR}/checker-repo-digests.json" "${CHECKER_IMAGE_REPO}" <<'PY'
# TEST_CHECKER_REPODIGEST_SELECTOR_BEGIN
import json, re, sys
source, repository = sys.argv[1:]
with open(source, encoding="utf-8") as stream:
    values = json.load(stream)
if not isinstance(values, list) or not all(isinstance(value, str) for value in values):
    raise SystemExit(1)
matches = [value for value in values if re.fullmatch(re.escape(repository) + r"@sha256:[0-9a-f]{64}", value)]
if len(matches) != 1:
    raise SystemExit(1)
print(matches[0])
# TEST_CHECKER_REPODIGEST_SELECTOR_END
PY
                            ) || return 1
                            CHECKER_DIGEST_VALUE="${CHECKER_IMAGE##*@}"
                            export CHECKER_IMAGE CHECKER_DIGEST_VALUE
                        }
                        validate_current_report() {
                            run_checker_container 60 \
                                --entrypoint python \
                                -v "${CURRENT_REPORT}:/current/compatibility-report.json:ro" \
                                "${CHECKER_IMAGE}" -c '
# TEST_CURRENT_REPORT_VALIDATOR_BEGIN
import sys
from pathlib import Path
from tools.release_checker.release_checker import _read_json_object, validate_compatibility_report
report = _read_json_object(Path(sys.argv[1]))
validate_compatibility_report(report)
if report["pre_cutover_state"] != "READY":
    raise SystemExit(1)
candidate = report["candidate_digests"]
current = report["current_digests"]
print(candidate.get("frontend", current.get("frontend")), candidate.get("backend", current.get("backend")))
# TEST_CURRENT_REPORT_VALIDATOR_END
' /current/compatibility-report.json
                        }
                        verify_current_peer_evidence() {
                            CURRENT_EVIDENCE_VALID=false
                            CURRENT_REPORT="${CURRENT_RELEASE_EVIDENCE_DIR}/compatibility-report.json"
                            if [ ! -r "${CURRENT_REPORT}" ]; then
                                [ "${DEPLOY_SCOPE}" = BOTH ] && return 0
                                return 1
                            fi
                            evidence_pair=$(validate_current_report) || {
                                [ "${DEPLOY_SCOPE}" = BOTH ] && return 0
                                return 1
                            }
                            set -- ${evidence_pair}
                            EVIDENCE_FRONTEND_DIGEST="$1"
                            EVIDENCE_BACKEND_DIGEST="$2"
                            if [ "${CURRENT_FRONTEND_DIGEST}" = "${EVIDENCE_FRONTEND_DIGEST}" ] \
                                && [ "${CURRENT_BACKEND_DIGEST}" = "${EVIDENCE_BACKEND_DIGEST}" ] \
                                && [ -r "${CURRENT_RELEASE_EVIDENCE_DIR}/current-fingerprints.json" ]; then
                                CURRENT_EVIDENCE_VALID=true
                            fi
                            export CURRENT_EVIDENCE_VALID
                            [ "${DEPLOY_SCOPE}" != BOTH ] || return 0
                            if [ "${DEPLOY_SCOPE}" = FRONTEND ]; then
                                [ "${CURRENT_BACKEND_DIGEST}" = "${EVIDENCE_BACKEND_DIGEST}" ] || return 1
                                UNSELECTED_PEER_DIGEST="${CURRENT_BACKEND_DIGEST}"
                            else
                                [ "${CURRENT_FRONTEND_DIGEST}" = "${EVIDENCE_FRONTEND_DIGEST}" ] || return 1
                                UNSELECTED_PEER_DIGEST="${CURRENT_FRONTEND_DIGEST}"
                            fi
                            export UNSELECTED_PEER_DIGEST
                        }
                        extract_release_artifacts() {
                            side="$1"
                            image_ref="$2"
                            side_dir="${PREFLIGHT_DIR}/${side}"
                            mkdir -p "$side_dir"
                            container_id=$(docker create "$image_ref") || return 1
                            if [ "$side" = frontend ]; then FRONTEND_EXTRACT_CONTAINER="$container_id"; else BACKEND_EXTRACT_CONTAINER="$container_id"; fi
                            docker cp "${container_id}:/opt/wes/release/." "$side_dir/" || return 1
                            docker image inspect --format '{{ json .Config.Labels }}' "$image_ref" >"${PREFLIGHT_DIR}/${side}-all-labels.json" || return 1
                            python3 - "$side" "${PREFLIGHT_DIR}/${side}-all-labels.json" "${PREFLIGHT_DIR}/${side}-labels.json" <<'PY'
import json, sys
side, source, target = sys.argv[1:]
fields = {
    "frontend": ["org.wes.release.consumer-openapi.sha256", "org.wes.release.required-operations.sha256", "org.wes.release.required-permissions.sha256", "org.wes.release.frontend-dependencies.sha256", "org.wes.release.frontend-recipe.sha256"],
    "backend": ["org.wes.release.provider-openapi.sha256", "org.wes.release.provided-permissions.sha256", "org.wes.release.migration-tree.sha256", "org.wes.release.backend-dependencies.sha256", "org.wes.release.backend-recipe.sha256", "org.wes.release.expected-schema-head"],
}[side]
labels = json.load(open(source, encoding="utf-8"))
selected = {field: labels.get(field) for field in fields}
with open(target, "w", encoding="utf-8") as stream:
    json.dump(selected, stream, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
    print(file=stream)
PY
                        }
                        write_effective_facts() {
                            python3 - "${STAGED_DEPLOY_PATH}" "${STAGED_RUNTIME_ENV_FILE}" "${WMS_PROVIDER_PROFILE_HOST_FILE}" "${PREFLIGHT_DIR}/effective-facts-base.json" <<'PY'
import hashlib, json, sys
from pathlib import Path
def item(logical, physical):
    return {"path": logical, "sha256": hashlib.sha256(Path(physical).read_bytes()).hexdigest()}
root = Path(sys.argv[1])
deploy_paths = ["Jenkinsfile.test-deploy", "docker-compose.test-deploy.yml", "scripts/wait_for_http.py", "nginx/nginx.conf", "nginx/conf.d/default.conf", "postgresql/base.conf", "postgresql/test.conf", "redis/base.conf", "redis/test.conf"]
deploy = [item(path, root / path) for path in deploy_paths]
runtime = [item("runtime/.env", sys.argv[2]), item("runtime/wms-provider.yaml", sys.argv[3])]
value = {"deploy": {"kind": "wes.release.input-set.v1", "files": sorted(deploy, key=lambda x: x["path"])}, "runtime": {"kind": "wes.release.input-set.v1", "files": sorted(runtime, key=lambda x: x["path"])}}
with open(sys.argv[4], "w", encoding="utf-8") as stream:
    json.dump(value, stream, sort_keys=True, separators=(",", ":")); print(file=stream)
PY
                        }
                        resolve_database_identity() {
                            TARGET_POSTGRES_DB=$(compose config --format json | python3 -c '
import json, sys
value = json.load(sys.stdin)["services"]["api"]["environment"].get("POSTGRES_DB")
if not isinstance(value, str) or not value:
    raise SystemExit(1)
print(value)
') || return 1
                            case "${TARGET_POSTGRES_DB}" in
                                *[!a-z0-9_]*|'') return 1 ;;
                            esac
                            [ "${#TARGET_POSTGRES_DB}" -le 63 ] || return 1

                            api_container_id=$(compose ps -a -q api) || return 1
                            [ -n "${api_container_id}" ] || return 1
                            CURRENT_POSTGRES_DB=$(docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' \
                                "${api_container_id}" | sed -n 's/^POSTGRES_DB=//p') || return 1
                            case "${CURRENT_POSTGRES_DB}" in
                                *[!a-z0-9_]*|'') return 1 ;;
                            esac
                            if [ "${TARGET_POSTGRES_DB}" != "${CURRENT_POSTGRES_DB}" ]; then
                                echo "database identity drift: runtime=${TARGET_POSTGRES_DB} current=${CURRENT_POSTGRES_DB}" >&2
                                return 1
                            fi
                            export TARGET_POSTGRES_DB
                        }
                        read_database_heads() {
                            compose exec -T -e TARGET_POSTGRES_DB="${TARGET_POSTGRES_DB}" db sh -eu -c \
                                'psql -U "$POSTGRES_USER" -d "$TARGET_POSTGRES_DB" -tAc "select version_num from wes_sys.alembic_version order by version_num"'
                        }
                        query_database_state() {
                            DATABASE_HEADS=$(read_database_heads) || return 1
                            EXPECTED_SCHEMA_HEAD=$(python3 - "${PREFLIGHT_DIR}/backend-labels.json" <<'PY'
import json, sys
print(json.load(open(sys.argv[1], encoding="utf-8"))["org.wes.release.expected-schema-head"])
PY
                            ) || return 1
                            head_count=$(printf '%s\n' "${DATABASE_HEADS}" | sed '/^[[:space:]]*$/d' | wc -l | tr -d ' ')
                            if [ "$head_count" = 1 ] && [ "${DATABASE_HEADS}" = "${EXPECTED_SCHEMA_HEAD}" ]; then
                                DATABASE_RELATION=equal
                            elif [ "$head_count" = 1 ]; then
                                DATABASE_RELATION=$(docker run --rm -i --entrypoint /opt/venv/bin/python "${BACKEND_IMAGE}" - "${DATABASE_HEADS}" "${EXPECTED_SCHEMA_HEAD}" <<'PY'
import sys
from alembic.config import Config
from alembic.script import ScriptDirectory
current, candidate = sys.argv[1:]
try:
    script = ScriptDirectory.from_config(Config("/app/alembic.ini"))
    script.get_revision(current)
    script.get_revision(candidate)
    list(script.iterate_revisions(candidate, current))
    print("ancestor")
except Exception:
    print("unknown")
PY
                                ) || DATABASE_RELATION=unknown
                            else
                                DATABASE_RELATION=unknown
                            fi
                            export DATABASE_HEADS EXPECTED_SCHEMA_HEAD DATABASE_RELATION
                        }
                        write_checker_inputs() {
                            python3 - "${PREFLIGHT_DIR}" "${DEPLOY_SCOPE}" "${FRONTEND_CANDIDATE_DIGEST:-}" "${BACKEND_CANDIDATE_DIGEST:-}" "${CURRENT_FRONTEND_DIGEST}" "${CURRENT_BACKEND_DIGEST}" "${DATABASE_HEADS}" "${DATABASE_RELATION}" <<'PY'
import json, sys
root, scope, frontend, backend, current_frontend, current_backend, heads, relation = sys.argv[1:]
def write(name, value):
    with open(f"{root}/{name}", "w", encoding="utf-8") as stream:
        json.dump(value, stream, sort_keys=True, separators=(",", ":")); print(file=stream)
candidate = {}
if scope in {"FRONTEND", "BOTH"}: candidate["frontend"] = frontend
if scope in {"BACKEND", "BOTH"}: candidate["backend"] = backend
write("candidate-digests.json", candidate)
write("current-digests.json", {"frontend": current_frontend, "backend": current_backend})
base = json.load(open(f"{root}/effective-facts-base.json", encoding="utf-8"))
write("effective-facts.json", {"kind": "wes.release.effective-facts.v1", "deploy": base["deploy"], "runtime": base["runtime"], "database": {"current_heads": [line for line in heads.splitlines() if line.strip()], "relation_to_candidate": relation}})
PY
                        }
                        run_release_checker() {
                            set -- \
                                -v "${PREFLIGHT_DIR}/frontend:/frontend:ro" \
                                -v "${PREFLIGHT_DIR}/backend:/backend:ro" \
                                -v "${PREFLIGHT_DIR}:/inputs:ro"
                            if [ "${CURRENT_EVIDENCE_VALID:-false}" = true ]; then
                                set -- "$@" -v "${CURRENT_RELEASE_EVIDENCE_DIR}:/current:ro"
                            fi
                            set -- "$@" \
                                -v "${REPORT_DIR}:/report" \
                                "${CHECKER_IMAGE}" \
                                --frontend-dir /frontend \
                                --backend-dir /backend \
                                --frontend-labels /inputs/frontend-labels.json \
                                --backend-labels /inputs/backend-labels.json \
                                --effective-facts /inputs/effective-facts.json \
                                --release-id "${RELEASE_ID}" \
                                --deploy-scope "${DEPLOY_SCOPE}" \
                                --candidate-digests /inputs/candidate-digests.json \
                                --current-digests /inputs/current-digests.json \
                                --checker-digest "${CHECKER_DIGEST_VALUE}" \
                                --output /report/compatibility-report.json
                            [ "${CURRENT_EVIDENCE_VALID:-false}" != true ] || set -- "$@" --current-fingerprints /current/current-fingerprints.json
                            [ "${FORCE_FULL_VALUE}" != true ] || set -- "$@" --force-full
                            [ -z "${WARN_APPROVAL_REASON_VALUE:-}" ] || set -- "$@" --warn-approval-reason "${WARN_APPROVAL_REASON_VALUE:-}"
                            if run_checker_container 60 "$@"; then
                                checker_status=0
                            else
                                checker_status=$?
                            fi
                            [ "$checker_status" -eq 0 ] || return 1
                            EFFECTIVE_MODE=$(python3 - "${REPORT_FILE}" <<'PY'
import json, sys
value = json.load(open(sys.argv[1], encoding="utf-8"))
if value.get("pre_cutover_state") != "READY" or value.get("effective_mode") not in {"FAST", "FULL"}:
    raise SystemExit(1)
print(value["effective_mode"])
PY
                            ) || return 1
                            export EFFECTIVE_MODE
                        }
                        candidate_backend_python() {
                            candidate_timeout_seconds=""
                            if [ "${1:-}" = --timeout-seconds ]; then
                                candidate_timeout_seconds="$2"
                                shift 2
                            fi
                            if [ -n "$candidate_timeout_seconds" ]; then
                                timeout --signal=KILL "${candidate_timeout_seconds}s" \
                                    docker compose --env-file "${COMPOSE_ENV_FILE}" \
                                    --project-directory "${COMPOSE_PROJECT_DIR}" -f "${COMPOSE_FILE}" \
                                    run --rm --no-deps --name "${RELEASE_READINESS_CONTAINER_NAME}" \
                                    -e DATABASE_RUNTIME_ROLE=cli -e DATABASE_POOL_SIZE=1 -e DATABASE_MAX_OVERFLOW=0 \
                                    --entrypoint /opt/venv/bin/python api "$@"
                            else
                                compose run --rm --no-deps \
                                    -e DATABASE_RUNTIME_ROLE=cli -e DATABASE_POOL_SIZE=1 -e DATABASE_MAX_OVERFLOW=0 \
                                    --entrypoint /opt/venv/bin/python api "$@"
                            fi
                        }
                        business_preflight() {
                            candidate_backend_python -c '
from src.app.runtime.system_capabilities.wms.provider_catalog import validate_wms_transport_configuration
from src.core.conf import settings
try:
    validate_wms_transport_configuration(settings_source=settings)
except Exception as exc:
    print(f"WMS_PROFILE_PREFLIGHT_ERROR={type(exc).__name__}: {exc}", flush=True)
    raise SystemExit(1) from exc
print("WMS_PROFILE_PREFLIGHT=valid", flush=True)
' || return 1
                        }
                        write_next_current_fingerprints() {
                            python3 - "${PREFLIGHT_DIR}" <<'PY'
import json, sys
root = sys.argv[1]
frontend = json.load(open(f"{root}/frontend-labels.json", encoding="utf-8"))
backend = json.load(open(f"{root}/backend-labels.json", encoding="utf-8"))
effective = json.load(open(f"{root}/effective-facts.json", encoding="utf-8"))
value = {
    "kind": "wes.release.current-fingerprints.v1",
    "frontend": {"consumer_openapi_sha256": frontend["org.wes.release.consumer-openapi.sha256"], "required_operations_sha256": frontend["org.wes.release.required-operations.sha256"], "required_permissions_sha256": frontend["org.wes.release.required-permissions.sha256"], "dependencies_sha256": frontend["org.wes.release.frontend-dependencies.sha256"], "recipe_sha256": frontend["org.wes.release.frontend-recipe.sha256"]},
    "backend": {"provider_openapi_sha256": backend["org.wes.release.provider-openapi.sha256"], "provided_permissions_sha256": backend["org.wes.release.provided-permissions.sha256"], "migration_tree_sha256": backend["org.wes.release.migration-tree.sha256"], "dependencies_sha256": backend["org.wes.release.backend-dependencies.sha256"], "recipe_sha256": backend["org.wes.release.backend-recipe.sha256"], "expected_schema_head": backend["org.wes.release.expected-schema-head"]},
    "deploy": effective["deploy"], "runtime": effective["runtime"],
}
with open(f"{root}/next-current-fingerprints.json", "w", encoding="utf-8") as stream:
    json.dump(value, stream, sort_keys=True, separators=(",", ":")); print(file=stream)
PY
                            NEXT_CURRENT_FINGERPRINTS="${PREFLIGHT_DIR}/next-current-fingerprints.json"
                            export NEXT_CURRENT_FINGERPRINTS
                        }

                        # TEST_DEPLOY_PREFLIGHT_ORDER_BEGIN
                        FRONTEND_IMAGE=""
                        BACKEND_IMAGE=""
                        if [ "${DEPLOY_SCOPE}" = FRONTEND ] || [ "${DEPLOY_SCOPE}" = BOTH ]; then
                            FRONTEND_IMAGE="${FRONTEND_IMAGE_REPO}@${FRONTEND_CANDIDATE_DIGEST}"
                            wait_for_image "${FRONTEND_IMAGE}" "${IMAGE_PULL_RETRIES}" || abort_pre_cutover frontend-candidate-pull
                            validate_selected_image_revision "${FRONTEND_IMAGE}" || abort_pre_cutover frontend-image-revision
                        fi
                        if [ "${DEPLOY_SCOPE}" = BACKEND ] || [ "${DEPLOY_SCOPE}" = BOTH ]; then
                            BACKEND_IMAGE="${BACKEND_IMAGE_REPO}@${BACKEND_CANDIDATE_DIGEST}"
                            wait_for_image "${BACKEND_IMAGE}" "${IMAGE_PULL_RETRIES}" || abort_pre_cutover backend-candidate-pull
                            validate_selected_image_revision "${BACKEND_IMAGE}" || abort_pre_cutover backend-image-revision
                        fi
                        pin_checker_image || abort_pre_cutover checker-image-pin

                        CURRENT_FRONTEND_IMAGE=$(discover_live_image frontend) || abort_pre_cutover current-frontend-discovery
                        case "${CURRENT_FRONTEND_IMAGE}" in
                            *@sha256:[0-9a-f]*) CURRENT_FRONTEND_DIGEST="${CURRENT_FRONTEND_IMAGE##*@}" ;;
                            *) abort_pre_cutover current-frontend-discovery ;;
                        esac
                        discover_current_backend_topology || abort_pre_cutover current-backend-discovery
                        resolve_database_identity || abort_pre_cutover database-identity
                        export CURRENT_FRONTEND_IMAGE CURRENT_FRONTEND_DIGEST
                        [ -n "${FRONTEND_IMAGE}" ] || FRONTEND_IMAGE="${CURRENT_FRONTEND_IMAGE}"
                        [ -n "${BACKEND_IMAGE}" ] || BACKEND_IMAGE="${CURRENT_BACKEND_IMAGE}"
                        export FRONTEND_IMAGE BACKEND_IMAGE
                        validate_selected_image_revision "${FRONTEND_IMAGE}" || abort_pre_cutover frontend-image-revision
                        validate_selected_image_revision "${BACKEND_IMAGE}" || abort_pre_cutover backend-image-revision
                        verify_current_peer_evidence || abort_pre_cutover current-peer-evidence
                        extract_release_artifacts frontend "${FRONTEND_IMAGE}" || abort_pre_cutover frontend-artifact-extraction
                        extract_release_artifacts backend "${BACKEND_IMAGE}" || abort_pre_cutover backend-artifact-extraction
                        write_effective_facts || abort_pre_cutover effective-input-hash
                        query_database_state || abort_pre_cutover database-state
                        write_checker_inputs || abort_pre_cutover checker-inputs
                        run_release_checker || abort_pre_cutover compatibility-check
                        echo "🔎 在维护态前编译校验 WMS Provider profile"
                        business_preflight || abort_pre_cutover wms-profile-preflight
                        write_next_current_fingerprints || abort_pre_cutover current-evidence-build
                        # TEST_DEPLOY_PREFLIGHT_ORDER_END

                        # TEST_DEPLOY_CUTOVER_BEGIN
                        FAST_CUTOVER_DEADLINE=""
                        fast_remaining_seconds() {
                            now=$(date +%s) || return 1
                            remaining=$(( FAST_CUTOVER_DEADLINE - now ))
                            [ "$remaining" -gt 0 ] || return 1
                            printf '%s\n' "$remaining"
                        }
                        run_with_cutover_budget() {
                            if [ "${EFFECTIVE_MODE}" != FAST ]; then
                                "$@"
                                return
                            fi
                            remaining=$(fast_remaining_seconds) || return 124
                            timeout --signal=KILL "${remaining}s" "$@"
                        }
                        cutover_compose() {
                            run_with_cutover_budget docker compose --env-file "${COMPOSE_ENV_FILE}" \
                                --project-directory "${COMPOSE_PROJECT_DIR}" -f "${COMPOSE_FILE}" "$@"
                        }
                        runtime_compose() {
                            if [ "${EFFECTIVE_MODE}" = FAST ]; then cutover_compose "$@"; else compose "$@"; fi
                        }
                        switch_live_deploy_source() {
                            run_with_cutover_budget git -C "${DEPLOY_PATH}" fetch "${WORKSPACE}" "${DEPLOY_SOURCE_COMMIT_SHA}" || return 1
                            run_with_cutover_budget git -C "${DEPLOY_PATH}" reset --hard "${DEPLOY_SOURCE_COMMIT_SHA}" || return 1
                            actual_commit=$(run_with_cutover_budget git -C "${DEPLOY_PATH}" rev-parse HEAD) || return 1
                            [ "$actual_commit" = "${DEPLOY_SOURCE_COMMIT_SHA}" ] || return 1
                            run_with_cutover_budget git -C "${DEPLOY_PATH}" clean -fd || return 1
                            runtime_env_tmp="${DEPLOY_PATH}/.env.${RELEASE_ID}.tmp"
                            run_with_cutover_budget cp "${STAGED_RUNTIME_ENV_FILE}" "${runtime_env_tmp}" || return 1
                            run_with_cutover_budget mv -f "${runtime_env_tmp}" "${DEPLOY_PATH}/.env" || return 1
                            COMPOSE_PROJECT_DIR="${DEPLOY_PATH}"
                            COMPOSE_ENV_FILE="${DEPLOY_PATH}/.env"
                            COMPOSE_FILE="${DEPLOY_PATH}/${DEPLOY_COMPOSE_FILE}"
                        }
                        MAINTENANCE_MODE=false
                        CUTOVER_STAGE=peer-reverification
                        keep_external_entrypoint_closed() {
                            status=$?
                            cleanup_private_inputs >/dev/null 2>&1 || true
                            if [ "$status" -ne 0 ] && [ "${MAINTENANCE_MODE}" = true ]; then
                                compose stop nginx >/dev/null 2>&1 || true
                            elif [ "$status" -ne 0 ]; then
                                echo "PRE-CUTOVER_ABORTED: ${CUTOVER_STAGE}"
                            fi
                            exit "$status"
                        }
                        trap keep_external_entrypoint_closed EXIT
                        fail_cutover() {
                            CUTOVER_STAGE="$1"
                            echo "CUTOVER_FAILED_MAINTENANCE_HELD: ${CUTOVER_STAGE}"
                            compose stop nginx >/dev/null 2>&1 || true
                            exit 1
                        }
                        reverify_unselected_peer() {
                            [ "${DEPLOY_SCOPE}" != BOTH ] || return 0
                            if [ "${DEPLOY_SCOPE}" = FRONTEND ]; then
                                for service in api celery celery-wms-fulfillment celery_beat flower; do
                                    live_digest=$(discover_live_digest "$service") || return 1
                                    [ "$live_digest" = "${CURRENT_BACKEND_DIGEST}" ] || return 1
                                done
                            else
                                live_digest=$(discover_live_digest frontend) || return 1
                                [ "$live_digest" = "${CURRENT_FRONTEND_DIGEST}" ] || return 1
                            fi
                        }
                        run_fast_cutover() {
                            if [ "${DEPLOY_SCOPE}" = "FRONTEND" ]; then
                                cutover_compose up -d --no-deps --force-recreate --wait frontend || return 1
                            elif [ "${DEPLOY_SCOPE}" = "BACKEND" ]; then
                                cutover_compose stop api celery celery-wms-fulfillment celery_beat flower || return 1
                                cutover_compose up -d --no-deps --force-recreate --wait api celery celery-wms-fulfillment celery_beat flower || return 1
                            else
                                cutover_compose stop api celery celery-wms-fulfillment celery_beat flower frontend || return 1
                                cutover_compose up -d --no-deps --force-recreate --wait api celery celery-wms-fulfillment celery_beat flower frontend || return 1
                            fi
                        }
                        check_authorization_drift() {
                            CUTOVER_STAGE=authorization-check
                            echo "🔎 校验权限目录零漂移"
                            compose run --rm --no-deps -e DATABASE_RUNTIME_ROLE=cli --entrypoint /opt/venv/bin/python api scripts/data/sync_permissions.py --check || return 1
                        }
                        release_operational_readiness() {
                            readiness_status=0
                            candidate_backend_python --timeout-seconds "${1:-15}" \
                                scripts/check_release_operational_readiness.py || readiness_status=$?
                            docker rm -f "${RELEASE_READINESS_CONTAINER_NAME}" >/dev/null 2>&1 || true
                            return "$readiness_status"
                        }
                        run_full_cutover() {
                            if [ "${DEPLOY_SCOPE}" = FRONTEND ]; then
                                compose stop frontend || return 1
                                check_authorization_drift || return 1
                                CUTOVER_STAGE=application-start
                                compose up -d --no-deps --force-recreate --wait frontend || return 1
                                return 0
                            fi
                            backup_name="${RELEASE_ID}.sql"
                            if [ "${DEPLOY_SCOPE}" = BACKEND ]; then
                                :
                            else
                                compose stop frontend || return 1
                            fi
                            CUTOVER_STAGE=database-identity-reverification
                            resolve_database_identity || return 1
                            CUTOVER_STAGE=backup
                            echo "🗄️ 备份当前数据库"
                            compose exec -T -e TARGET_POSTGRES_DB="${TARGET_POSTGRES_DB}" db sh -eu -c \
                                'pg_dump -U "$POSTGRES_USER" -d "$TARGET_POSTGRES_DB" -Fc -f "/backups/'"${backup_name}"'"' || return 1
                            compose exec -T db test -s "/backups/${backup_name}" || return 1
                            CUTOVER_STAGE=migration
                            echo "🗄️ 执行数据库迁移"
                            compose run --rm --no-deps -e DATABASE_RUNTIME_ROLE=cli --entrypoint /opt/venv/bin/alembic api upgrade head || return 1
                            CUTOVER_STAGE=migration-head
                            migrated_heads=$(read_database_heads) || return 1
                            migrated_head_count=$(printf '%s\n' "$migrated_heads" | sed '/^[[:space:]]*$/d' | wc -l | tr -d ' ')
                            [ "$migrated_head_count" = 1 ] || return 1
                            [ "$migrated_heads" = "${EXPECTED_SCHEMA_HEAD}" ] || return 1
                            CUTOVER_STAGE=authorization-apply
                            echo "🔐 收敛 existing DB 基础授权"
                            if AUTHORIZATION_OUTPUT=$(compose run --rm --no-deps -e DATABASE_RUNTIME_ROLE=cli \
                                --entrypoint /opt/venv/bin/python api scripts/data/sync_permissions.py --apply 2>&1); then
                                printf '%s\n' "${AUTHORIZATION_OUTPUT}"
                            else
                                authorization_status=$?
                                printf '%s\n' "${AUTHORIZATION_OUTPUT}"
                                if ! printf '%s\n' "${AUTHORIZATION_OUTPUT}" | grep -Fxq 'DATABASE_COMMITTED_CACHE_INVALIDATION_FAILED'; then
                                    echo "authorization apply exit status: ${authorization_status}" >&2
                                    return 1
                                fi
                                CUTOVER_STAGE=authorization-cache-repair
                                compose run --rm --no-deps --entrypoint /opt/venv/bin/python \
                                    api scripts/data/sync_permissions.py --repair-cache || return 1
                            fi
                            check_authorization_drift || return 1
                            CUTOVER_STAGE=application-start
                            echo "🐳 启动已固定版本的应用服务"
                            if [ "${DEPLOY_SCOPE}" = BACKEND ]; then
                                compose up -d --no-deps --force-recreate --wait api celery celery-wms-fulfillment celery_beat flower || return 1
                            else
                                compose up -d --force-recreate --wait api celery celery-wms-fulfillment celery_beat flower frontend || return 1
                            fi
                        }
                        verify_exact_topology() {
                            include_nginx="$1"
                            expected=$(runtime_compose config --services | LC_ALL=C sort) || return 1
                            running=$(runtime_compose ps --status running --services | LC_ALL=C sort) || return 1
                            if [ "$include_nginx" = false ]; then
                                expected=$(printf '%s\n' "$expected" | sed '/^nginx$/d') || return 1
                                running=$(printf '%s\n' "$running" | sed '/^nginx$/d') || return 1
                            else
                                [ "$include_nginx" = true ] || return 1
                            fi
                            [ "$running" = "$expected" ]
                        }
                        verify_readiness_and_topology() {
                            verify_service_digest() {
                                service="$1"
                                expected_digest="$2"
                                container_id=$(runtime_compose ps -q "$service") || return 1
                                [ -n "$container_id" ] || return 1
                                image_ref=$(run_with_cutover_budget docker inspect --format '{{ .Config.Image }}' "$container_id") || return 1
                                case "$image_ref" in
                                    *@sha256:[0-9a-f]*) actual_digest="${image_ref##*@}" ;;
                                    *) return 1 ;;
                                esac
                                [ "$actual_digest" = "$expected_digest" ]
                            }
                            backend_digest="${BACKEND_IMAGE##*@}"
                            frontend_digest="${FRONTEND_IMAGE##*@}"
                            for service in api celery celery-wms-fulfillment celery_beat flower; do
                                verify_service_digest "$service" "$backend_digest" || return 1
                            done
                            verify_service_digest frontend "$frontend_digest" || return 1
                            runtime_compose exec -T api curl -fsS "${HEALTH_CHECK_URL}" >/dev/null || return 1
                            runtime_compose exec -T frontend wget --no-verbose --tries=1 --spider http://127.0.0.1:5173/ >/dev/null || return 1
                            runtime_compose exec -T -e BOOTSTRAP_ADMIN_USERNAME -e BOOTSTRAP_ADMIN_PASSWORD api \
                                /opt/venv/bin/python scripts/check_bootstrap_admin_login.py --base-url http://127.0.0.1:8001 || return 1
                            verify_exact_topology false
                        }
                        persist_success_evidence() {
                            mkdir -p "${RELEASE_EVIDENCE_ROOT}" || return 1
                            mkdir "${RELEASE_DIR}" || return 1
                            cp "${REPORT_FILE}" "${RELEASE_DIR}/.compatibility-report.json.tmp" || return 1
                            mv "${RELEASE_DIR}/.compatibility-report.json.tmp" "${RELEASE_DIR}/compatibility-report.json" || return 1
                            cp "${NEXT_CURRENT_FINGERPRINTS}" "${RELEASE_DIR}/.current-fingerprints.json.tmp" || return 1
                            mv "${RELEASE_DIR}/.current-fingerprints.json.tmp" "${RELEASE_DIR}/current-fingerprints.json" || return 1
                            current_link="${RELEASE_EVIDENCE_ROOT}/.current.${RELEASE_ID}.tmp"
                            ln -s "${RELEASE_ID}" "$current_link" || return 1
                            python3 - "$current_link" "${CURRENT_RELEASE_EVIDENCE_DIR}" <<'PY'
import os, sys
os.replace(sys.argv[1], sys.argv[2])
PY
                        }

                        reverify_unselected_peer || abort_pre_cutover current-peer-drift
                        RELEASE_READINESS_REQUIRED=false
                        if [ "${EFFECTIVE_MODE}" = FULL ] \
                            && { [ "${DEPLOY_SCOPE}" = BACKEND ] || [ "${DEPLOY_SCOPE}" = BOTH ]; }; then
                            RELEASE_READINESS_REQUIRED=true
                            CUTOVER_STAGE=release-readiness-online
                            release_operational_readiness || abort_pre_cutover release-readiness-online
                        fi
                        if [ "${EFFECTIVE_MODE}" = FAST ]; then
                            FAST_CUTOVER_DEADLINE=$(( $(date +%s) + 120 ))
                        fi
                        echo "🔒 进入维护态并停止旧应用容器"
                        CUTOVER_STAGE=maintenance-stop
                        MAINTENANCE_MODE=true
                        cutover_compose stop nginx || fail_cutover maintenance-stop
                        close_retry=0
                        while run_with_cutover_budget curl -sS --connect-timeout 1 --max-time 2 \
                            "http://127.0.0.1:${NGINX_HTTP_PORT:-8080}/" >/dev/null 2>&1; do
                            close_retry=$((close_retry + 1))
                            [ "$close_retry" -lt 10 ] || fail_cutover listener-closure
                            run_with_cutover_budget sleep 1 || fail_cutover listener-closure
                        done
                        if [ "${RELEASE_READINESS_REQUIRED}" = true ]; then
                            CUTOVER_STAGE=api-stop
                            compose stop -t 30 api || fail_cutover api-stop
                            close_retry=0
                            while curl -sS --connect-timeout 1 --max-time 2 \
                                "http://127.0.0.1:${APP_HOST_PORT:-8002}/" >/dev/null 2>&1; do
                                close_retry=$((close_retry + 1))
                                [ "$close_retry" -lt 10 ] || fail_cutover api-listener-closure
                                sleep 1 || fail_cutover api-listener-closure
                            done
                            CUTOVER_STAGE=beat-stop
                            compose stop celery_beat || fail_cutover beat-stop
                            CUTOVER_STAGE=release-readiness-maintenance
                            readiness_deadline=$(( $(date +%s) + 60 ))
                            readiness_stable=0
                            while [ "$readiness_stable" -lt 2 ]; do
                                readiness_now=$(date +%s) || fail_cutover release-readiness-maintenance
                                readiness_remaining=$((readiness_deadline - readiness_now))
                                [ "$readiness_remaining" -gt 0 ] \
                                    || fail_cutover release-readiness-timeout
                                readiness_probe_timeout=15
                                if [ "$readiness_remaining" -lt "$readiness_probe_timeout" ]; then
                                    readiness_probe_timeout="$readiness_remaining"
                                fi
                                if release_operational_readiness "$readiness_probe_timeout"; then
                                    readiness_stable=$((readiness_stable + 1))
                                else
                                    readiness_status=$?
                                    if [ "$readiness_status" -eq 3 ]; then
                                        readiness_stable=0
                                    else
                                        fail_cutover release-readiness-maintenance
                                    fi
                                fi
                                readiness_now=$(date +%s) || fail_cutover release-readiness-maintenance
                                readiness_remaining=$((readiness_deadline - readiness_now))
                                [ "$readiness_remaining" -gt 0 ] \
                                    || fail_cutover release-readiness-timeout
                                [ "$readiness_stable" -ge 2 ] && break
                                [ "$readiness_remaining" -ge 2 ] \
                                    || fail_cutover release-readiness-timeout
                                sleep 2 || fail_cutover release-readiness-maintenance
                            done
                            CUTOVER_STAGE=worker-stop
                            compose stop celery celery-wms-fulfillment flower || fail_cutover worker-stop
                        fi
                        CUTOVER_STAGE=deploy-source-switch
                        switch_live_deploy_source || fail_cutover deploy-source-switch
                        if [ "${EFFECTIVE_MODE}" = FAST ]; then
                            CUTOVER_STAGE=fast-application-start
                            run_fast_cutover || fail_cutover fast-application-start
                        else
                            CUTOVER_STAGE=backup
                            run_full_cutover || fail_cutover "${CUTOVER_STAGE}"
                        fi
                        CUTOVER_STAGE=internal-readiness
                        verify_readiness_and_topology || fail_cutover internal-readiness
                        CUTOVER_STAGE=external-entrypoint
                        echo "🌐 恢复外部入口"
                        runtime_compose up -d --no-deps --wait --wait-timeout 60 nginx || fail_cutover external-entrypoint
                        CUTOVER_STAGE=external-health
                        run_with_cutover_budget python3 scripts/wait_for_http.py --url "http://127.0.0.1:${NGINX_HTTP_PORT:-8080}/health" --attempts 10 --timeout-seconds 2 --interval-seconds 1 || fail_cutover external-health
                        run_with_cutover_budget python3 scripts/wait_for_http.py --url "http://127.0.0.1:${NGINX_HTTP_PORT:-8080}/" --attempts 10 --timeout-seconds 2 --interval-seconds 1 || fail_cutover external-frontend
                        CUTOVER_STAGE=final-topology
                        verify_exact_topology true || fail_cutover final-topology
                        CUTOVER_STAGE=evidence-persist
                        persist_success_evidence || fail_cutover evidence-persist
                        CUTOVER_STAGE=complete
                        MAINTENANCE_MODE=false
                        echo "DEPLOYED: ${DEPLOY_SCOPE} ${EFFECTIVE_MODE}"
                        # TEST_DEPLOY_CUTOVER_END

                        cleanup_private_inputs
                        trap - EXIT
                    '''
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'reports/*/compatibility-report.json', allowEmptyArchive: true, fingerprint: true
                }
            }
        }
    }

    post {
        always {
            sh 'docker rm -f "${CHECKER_CONTAINER_NAME}" >/dev/null 2>&1 || true'
            sh 'docker rm -f "${RELEASE_READINESS_CONTAINER_NAME}" >/dev/null 2>&1 || true'
            cleanWs()
        }
        success {
            echo '✅ Test Deploy Pipeline 执行成功；此证据不等于供应商、Callback、设备物理或业务验收'
        }
        failure {
            echo '❌ Test Deploy Pipeline 执行失败'
        }
    }
}
