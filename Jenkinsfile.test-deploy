pipeline {
    agent {
        label 'WES'
    }

    parameters {
        string(name: 'BACKEND_IMAGE_TAG', description: '已批准的后端不可变镜像标签（构建号-commit 前 7 位）')
        string(name: 'FRONTEND_IMAGE_TAG', description: '已批准的前端不可变镜像标签（构建号-commit 前 7 位）')
        string(name: 'BACKEND_COMMIT_SHA', description: '后端镜像必须携带的完整 revision')
        string(name: 'DEPLOY_SOURCE_COMMIT_SHA', description: '部署 Compose/脚本必须固定到的后端完整 commit SHA')
        string(name: 'FRONTEND_COMMIT_SHA', description: '前端镜像必须携带的完整 revision')
        string(name: 'OPENAPI_SHA256', description: '前端镜像必须携带的冻结 OpenAPI SHA-256')
        string(name: 'PERMISSIONS_SHA256', description: '前端镜像必须携带的冻结权限 SHA-256')
        string(name: 'SOURCE_BRANCH', defaultValue: 'develop', description: '用于同步部署仓库的源码分支')
    }

    environment {
        REGISTRY_URL = '192.168.0.220:5050'
        BACKEND_IMAGE_REPO = '192.168.0.220:5050/wes/wes_backend'
        FRONTEND_IMAGE_REPO = '192.168.0.220:5050/wes/wes_frontend'
        DEPLOY_PATH = '/opt/wes_backend'
        DEPLOY_ENV_FILE = '.env.test'
        DEPLOY_COMPOSE_FILE = 'docker-compose.test-deploy.yml'
        WMS_PROVIDER_PROFILE_HOST_FILE = '/etc/wes/wms-provider.yaml'
        HEALTH_CHECK_URL = 'http://127.0.0.1:8001/ready'
        IMAGE_PULL_RETRIES = '24'
    }

    options {
        buildDiscarder(logRotator(daysToKeepStr: '14', numToKeepStr: '20', artifactDaysToKeepStr: '7', artifactNumToKeepStr: '5'))
        timeout(time: 45, unit: 'MINUTES')
        skipDefaultCheckout(true)
        disableConcurrentBuilds(abortPrevious: false)
        timestamps()
    }

    stages {
        stage('Checkout Source') {
            steps {
                script {
                    String sourceBranch = env.gitlabSourceBranch ?: env.gitlabBranch ?: params.SOURCE_BRANCH ?: 'develop'
                    String targetBranch = env.gitlabTargetBranch ?: ''
                    String gitlabActionType = (env.gitlabActionType ?: env.GITLAB_OBJECT_KIND ?: '').trim().toUpperCase()
                    boolean hasMergeRequestId = ((env.gitlabMergeRequestId ?: '').trim()) as boolean
                    boolean isMergeRequest = gitlabActionType.contains('MERGE') || hasMergeRequestId

                    env.CI_SOURCE_BRANCH = sourceBranch
                    env.CI_TARGET_BRANCH = targetBranch
                    env.CI_EVENT_TYPE = gitlabActionType ?: 'MANUAL'
                    env.CI_IS_MERGE_REQUEST = isMergeRequest ? 'true' : 'false'

                    echo "📥 检出部署配置: source=${sourceBranch}, target=${targetBranch ?: '-'}, event=${env.CI_EVENT_TYPE}"

                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: "origin/${sourceBranch}"]],
                        userRemoteConfigs: [[
                            name: 'origin',
                            url: 'http://192.168.0.220:9080/wes/wes_backend.git',
                            credentialsId: 'gitlab-http-creds',
                            refspec: '+refs/heads/*:refs/remotes/origin/*'
                        ]],
                        extensions: [[$class: 'CleanBeforeCheckout']]
                    ])

                    String backendCommitSha = params.BACKEND_COMMIT_SHA?.trim()
                    String deploySourceCommitSha = params.DEPLOY_SOURCE_COMMIT_SHA?.trim()
                    String frontendCommitSha = params.FRONTEND_COMMIT_SHA?.trim()
                    String openApiSha256 = params.OPENAPI_SHA256?.trim()
                    String permissionsSha256 = params.PERMISSIONS_SHA256?.trim()
                    String backendImageTag = params.BACKEND_IMAGE_TAG?.trim()
                    String frontendImageTag = params.FRONTEND_IMAGE_TAG?.trim()
                    if (!(backendCommitSha ==~ /[0-9a-f]{40}/)) {
                        error('BACKEND_COMMIT_SHA 必须是 40 位小写 commit SHA')
                    }
                    if (!(deploySourceCommitSha ==~ /[0-9a-f]{40}/)) {
                        error('DEPLOY_SOURCE_COMMIT_SHA 必须是 40 位小写 commit SHA')
                    }
                    if (deploySourceCommitSha != backendCommitSha) {
                        error('DEPLOY_SOURCE_COMMIT_SHA 必须与批准的后端镜像 revision 完全一致')
                    }
                    if (!(frontendCommitSha ==~ /[0-9a-f]{40}/)) {
                        error('FRONTEND_COMMIT_SHA 必须是 40 位小写 commit SHA')
                    }
                    if (!(openApiSha256 ==~ /[0-9a-f]{64}/)) {
                        error('OPENAPI_SHA256 必须是 64 位小写 SHA-256')
                    }
                    if (!(permissionsSha256 ==~ /[0-9a-f]{64}/)) {
                        error('PERMISSIONS_SHA256 必须是 64 位小写 SHA-256')
                    }
                    if (!(backendImageTag ==~ /[0-9]+-${backendCommitSha.take(7)}/)) {
                        error('BACKEND_IMAGE_TAG 与批准的后端 commit 不一致')
                    }
                    if (!(frontendImageTag ==~ /[0-9]+-${frontendCommitSha.take(7)}/)) {
                        error('FRONTEND_IMAGE_TAG 与批准的前端 commit 不一致')
                    }

                    sh "git reset --hard '${deploySourceCommitSha}'"
                    String fullCommit = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
                    if (fullCommit != deploySourceCommitSha) {
                        error('部署仓库未能固定到 DEPLOY_SOURCE_COMMIT_SHA')
                    }
                    String branchTag = sourceBranch.replaceAll(/[^A-Za-z0-9_.-]+/, '-')

                    env.CI_COMMIT_SHA = fullCommit
                    env.DEPLOY_SOURCE_COMMIT_SHA = deploySourceCommitSha
                    env.EXPECTED_BACKEND_COMMIT_SHA = backendCommitSha
                    env.EXPECTED_FRONTEND_COMMIT_SHA = frontendCommitSha
                    env.EXPECTED_OPENAPI_SHA256 = openApiSha256
                    env.EXPECTED_PERMISSIONS_SHA256 = permissionsSha256
                    env.CI_BRANCH_TAG = branchTag
                    env.DEPLOY_BACKEND_TAG = backendImageTag
                    env.DEPLOY_FRONTEND_TAG = frontendImageTag
                    env.DEPLOY_BACKEND_IMAGE = "${env.BACKEND_IMAGE_REPO}:${env.DEPLOY_BACKEND_TAG}"
                    env.DEPLOY_FRONTEND_IMAGE = "${env.FRONTEND_IMAGE_REPO}:${env.DEPLOY_FRONTEND_TAG}"

                    echo "🚀 后端镜像: ${env.DEPLOY_BACKEND_IMAGE}"
                    echo "🚀 前端镜像: ${env.DEPLOY_FRONTEND_IMAGE}"
                    echo "🔒 部署源码提交: ${env.CI_COMMIT_SHA}"
                }
            }
        }

        stage('Deploy Test Environment') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'gitlab-http-creds', usernameVariable: 'GITLAB_USER', passwordVariable: 'GITLAB_TOKEN')]) {
                    sh '''
                        set -e
                        set -o pipefail

                        cd "${DEPLOY_PATH}"

                        echo "📥 强制同步部署仓库到提交 ${DEPLOY_SOURCE_COMMIT_SHA}"
                        git fetch origin
                        git reset --hard "${DEPLOY_SOURCE_COMMIT_SHA}"
                        DEPLOY_ACTUAL_COMMIT=$(git rev-parse HEAD)
                        if [ "${DEPLOY_ACTUAL_COMMIT}" != "${DEPLOY_SOURCE_COMMIT_SHA}" ]; then
                            echo "❌ 部署仓库 revision 未固定到批准提交: ${DEPLOY_ACTUAL_COMMIT}"
                            exit 1
                        fi
                        git clean -fd
                        cp -f "${DEPLOY_ENV_FILE}" .env

                        if [ -z "${WMS_PROVIDER_PROFILE_HOST_FILE:-}" ]; then
                            echo "❌ 未配置 WMS Provider profile 宿主机路径"
                            exit 1
                        fi
                        if [ ! -f "${WMS_PROVIDER_PROFILE_HOST_FILE}" ]; then
                            echo "❌ WMS Provider profile 不是普通文件: ${WMS_PROVIDER_PROFILE_HOST_FILE}"
                            exit 1
                        fi
                        if [ ! -r "${WMS_PROVIDER_PROFILE_HOST_FILE}" ]; then
                            echo "❌ WMS Provider profile 当前用户不可读: ${WMS_PROVIDER_PROFILE_HOST_FILE}"
                            exit 1
                        fi

                        export REGISTRY_URL="${REGISTRY_URL}"
                        export WMS_PROVIDER_PROFILE_HOST_FILE="${WMS_PROVIDER_PROFILE_HOST_FILE}"
                        sh ./docker/test/registry-login.sh

                        export BACKEND_IMAGE="${DEPLOY_BACKEND_IMAGE}"
                        export FRONTEND_IMAGE="${DEPLOY_FRONTEND_IMAGE}"

                        wait_for_image() {
                            image_ref="$1"
                            retries="$2"
                            attempt=1

                            while [ "$attempt" -le "$retries" ]; do
                                if docker pull "$image_ref" >/dev/null 2>&1; then
                                    echo "✅ 镜像已就绪: $image_ref"
                                    return 0
                                fi

                                echo "⏳ 等待镜像入库: $image_ref (${attempt}/${retries})"
                                attempt=$((attempt + 1))
                                sleep 5
                            done

                            echo "❌ 镜像未就绪: $image_ref"
                            return 1
                        }

                        wait_for_image "${BACKEND_IMAGE}" "${IMAGE_PULL_RETRIES}"
                        wait_for_image "${FRONTEND_IMAGE}" "${IMAGE_PULL_RETRIES}"

                        BACKEND_IMAGE=$(docker image inspect \
                            --format '{{ index .RepoDigests 0 }}' "${BACKEND_IMAGE}")
                        FRONTEND_IMAGE=$(docker image inspect \
                            --format '{{ index .RepoDigests 0 }}' "${FRONTEND_IMAGE}")
                        case "${BACKEND_IMAGE}" in
                            *@sha256:*) ;;
                            *)
                                echo "❌ 无法将后端镜像固定到不可变 digest"
                                exit 1
                                ;;
                        esac
                        case "${FRONTEND_IMAGE}" in
                            *@sha256:*) ;;
                            *)
                                echo "❌ 无法将前端镜像固定到不可变 digest"
                                exit 1
                                ;;
                        esac
                        export BACKEND_IMAGE FRONTEND_IMAGE
                        echo "🔒 已固定后端镜像: ${BACKEND_IMAGE}"
                        echo "🔒 已固定前端镜像: ${FRONTEND_IMAGE}"

                        # TEST_DEPLOY_CUTOVER_BEGIN
                        compose() {
                            docker compose \
                                --env-file "${DEPLOY_ENV_FILE}" \
                                -f "${DEPLOY_COMPOSE_FILE}" \
                                "$@"
                        }

                        MAINTENANCE_MODE=false
                        CUTOVER_STAGE=image-provenance
                        keep_external_entrypoint_closed() {
                            if [ "${MAINTENANCE_MODE}" = "true" ]; then
                                echo "❌ 发布在阶段 ${CUTOVER_STAGE} 失败；外部入口保持关闭"
                                compose stop nginx >/dev/null 2>&1 || true
                            fi
                        }
                        fail_cutover() {
                            CUTOVER_STAGE="$1"
                            echo "❌ 发布在阶段 ${CUTOVER_STAGE} 失败；立即关闭外部入口"
                            compose stop nginx >/dev/null 2>&1 || true
                            exit 1
                        }
                        trap keep_external_entrypoint_closed EXIT

                        if ! BACKEND_REVISION=$(docker image inspect --format \
                            '{{ index .Config.Labels "org.opencontainers.image.revision" }}' "${BACKEND_IMAGE}"); then
                            fail_cutover backend-image-revision
                        fi
                        if [ "${BACKEND_REVISION}" != "${EXPECTED_BACKEND_COMMIT_SHA}" ]; then
                            echo "❌ 后端镜像 revision 与批准提交不一致: ${BACKEND_REVISION:-<empty>}"
                            fail_cutover backend-image-revision
                        fi
                        if ! FRONTEND_REVISION=$(docker image inspect --format \
                            '{{ index .Config.Labels "org.opencontainers.image.revision" }}' "${FRONTEND_IMAGE}"); then
                            fail_cutover frontend-image-revision
                        fi
                        if [ "${FRONTEND_REVISION}" != "${EXPECTED_FRONTEND_COMMIT_SHA}" ]; then
                            echo "❌ 前端镜像 revision 与批准提交不一致: ${FRONTEND_REVISION:-<empty>}"
                            fail_cutover frontend-image-revision
                        fi
                        if ! FRONTEND_BACKEND_REVISION=$(docker image inspect --format \
                            '{{ index .Config.Labels "com.zontec.wes.backend-contract-revision" }}' "${FRONTEND_IMAGE}"); then
                            fail_cutover frontend-backend-provenance
                        fi
                        if [ "${FRONTEND_BACKEND_REVISION}" != "${EXPECTED_BACKEND_COMMIT_SHA}" ]; then
                            echo "❌ 前端契约绑定的后端 revision 不一致: ${FRONTEND_BACKEND_REVISION:-<empty>}"
                            fail_cutover frontend-backend-provenance
                        fi
                        if ! FRONTEND_OPENAPI_SHA256=$(docker image inspect --format \
                            '{{ index .Config.Labels "com.zontec.wes.openapi-sha256" }}' "${FRONTEND_IMAGE}"); then
                            fail_cutover openapi-provenance
                        fi
                        if [ "${FRONTEND_OPENAPI_SHA256}" != "${EXPECTED_OPENAPI_SHA256}" ]; then
                            echo "❌ 前端镜像 OpenAPI provenance 不一致: ${FRONTEND_OPENAPI_SHA256:-<empty>}"
                            fail_cutover openapi-provenance
                        fi
                        if ! FRONTEND_PERMISSIONS_SHA256=$(docker image inspect --format \
                            '{{ index .Config.Labels "com.zontec.wes.permissions-sha256" }}' "${FRONTEND_IMAGE}"); then
                            fail_cutover permission-provenance
                        fi
                        if [ "${FRONTEND_PERMISSIONS_SHA256}" != "${EXPECTED_PERMISSIONS_SHA256}" ]; then
                            echo "❌ 前端镜像 permission provenance 不一致: ${FRONTEND_PERMISSIONS_SHA256:-<empty>}"
                            fail_cutover permission-provenance
                        fi

                        echo "📄 从前端镜像提取菜单清单..."
                        MANIFEST_DIR="${WORKSPACE}/.ci-artifacts/frontend"
                        MANIFEST_FILE="${MANIFEST_DIR}/menu-manifest.json"
                        mkdir -p "${MANIFEST_DIR}"
                        docker rm -f frontend-manifest-extract >/dev/null 2>&1 || true
                        docker create --name frontend-manifest-extract "${FRONTEND_IMAGE}" >/dev/null
                        docker cp frontend-manifest-extract:/opt/wes/menu-manifest.json "${MANIFEST_FILE}"
                        docker rm -f frontend-manifest-extract >/dev/null 2>&1 || true

                        if [ ! -s "${MANIFEST_FILE}" ]; then
                            echo "❌ 未能从前端镜像提取菜单清单"
                            exit 1
                        fi

                        NGINX_PORT=$(grep -E '^NGINX_HTTP_PORT=' "${DEPLOY_ENV_FILE}" | tail -n 1 | cut -d= -f2)
                        NGINX_PORT=${NGINX_PORT:-8080}

                        case "${BUILD_NUMBER:-}" in
                            ''|*[!0-9]*) fail_cutover fresh-database-name ;;
                        esac
                        SHORT_COMMIT=$(printf '%.12s' "${DEPLOY_SOURCE_COMMIT_SHA}")
                        POSTGRES_DB="wes_test_${BUILD_NUMBER}_${SHORT_COMMIT}"
                        case "${POSTGRES_DB}" in
                            *[!a-z0-9_]*) fail_cutover fresh-database-name ;;
                        esac
                        if [ "${#POSTGRES_DB}" -gt 63 ]; then
                            fail_cutover fresh-database-name
                        fi
                        export POSTGRES_DB

                        echo "🔒 进入维护态并停止旧应用容器"
                        CUTOVER_STAGE=maintenance
                        MAINTENANCE_MODE=true
                        if ! compose stop nginx; then
                            fail_cutover maintenance-stop
                        fi

                        CLOSE_RETRY=0
                        while curl -sS --connect-timeout 1 --max-time 2 \
                            "http://127.0.0.1:${NGINX_PORT}/" >/dev/null 2>&1; do
                            CLOSE_RETRY=$((CLOSE_RETRY + 1))
                            if [ "${CLOSE_RETRY}" -ge 10 ]; then
                                fail_cutover listener-closure
                            fi
                            sleep 1
                        done

                        compose_project_name=$(sed -n 's/^COMPOSE_PROJECT_NAME=//p' "${DEPLOY_ENV_FILE}" | tail -n 1)
                        compose_project_name=${compose_project_name:-wes_backend_test}
                        if ! PROJECT_CONTAINER_IDS=$(docker ps -q \
                            --filter "label=com.docker.compose.project=${compose_project_name}"); then
                            fail_cutover service-discovery
                        fi
                        for container_id in ${PROJECT_CONTAINER_IDS}; do
                            if ! compose_service=$(docker inspect --format \
                                '{{ index .Config.Labels "com.docker.compose.service" }}' "${container_id}"); then
                                fail_cutover service-discovery
                            fi
                            case "${compose_service}" in
                                db|redis) ;;
                                api|celery|celery-wms-fulfillment|celery_beat|flower|frontend|nginx)
                                    if ! docker stop "${container_id}"; then
                                        fail_cutover application-stop
                                    fi
                                    ;;
                                *)
                                    echo "❌ 未知 Compose application service: ${compose_service:-<empty>}"
                                    fail_cutover unknown-service
                                    ;;
                            esac
                        done

                        if ! REMAINING_CONTAINER_IDS=$(docker ps -q \
                            --filter "label=com.docker.compose.project=${compose_project_name}"); then
                            fail_cutover remaining-service-discovery
                        fi
                        for container_id in ${REMAINING_CONTAINER_IDS}; do
                            if ! compose_service=$(docker inspect --format \
                                '{{ index .Config.Labels "com.docker.compose.service" }}' "${container_id}"); then
                                fail_cutover remaining-service-discovery
                            fi
                            case "${compose_service}" in
                                db|redis) ;;
                                *)
                                    echo "❌ 迁移前仍有未知 Compose application service: ${compose_service:-<empty>}"
                                    fail_cutover remaining-application-service
                                    ;;
                            esac
                        done

                        CUTOVER_STAGE=infrastructure-start
                        if ! compose up -d db redis; then
                            fail_cutover infrastructure-start
                        fi
                        INFRA_RETRY=0
                        until compose exec -T db sh -eu -c \
                            'pg_isready -U "$POSTGRES_USER" -d postgres' >/dev/null 2>&1 \
                            && compose exec -T redis sh -eu -c \
                                'redis-cli -a "$REDIS_PASSWORD" ping | grep -qx PONG' >/dev/null 2>&1; do
                            INFRA_RETRY=$((INFRA_RETRY + 1))
                            if [ "${INFRA_RETRY}" -ge 30 ]; then
                                fail_cutover infrastructure-readiness
                            fi
                            sleep 1
                        done

                        CUTOVER_STAGE=fresh-database
                        if ! compose exec -T db sh -eu -c \
                            'createdb -U "$POSTGRES_USER" "$POSTGRES_DB"'; then
                            fail_cutover fresh-database
                        fi
                        if ! FRESH_TABLE_COUNT=$(compose exec -T db sh -eu -c \
                            'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -tAc "select count(*) from pg_catalog.pg_tables where schemaname not in (\$\$pg_catalog\$\$,\$\$information_schema\$\$)"'); then
                            fail_cutover fresh-database-proof
                        fi
                        FRESH_TABLE_COUNT=$(printf '%s' "${FRESH_TABLE_COUNT}" | tr -d '[:space:]')
                        if [ "${FRESH_TABLE_COUNT}" != "0" ]; then
                            fail_cutover fresh-database-proof
                        fi

                        echo "🗄️ 执行数据库迁移"
                        CUTOVER_STAGE=migration
                        if ! compose run --rm --no-deps \
                            -e DATABASE_RUNTIME_ROLE=cli \
                            -e DATABASE_POOL_SIZE=1 \
                            -e DATABASE_MAX_OVERFLOW=0 \
                            --entrypoint /opt/venv/bin/alembic \
                            api upgrade head; then
                            fail_cutover migration
                        fi

                        echo "🔐 执行 fresh DB 基础授权初始化"
                        CUTOVER_STAGE=authorization-bootstrap
                        if BOOTSTRAP_OUTPUT=$(compose run --rm --no-deps \
                            -e DATABASE_RUNTIME_ROLE=cli \
                            -e DATABASE_POOL_SIZE=1 \
                            -e DATABASE_MAX_OVERFLOW=0 \
                            --entrypoint /bin/bash \
                            api scripts/data/bootstrap_foundation.sh 2>&1); then
                            printf '%s\n' "${BOOTSTRAP_OUTPUT}"
                        else
                            BOOTSTRAP_STATUS=$?
                            printf '%s\n' "${BOOTSTRAP_OUTPUT}"
                            if ! printf '%s\n' "${BOOTSTRAP_OUTPUT}" \
                                | grep -Fxq 'DATABASE_COMMITTED_CACHE_INVALIDATION_FAILED'; then
                                echo "❌ bootstrap 失败且未返回精确 postcommit marker（status=${BOOTSTRAP_STATUS}）"
                                fail_cutover authorization-bootstrap
                            fi

                            echo "🧹 数据库已提交但精确缓存失效失败；仅修复权限缓存命名空间"
                            CUTOVER_STAGE=authorization-cache-repair
                            if ! compose run --rm --no-deps \
                                --entrypoint /opt/venv/bin/python \
                                api scripts/data/sync_permissions.py --repair-cache; then
                                fail_cutover authorization-cache-repair
                            fi
                        fi

                        echo "🔎 校验权限目录零漂移"
                        CUTOVER_STAGE=authorization-check
                        if ! compose run --rm --no-deps \
                            -e DATABASE_RUNTIME_ROLE=cli \
                            -e DATABASE_POOL_SIZE=1 \
                            -e DATABASE_MAX_OVERFLOW=0 \
                            --entrypoint /opt/venv/bin/python \
                            api scripts/data/sync_permissions.py --check; then
                            fail_cutover authorization-check
                        fi

                        echo "🐳 启动已固定版本的应用服务"
                        CUTOVER_STAGE=application-start
                        if ! compose up -d --force-recreate --wait \
                            api celery celery-wms-fulfillment celery_beat flower frontend; then
                            fail_cutover application-start
                        fi

                        CUTOVER_STAGE=internal-readiness
                        if ! compose exec -T api curl -fsS "${HEALTH_CHECK_URL}" >/dev/null; then
                            fail_cutover backend-readiness
                        fi
                        if ! compose exec -T frontend wget --no-verbose --tries=1 --spider \
                            http://127.0.0.1:5173/ >/dev/null; then
                            fail_cutover frontend-asset
                        fi

                        echo "🧭 同步 TEST 环境菜单..."
                        CUTOVER_STAGE=menu-sync
                        if ! API_CONTAINER_ID=$(compose ps -q api); then
                            fail_cutover menu-sync
                        fi

                        if [ -z "${API_CONTAINER_ID}" ]; then
                            echo "❌ 未找到 API 容器，无法同步菜单"
                            fail_cutover menu-sync
                        fi

                        if ! docker cp "${MANIFEST_FILE}" "${API_CONTAINER_ID}:/tmp/menu-manifest.json"; then
                            fail_cutover menu-sync
                        fi
                        if ! compose exec -T api \
                            /opt/venv/bin/python scripts/data/sync_menus.py --manifest-path /tmp/menu-manifest.json; then
                            fail_cutover menu-sync
                        fi

                        if ! MENU_COUNT=$(compose exec -T db \
                            sh -lc 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -tAc "select count(*) from wes_sys.menus"'); then
                            fail_cutover menu-check
                        fi
                        MENU_COUNT=$(echo "${MENU_COUNT}" | tr -d '[:space:]')

                        if [ -z "${MENU_COUNT}" ] || [ "${MENU_COUNT}" -le 0 ]; then
                            echo "❌ TEST 环境菜单同步后数量异常: ${MENU_COUNT:-<empty>}"
                            fail_cutover menu-check
                        fi

                        echo "✅ TEST 环境菜单数量: ${MENU_COUNT}"

                        echo "🌐 恢复外部入口"
                        CUTOVER_STAGE=external-entrypoint
                        if ! compose up -d --no-deps nginx; then
                            fail_cutover external-entrypoint
                        fi
                        wait_for_http() {
                            url="$1"
                            attempt=1
                            while [ "${attempt}" -le 10 ]; do
                                if curl -fsS --connect-timeout 1 --max-time 2 "${url}" >/dev/null; then
                                    return 0
                                fi
                                attempt=$((attempt + 1))
                                sleep 1
                            done
                            return 1
                        }
                        if ! wait_for_http "http://127.0.0.1:${NGINX_PORT}/health"; then
                            fail_cutover external-health
                        fi
                        if ! wait_for_http "http://127.0.0.1:${NGINX_PORT}/"; then
                            fail_cutover external-frontend
                        fi
                        if ! compose ps; then
                            fail_cutover final-compose-status
                        fi

                        CUTOVER_STAGE=complete
                        MAINTENANCE_MODE=false
                        # TEST_DEPLOY_CUTOVER_END
                    '''
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo '✅ Test Deploy Pipeline 执行成功'
        }
        failure {
            echo '❌ Test Deploy Pipeline 执行失败'
        }
    }
}
