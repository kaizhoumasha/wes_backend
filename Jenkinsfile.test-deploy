pipeline {
    agent {
        label 'WES'
    }

    parameters {
        string(name: 'BACKEND_IMAGE_TAG', defaultValue: '', description: '后端镜像标签，留空时默认使用分支别名')
        string(name: 'FRONTEND_IMAGE_TAG', defaultValue: 'develop', description: '前端镜像标签，默认使用 develop')
        string(name: 'SOURCE_BRANCH', defaultValue: 'develop', description: '用于同步部署仓库的源码分支')
        string(name: 'SOURCE_COMMIT_SHA', defaultValue: '', description: '可选：部署仓库要固定到的提交 SHA')
    }

    environment {
        REGISTRY_URL = '192.168.0.220:5050'
        BACKEND_IMAGE_REPO = '192.168.0.220:5050/wes/wes_backend'
        FRONTEND_IMAGE_REPO = '192.168.0.220:5050/wes/wes_frontend'
        DEPLOY_PATH = '/opt/wes_backend'
        DEPLOY_ENV_FILE = '.env.test'
        DEPLOY_COMPOSE_FILE = 'docker-compose.test-deploy.yml'
        WMS_PROVIDER_PROFILE_HOST_FILE = '/etc/wes/wms-provider.yaml'
        HEALTH_CHECK_URL = 'http://127.0.0.1:8001/health'
        HEALTH_CHECK_RETRIES = '36'
        IMAGE_PULL_RETRIES = '24'
    }

    options {
        buildDiscarder(logRotator(daysToKeepStr: '14', numToKeepStr: '20', artifactDaysToKeepStr: '7', artifactNumToKeepStr: '5'))
        timeout(time: 45, unit: 'MINUTES')
        skipDefaultCheckout(true)
        disableConcurrentBuilds(abortPrevious: false)
        timestamps()
    }

    stages {
        stage('Checkout Source') {
            steps {
                script {
                    String sourceBranch = env.gitlabSourceBranch ?: env.gitlabBranch ?: params.SOURCE_BRANCH ?: 'develop'
                    String targetBranch = env.gitlabTargetBranch ?: ''
                    String gitlabActionType = (env.gitlabActionType ?: env.GITLAB_OBJECT_KIND ?: '').trim().toUpperCase()
                    boolean hasMergeRequestId = ((env.gitlabMergeRequestId ?: '').trim()) as boolean
                    boolean isMergeRequest = gitlabActionType.contains('MERGE') || hasMergeRequestId

                    env.CI_SOURCE_BRANCH = sourceBranch
                    env.CI_TARGET_BRANCH = targetBranch
                    env.CI_EVENT_TYPE = gitlabActionType ?: 'MANUAL'
                    env.CI_IS_MERGE_REQUEST = isMergeRequest ? 'true' : 'false'

                    echo "📥 检出部署配置: source=${sourceBranch}, target=${targetBranch ?: '-'}, event=${env.CI_EVENT_TYPE}"

                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: "origin/${sourceBranch}"]],
                        userRemoteConfigs: [[
                            name: 'origin',
                            url: 'http://192.168.0.220:9080/wes/wes_backend.git',
                            credentialsId: 'gitlab-http-creds',
                            refspec: '+refs/heads/*:refs/remotes/origin/*'
                        ]],
                        extensions: [[$class: 'CleanBeforeCheckout']]
                    ])

                    String fullCommit = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
                    String branchTag = sourceBranch.replaceAll(/[^A-Za-z0-9_.-]+/, '-')
                    String channelTag = branchTag

                    switch (sourceBranch) {
                        case 'develop':
                            channelTag = 'develop'
                            break
                        case 'main':
                            channelTag = 'prod'
                            break
                    }

                    env.CI_COMMIT_SHA = params.SOURCE_COMMIT_SHA?.trim() ? params.SOURCE_COMMIT_SHA.trim() : fullCommit
                    env.CI_BRANCH_TAG = branchTag
                    env.DEPLOY_BACKEND_TAG = params.BACKEND_IMAGE_TAG?.trim() ? params.BACKEND_IMAGE_TAG.trim() : channelTag
                    env.DEPLOY_FRONTEND_TAG = params.FRONTEND_IMAGE_TAG?.trim() ? params.FRONTEND_IMAGE_TAG.trim() : 'develop'
                    env.DEPLOY_BACKEND_IMAGE = "${env.BACKEND_IMAGE_REPO}:${env.DEPLOY_BACKEND_TAG}"
                    env.DEPLOY_FRONTEND_IMAGE = "${env.FRONTEND_IMAGE_REPO}:${env.DEPLOY_FRONTEND_TAG}"

                    echo "🚀 后端镜像: ${env.DEPLOY_BACKEND_IMAGE}"
                    echo "🚀 前端镜像: ${env.DEPLOY_FRONTEND_IMAGE}"
                    echo "🔒 部署源码提交: ${env.CI_COMMIT_SHA}"
                }
            }
        }

        stage('Deploy Test Environment') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'gitlab-http-creds', usernameVariable: 'GITLAB_USER', passwordVariable: 'GITLAB_TOKEN')]) {
                    sh '''
                        set -e
                        set -o pipefail

                        cd "${DEPLOY_PATH}"

                        echo "📥 强制同步部署仓库到提交 ${CI_COMMIT_SHA}"
                        git fetch origin
                        git reset --hard "${CI_COMMIT_SHA}"
                        git clean -fd
                        cp -f "${DEPLOY_ENV_FILE}" .env

                        if [ -z "${WMS_PROVIDER_PROFILE_HOST_FILE:-}" ]; then
                            echo "❌ 未配置 WMS Provider profile 宿主机路径"
                            exit 1
                        fi
                        if [ ! -f "${WMS_PROVIDER_PROFILE_HOST_FILE}" ]; then
                            echo "❌ WMS Provider profile 不是普通文件: ${WMS_PROVIDER_PROFILE_HOST_FILE}"
                            exit 1
                        fi
                        if [ ! -r "${WMS_PROVIDER_PROFILE_HOST_FILE}" ]; then
                            echo "❌ WMS Provider profile 当前用户不可读: ${WMS_PROVIDER_PROFILE_HOST_FILE}"
                            exit 1
                        fi

                        export REGISTRY_URL="${REGISTRY_URL}"
                        export WMS_PROVIDER_PROFILE_HOST_FILE="${WMS_PROVIDER_PROFILE_HOST_FILE}"
                        sh ./docker/test/registry-login.sh

                        export BACKEND_IMAGE="${DEPLOY_BACKEND_IMAGE}"
                        export FRONTEND_IMAGE="${DEPLOY_FRONTEND_IMAGE}"

                        echo "🐳 启动基础设施..."
                        docker compose \
                            --env-file "${DEPLOY_ENV_FILE}" \
                            -f "${DEPLOY_COMPOSE_FILE}" \
                            up -d db redis

                        wait_for_image() {
                            image_ref="$1"
                            retries="$2"
                            attempt=1

                            while [ "$attempt" -le "$retries" ]; do
                                if docker pull "$image_ref" >/dev/null 2>&1; then
                                    echo "✅ 镜像已就绪: $image_ref"
                                    return 0
                                fi

                                echo "⏳ 等待镜像入库: $image_ref (${attempt}/${retries})"
                                attempt=$((attempt + 1))
                                sleep 5
                            done

                            echo "❌ 镜像未就绪: $image_ref"
                            return 1
                        }

                        wait_for_image "${BACKEND_IMAGE}" "${IMAGE_PULL_RETRIES}"
                        wait_for_image "${FRONTEND_IMAGE}" "${IMAGE_PULL_RETRIES}"

                        echo "🐳 拉取应用镜像..."
                        docker compose \
                            --env-file "${DEPLOY_ENV_FILE}" \
                            -f "${DEPLOY_COMPOSE_FILE}" \
                            pull api celery celery-wms-fulfillment frontend

                        echo "📄 从前端镜像提取菜单清单..."
                        MANIFEST_DIR="${WORKSPACE}/.ci-artifacts/frontend"
                        MANIFEST_FILE="${MANIFEST_DIR}/menu-manifest.json"
                        mkdir -p "${MANIFEST_DIR}"
                        docker rm -f frontend-manifest-extract >/dev/null 2>&1 || true
                        docker create --name frontend-manifest-extract "${FRONTEND_IMAGE}" >/dev/null
                        docker cp frontend-manifest-extract:/opt/wes/menu-manifest.json "${MANIFEST_FILE}"
                        docker rm -f frontend-manifest-extract >/dev/null 2>&1 || true

                        if [ ! -s "${MANIFEST_FILE}" ]; then
                            echo "❌ 未能从前端镜像提取菜单清单"
                            exit 1
                        fi

                        echo "🐳 重建测试应用..."
                        docker compose \
                            --env-file "${DEPLOY_ENV_FILE}" \
                            -f "${DEPLOY_COMPOSE_FILE}" \
                            up -d --force-recreate api celery celery-wms-fulfillment frontend nginx

                        NGINX_PORT=$(grep -E '^NGINX_HTTP_PORT=' "${DEPLOY_ENV_FILE}" | tail -n 1 | cut -d= -f2)
                        NGINX_PORT=${NGINX_PORT:-8080}

                        RETRY_COUNT=0
                        HEALTH_CHECK_PASSED=false

                        while [ "$RETRY_COUNT" -lt "${HEALTH_CHECK_RETRIES}" ]; do
                            if docker compose \
                                --env-file "${DEPLOY_ENV_FILE}" \
                                -f "${DEPLOY_COMPOSE_FILE}" \
                                exec -T api curl -fsS "${HEALTH_CHECK_URL}" >/dev/null \
                                && curl -fsS "http://localhost:${NGINX_PORT}/health" >/dev/null \
                                && curl -fsS "http://localhost:${NGINX_PORT}/" >/dev/null; then
                                echo "✅ TEST 环境健康检查通过"
                                HEALTH_CHECK_PASSED=true
                                break
                            fi

                            RETRY_COUNT=$((RETRY_COUNT + 1))
                            echo "⏳ 等待容器就绪... ${RETRY_COUNT}/${HEALTH_CHECK_RETRIES}"
                            sleep 5
                        done

                        if [ "${HEALTH_CHECK_PASSED}" != "true" ]; then
                            echo "❌ TEST 环境健康检查失败"
                            docker compose \
                                --env-file "${DEPLOY_ENV_FILE}" \
                                -f "${DEPLOY_COMPOSE_FILE}" \
                                logs --tail=150 api celery celery-wms-fulfillment frontend nginx
                            exit 1
                        fi

                        echo "🔐 同步 TEST 环境权限..."
                        docker compose \
                            --env-file "${DEPLOY_ENV_FILE}" \
                            -f "${DEPLOY_COMPOSE_FILE}" \
                            exec -T api \
                            /opt/venv/bin/python scripts/data/sync_permissions.py --apply

                        PERMISSION_COUNT=$(docker compose \
                            --env-file "${DEPLOY_ENV_FILE}" \
                            -f "${DEPLOY_COMPOSE_FILE}" \
                            exec -T db \
                            sh -lc 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -tAc "select count(*) from wes_sys.permissions"')
                        PERMISSION_COUNT=$(echo "${PERMISSION_COUNT}" | tr -d '[:space:]')

                        if [ -z "${PERMISSION_COUNT}" ] || [ "${PERMISSION_COUNT}" -le 0 ]; then
                            echo "❌ TEST 环境权限同步后数量异常: ${PERMISSION_COUNT:-<empty>}"
                            exit 1
                        fi

                        echo "✅ TEST 环境权限数量: ${PERMISSION_COUNT}"

                        echo "🧭 同步 TEST 环境菜单..."
                        API_CONTAINER_ID=$(docker compose \
                            --env-file "${DEPLOY_ENV_FILE}" \
                            -f "${DEPLOY_COMPOSE_FILE}" \
                            ps -q api)

                        if [ -z "${API_CONTAINER_ID}" ]; then
                            echo "❌ 未找到 API 容器，无法同步菜单"
                            exit 1
                        fi

                        docker cp "${MANIFEST_FILE}" "${API_CONTAINER_ID}:/tmp/menu-manifest.json"
                        docker compose \
                            --env-file "${DEPLOY_ENV_FILE}" \
                            -f "${DEPLOY_COMPOSE_FILE}" \
                            exec -T api \
                            /opt/venv/bin/python scripts/data/sync_menus.py --manifest-path /tmp/menu-manifest.json

                        MENU_COUNT=$(docker compose \
                            --env-file "${DEPLOY_ENV_FILE}" \
                            -f "${DEPLOY_COMPOSE_FILE}" \
                            exec -T db \
                            sh -lc 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -tAc "select count(*) from wes_sys.menus"')
                        MENU_COUNT=$(echo "${MENU_COUNT}" | tr -d '[:space:]')

                        if [ -z "${MENU_COUNT}" ] || [ "${MENU_COUNT}" -le 0 ]; then
                            echo "❌ TEST 环境菜单同步后数量异常: ${MENU_COUNT:-<empty>}"
                            exit 1
                        fi

                        echo "✅ TEST 环境菜单数量: ${MENU_COUNT}"

                        docker compose \
                            --env-file "${DEPLOY_ENV_FILE}" \
                            -f "${DEPLOY_COMPOSE_FILE}" \
                            ps
                    '''
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo '✅ Test Deploy Pipeline 执行成功'
        }
        failure {
            echo '❌ Test Deploy Pipeline 执行失败'
        }
    }
}
