# ============================================
# 环境配置 - 开发环境
# ============================================
# 使用方式: docker-compose --profile dev --env-file .env.dev up -d

# 环境标识
ENV=dev
COMPOSE_PROJECT_NAME=wes_backend
PROJECT_NAME=P9 WES
VERSION=0.1.0
DESCRIPTION=英伟达休斯顿 P9 仓库自动化执行系统
DATETIME_FORMAT=%Y-%m-%d
DATETIME_TIMEZONE=Asia/Shanghai
API_PATH=/api

# 跳过 API 认证（仅开发环境使用）
SKIP_API_AUTH=true

# 可信反向代理 IP/CIDR；仅这些来源的 X-Forwarded-For/X-Real-IP 会被后端信任
# 示例: TRUSTED_PROXY_IPS=["10.0.0.10","192.168.0.0/16"]
TRUSTED_PROXY_IPS=[]

# ============================================
# 构建配置
# ============================================
BACKEND_ENV_FILE=.env.dev
BUILD_TARGET=development
RESTART_POLICY=unless-stopped

# ============================================
# 应用配置
# ============================================
APP_ENV=dev
APP_DEBUG=true
APP_PORT=8001
APP_HOST_PORT=8001

# ============================================
# 安全配置
# ============================================
# JWT 密钥（用于 Token 签名，长度 ≥ 32）
# ⚠️ 生产环境必须使用强随机密钥，不要使用默认值
JWT_SECRET_KEY=dev_jwt_token_placeholder_v1_x7q9k2m4n6p8r1t3

# API 加密密钥（用于敏感数据加密，Fernet 格式）
# ⚠️ 生产环境必须使用强随机密钥，不要使用默认值
# 生成方法: python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
API_SECRET_ENCRYPTION_KEY=BtQet-MCGipS654iX8xMuyh0cgNlg4KEsmUt9so_9zo=

# JWT Token 过期时间（秒）
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=86400

# ============================================
# 数据库配置
# ============================================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_USER=wes_user
POSTGRES_PASSWORD=5oLnQuARGsLRG2CD_ynVcfUVAML6edo7cvDhxWk3n_M
POSTGRES_DB=wes_db
DATABASE_RUNTIME_ROLE=cli
DATABASE_POOL_SIZE=1
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT=30
DATABASE_APPLICATION_NAME=dev

# ============================================
# Redis 配置
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_PASSWORD=r8KxPpMnNmRsLRG2CD_ynVcfUVAML6edo

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=DEBUG
LOG_JSON_OUTPUT=false
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

# ============================================
# CORS 配置
# ============================================
# 开发环境启用 Cookie 凭证时，不能使用通配符 *
# 建议显式配置前端开发域名
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Cookie 策略（默认同站点）
# 如需跨站点 Cookie（不同站点部署），使用:
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true  # 必须同时启用 HTTPS
COOKIE_SAMESITE=lax

# ============================================
# API 服务配置
# ============================================
API_REPLICAS=1
API_CPU_LIMIT=2.0
API_MEMORY_LIMIT=2G
API_CPU_RESERVATION=0.5
API_MEMORY_RESERVATION=512M

# ============================================
# Celery 配置
# ============================================
CELERY_WORKER_REPLICAS=1
CELERY_LOG_LEVEL=INFO
CELERY_CONCURRENCY=2
CELERY_MAX_TASKS=1000
CELERY_CPU_LIMIT=2.0
CELERY_MEMORY_LIMIT=2G
CELERY_CPU_RESERVATION=0.5
CELERY_MEMORY_RESERVATION=512M

# ============================================
# Flower 监控配置
# ============================================
FLOWER_PORT=5555
FLOWER_USER=admin
FLOWER_PASSWORD=admin123
FLOWER_CPU_LIMIT=0.25
FLOWER_MEMORY_LIMIT=256M

# ============================================
# 测试配置
# ============================================
DB_WAIT_TIME=5
LOCUST_PORT=8089
LOCUST_TARGET_HOST=http://api:8001
LOCUST_REPORT_PATH=reports/locust/report.html

# ============================================
# 开发环境特有配置
# ============================================
# 挂载源码 (热重载)
SOURCE_MOUNT=./src

# PostgreSQL 配置文件 (开发环境日志降噪)
POSTGRES_CONFIG_FILE=./postgresql/dev.conf
POSTGRES_COMMAND=postgres -c config_file=/etc/postgresql/postgresql.conf

# Redis 配置文件 (开发环境稳定优先)
REDIS_CONFIG_FILE=./redis/dev.conf
REDIS_COMMAND=redis-server /usr/local/etc/redis/redis.conf

# 备份目录
BACKUP_DIR=./backups

# 日志目录
# (通过 volumes 挂载，无需配置)

# SSL 证书目录 (生产环境使用)
# NGINX_SSL_DIR=./nginx/ssl

# ============================================
# Mock 服务配置（本地开发）
# ============================================
# WMS Mock 服务（Docker 容器内使用服务名，init-env.sh 会为宿主机 .env 转换为 localhost）
CONTAINER_WMS_SYNC_BASE_URL=http://mock_wms:8011/api/wms
CONTAINER_WMS_RCS_RACK_OPERATION_URL=http://mock_wms:8011/api/wms/rack-operation
WMS_SYNC_BASE_URL=http://mock_wms:8011/api/wms
WMS_RCS_RACK_OPERATION_URL=http://mock_wms:8011/api/wms/rack-operation
# 仅供本地 mock 使用，不得复制到 staging/production。
WMS_MATERIAL_FLOW_SANDBOX_HMAC_SECRET_V1=local_mock_material_flow_hmac_v1

# WES 回调地址（compose 开发网络内使用 api 服务名；生成宿主机 .env 时转换为 localhost）
CONTAINER_WES_EXTERNAL_CALLBACK_URL=http://api:8001/api/v1/callback/external
WES_EVENT_CALLBACK_URL=http://api:8001/api/v1/callback/event
WES_RESULT_CALLBACK_URL=http://api:8001/api/v1/callback/result
WES_EXTERNAL_CALLBACK_URL=http://api:8001/api/v1/callback/external

# Mock 服务端口
MOCK_ECS_HOST=mock_ecs
MOCK_ECS_PORT=8010

# ============================================
# 前端容器配置 (docker-compose.frontend.yml)
# ============================================
FRONTEND_ROOT=../wes_frontend
FRONTEND_ENV_FILE=.env.frontend.dev
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
