# ============================================
# 环境配置 - 测试环境
# ============================================
# 使用方式: docker-compose --profile test --env-file .env.test up -d

# 环境标识
ENV=test
COMPOSE_PROJECT_NAME=wes_backend_test
PROJECT_NAME=P9 WES
VERSION=0.1.0
DESCRIPTION=英伟达休斯顿 P9 仓库自动化执行系统
DATETIME_FORMAT=%Y-%m-%d
DATETIME_TIMEZONE=Asia/Shanghai
API_PATH=/api

# ============================================
# 构建配置
# ============================================
BACKEND_ENV_FILE=.env.test
BUILD_TARGET=development
RESTART_POLICY=no

# ============================================
# 应用配置
# ============================================
APP_ENV=test
APP_DEBUG=true
APP_PORT=8001
APP_HOST_PORT=8002

# ============================================
# 安全配置
# ============================================
# 可信反向代理 IP/CIDR；仅这些来源的 X-Forwarded-For/X-Real-IP 会被后端信任
TRUSTED_PROXY_IPS=[]

# JWT 密钥（用于 Token 签名，长度 ≥ 32）
# ⚠️ 生产环境必须使用强随机密钥，不要使用默认值
JWT_SECRET_KEY=vT3L9qP7mR2xN8cK4sJ6hB1wF5yD0uQ9eA7zX2nM4pR8kL1c

# API 加密密钥（用于敏感数据加密，Fernet 格式）
# ⚠️ 生产环境必须使用强随机密钥，不要使用默认值
# 生成方法: python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
API_SECRET_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# JWT Token 过期时间（秒）
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=86400

# ============================================
# 数据库配置 (使用独立数据库)
# ============================================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
POSTGRES_USER=wes_user
POSTGRES_PASSWORD=5oLnQuARGsLRG2CD_ynVcfUVAML6edo7cvDhxWk3n_M
POSTGRES_DB=wes_db_test
DATABASE_RUNTIME_ROLE=cli
DATABASE_POOL_SIZE=1
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT=30
DATABASE_APPLICATION_NAME=test

# ============================================
# Redis 配置 (使用独立 Redis)
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6380
REDIS_PASSWORD=r8KxPpMnNmRsLRG2CD_ynVcfUVAML6edo

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO
LOG_JSON_OUTPUT=true
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

# ============================================
# CORS 配置
# ============================================
# 测试环境配置具体 origin
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8080","http://127.0.0.1:5173","http://127.0.0.1:8080"]

# ============================================
# API 服务配置
# ============================================
API_REPLICAS=1
API_CPU_LIMIT=1.0
API_MEMORY_LIMIT=1G
API_CPU_RESERVATION=0.25
API_MEMORY_RESERVATION=256M

# ============================================
# Celery 配置
# ============================================
CELERY_WORKER_REPLICAS=1
CELERY_CONCURRENCY=2

# ============================================
# WMS Mock 配置 (E2E 测试)
# ============================================
CONTAINER_WMS_SYNC_BASE_URL=http://mock_wms:8011/api/wms
CONTAINER_WMS_EFFECT_STATUS_URL=http://mock_wms:8011/northbound/operations/status
CONTAINER_WMS_RCS_RACK_OPERATION_URL=http://mock_wms:8011/api/wms/rack-operation
CONTAINER_WMS_RCS_BIN_OPERATION_URL=http://mock_wms:8011/api/wms/transport-request
CONTAINER_WMS_RCS_FULL_BOX_EXCHANGE_URL=http://mock_wms:8011/api/wms/fulfillment/full-box-exchange
WMS_SYNC_BASE_URL=http://mock_wms:8011/api/wms
WMS_EFFECT_STATUS_URL=http://localhost:8011/northbound/operations/status
WMS_EFFECT_STATUS_TIMEOUT_SECONDS=2
WMS_EFFECT_STATUS_MAX_RESPONSE_BYTES=4096
WMS_EFFECT_IDEMPOTENCY_RETENTION_SECONDS=9
WMS_EFFECT_STATUS_VISIBILITY_SLA_SECONDS=2
WES_EFFECT_MAX_CONFIRMATION_AGE_SECONDS=6
WES_EFFECT_NOT_FOUND_GRACE_SECONDS=3
WES_EFFECT_STATUS_SAFETY_MARGIN_SECONDS=3
WES_EFFECT_STATUS_SCAN_BATCH_SIZE=50
WES_EFFECT_STATUS_CLAIM_LEASE_SECONDS=5
WES_EFFECT_STATUS_MAX_QUERY_ATTEMPTS=8
WES_EFFECT_STATUS_INITIAL_BACKOFF_SECONDS=1
WES_EFFECT_STATUS_MAX_BACKOFF_SECONDS=8
WMS_RCS_RACK_OPERATION_URL=http://localhost:8011/api/wms/rack-operation
WMS_RCS_BIN_OPERATION_URL=http://localhost:8011/api/wms/transport-request
WMS_RCS_FULL_BOX_EXCHANGE_URL=http://localhost:8011/api/wms/fulfillment/full-box-exchange
# 仅供自动化测试 mock 使用。
WMS_QUERY_IN_PROCESS_SIMULATION_ENABLED=true
MOCK_WMS_NORTHBOUND_HMAC_SECRET_V1=test_mock_northbound_hmac_v1
WMS_MATERIAL_FLOW_ACTIVE_HMAC_VERSION=v2
WMS_MATERIAL_FLOW_SANDBOX_HMAC_SECRET_V1=test_mock_material_flow_hmac_v1
WMS_MATERIAL_FLOW_SANDBOX_HMAC_SECRET_V2=test_mock_material_flow_hmac_v2
WMS_LEGACY_TRANSPORT_SANDBOX_HMAC_SECRET_V1=test_mock_legacy_transport_hmac_v1
WORKLINE_PLUGIN_RUNTIME_SANDBOX_HMAC_SECRET_V1=test_mock_plugin_runtime_hmac_v1
WES_REVOKED_EXTERNAL_HTTP_CREDENTIAL_REFERENCES=

# ============================================
# 测试配置
# ============================================
DB_WAIT_TIME=10
LOCUST_PORT=8089
LOCUST_TARGET_HOST=http://api:8001
LOCUST_REPORT_PATH=reports/locust/report.html

# ============================================
# 资源限制
# ============================================
POSTGRES_CONFIG_FILE=./postgresql/test.conf
POSTGRES_COMMAND=postgres -c config_file=/etc/postgresql/postgresql.conf

POSTGRES_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=2G
POSTGRES_CPU_RESERVATION=0.25
POSTGRES_MEMORY_RESERVATION=512M

REDIS_CPU_LIMIT=0.5
REDIS_MEMORY_LIMIT=1G
REDIS_CPU_RESERVATION=0.25
REDIS_MEMORY_RESERVATION=256M
REDIS_CONFIG_FILE=./redis/test.conf
REDIS_COMMAND=redis-server /usr/local/etc/redis/redis.conf

# ============================================
# Mock 服务配置 (E2E 测试)
# ============================================
# ECS Mock 服务
MOCK_ECS_HOST=mock_ecs
MOCK_ECS_PORT=8010
MOCK_ECS_URL=http://mock_ecs:8010
MOCK_CPU_LIMIT=0.25
MOCK_MEMORY_LIMIT=128M

# WES 结果回调地址（ECS Mock 回调结果到 API）
# 使用 host.docker.internal 访问主机上的 API 服务
WES_RESULT_CALLBACK_URL=http://host.docker.internal:8002/api/v1/callback/result

# WES 事件回调地址（ECS Mock 上报事件到 API）
# 使用 host.docker.internal 访问主机上的 API 服务
WES_EVENT_CALLBACK_URL=http://host.docker.internal:8002/api/v1/callback/event
CONTAINER_WES_EXTERNAL_CALLBACK_URL=http://api:8001/api/v1/callback/external
API_APP_ID=app_local_mock
API_APP_SECRET=local_mock_change_me
WES_EXTERNAL_CALLBACK_URL=http://host.docker.internal:8002/api/v1/callback/external

# 传感器配置
SENSOR_AUTO_TRIGGER_DEFAULT_INTERVAL=10
SENSOR_BARCODE_PREFIX=PKG

# ============================================
# 前端容器配置 (docker-compose.frontend.yml)
# ============================================
FRONTEND_ROOT=../wes_frontend
FRONTEND_ENV_FILE=.env.frontend.test
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
