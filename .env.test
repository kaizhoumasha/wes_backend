# ============================================
# 环境配置 - 测试环境
# ============================================
# 使用方式: docker-compose --profile test --env-file .env.test up -d

# 环境标识
ENV=test
COMPOSE_PROJECT_NAME=wes_backend_test
PROJECT_NAME=P9 WES
VERSION=0.1.0
DESCRIPTION=英伟达休斯顿 P9 仓库自动化执行系统
DATETIME_FORMAT=%Y-%m-%d
DATETIME_TIMEZONE=Asia/Shanghai
API_PATH=/api

# ============================================
# 构建配置
# ============================================
BACKEND_ENV_FILE=.env.test
BUILD_TARGET=development
RESTART_POLICY=no

# ============================================
# 应用配置
# ============================================
APP_ENV=test
APP_DEBUG=true
APP_PORT=8001
APP_HOST_PORT=8002

# ============================================
# 安全配置
# ============================================
# 可信反向代理 IP/CIDR；仅这些来源的 X-Forwarded-For/X-Real-IP 会被后端信任
TRUSTED_PROXY_IPS=[]

# JWT 密钥（用于 Token 签名，长度 ≥ 32）
# ⚠️ 生产环境必须使用强随机密钥，不要使用默认值
JWT_SECRET_KEY=vT3L9qP7mR2xN8cK4sJ6hB1wF5yD0uQ9eA7zX2nM4pR8kL1c

# API 加密密钥（用于敏感数据加密，Fernet 格式）
# ⚠️ 生产环境必须使用强随机密钥，不要使用默认值
# 生成方法: python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
API_SECRET_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# JWT Token 过期时间（秒）
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=86400

# ============================================
# 数据库配置 (使用独立数据库)
# ============================================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
POSTGRES_USER=wes_user
POSTGRES_PASSWORD=5oLnQuARGsLRG2CD_ynVcfUVAML6edo7cvDhxWk3n_M
POSTGRES_DB=wes_db_test

# ============================================
# Redis 配置 (使用独立 Redis)
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6380
REDIS_PASSWORD=r8KxPpMnNmRsLRG2CD_ynVcfUVAML6edo

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO
LOG_JSON_OUTPUT=true
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

# ============================================
# CORS 配置
# ============================================
# 测试环境配置具体 origin
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8080","http://127.0.0.1:5173","http://127.0.0.1:8080"]

# ============================================
# API 服务配置
# ============================================
API_REPLICAS=1
API_CPU_LIMIT=1.0
API_MEMORY_LIMIT=1G
API_CPU_RESERVATION=0.25
API_MEMORY_RESERVATION=256M

# ============================================
# Celery 配置
# ============================================
CELERY_WORKER_REPLICAS=1

# ============================================
# WMS Mock 配置 (E2E 测试)
# ============================================
WMS_SYNC_BASE_URL=http://mock_wms:8011/api/wms

# ============================================
# 测试配置
# ============================================
DB_WAIT_TIME=10
LOCUST_PORT=8089
LOCUST_TARGET_HOST=http://api:8001
LOCUST_REPORT_PATH=reports/locust/report.html

# ============================================
# 资源限制
# ============================================
POSTGRES_CONFIG_FILE=./postgresql/test.conf
POSTGRES_COMMAND=postgres -c config_file=/etc/postgresql/postgresql.conf

POSTGRES_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=2G
POSTGRES_CPU_RESERVATION=0.25
POSTGRES_MEMORY_RESERVATION=512M

REDIS_CPU_LIMIT=0.5
REDIS_MEMORY_LIMIT=1G
REDIS_CPU_RESERVATION=0.25
REDIS_MEMORY_RESERVATION=256M
REDIS_CONFIG_FILE=./redis/test.conf
REDIS_COMMAND=redis-server /usr/local/etc/redis/redis.conf

# ============================================
# Mock 服务配置 (E2E 测试)
# ============================================
# 摄像头 Mock 服务
MOCK_CAMERA_PORT=8003
MOCK_CPU_LIMIT=0.25
MOCK_MEMORY_LIMIT=128M

# 机械臂 Mock 服务
MOCK_ROBOT_ARM_PORT=8004

# WES 回调地址（机械臂回调结果到 API）
# 使用 host.docker.internal 访问主机上的 API 服务
WES_CALLBACK_URL=http://host.docker.internal:8002/api/v1/callback/result

# WES 事件回调地址（摄像头上报事件到 API）
# 使用 host.docker.internal 访问主机上的 API 服务
WES_EVENT_CALLBACK_URL=http://host.docker.internal:8002/api/v1/callback/event

# 传感器配置
SENSOR_AUTO_TRIGGER_DEFAULT_INTERVAL=10
SENSOR_BARCODE_PREFIX=PKG

# ============================================
# 前端容器配置 (docker-compose.frontend.yml)
# ============================================
FRONTEND_ROOT=../wes_frontend
FRONTEND_ENV_FILE=.env.frontend.test
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
