    # async def get_by_field(self, db: AsyncSession, field_name: str, value: Any) -> {{ class_name }} | None:
    #     result = await db.execute(
    #         select({{ class_name }}).where(getattr({{ class_name }}, field_name) == value)
    #     )
    #     return result.scalar_one_or_none()


# 创建单例
{{ module_name }}_repository = {{ class_name }}Repository()
