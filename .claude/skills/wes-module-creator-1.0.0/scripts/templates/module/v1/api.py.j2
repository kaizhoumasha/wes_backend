"""
{{ class_name }} API 路由
"""

{% if is_tree %}
from src.core.tree_api import TreeAPI
{% else %}
from src.core.base_api import BaseAPI
{% endif %}
from {{ model_import }} import (
    {{ class_name }},
    {{ class_name }}Create,
    {{ class_name }}Update,
    {% if is_tree %}
    {{ class_name }}TreeResponse,
    {% else %}
    {{ class_name }}Response,
    {% endif %}
)
from {{ service_import }} import {{ module_name }}_service


{{ module_name }}_api = {% if is_tree %}TreeAPI{% else %}BaseAPI{% endif %}(
    module_name="{{ app_name }}",
    model={{ class_name }},
    service={{ module_name }}_service,
    create_schema={{ class_name }}Create,
    update_schema={{ class_name }}Update,
    response_schema={{ class_name }}TreeResponse if {{ is_tree }} else {{ class_name }}Response,
    prefix="/{{ table_name }}",
    tags=["{{ class_name }}管理"],
    gen_create=True,
    gen_update=True,
    gen_delete=True,
    gen_bulk_delete=False,
    enable_permission=True,
)

router = {{ module_name }}_api.router

