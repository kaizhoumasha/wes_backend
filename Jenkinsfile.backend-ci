pipeline {
    agent {
        label 'WES'
    }

    environment {
        REGISTRY_URL = '192.168.0.220:5050'
        IMAGE_REPO = '192.168.0.220:5050/wes/wes_backend'
        CI_BUILD_TARGET = 'testing'
        RUNTIME_BUILD_TARGET = 'production'
        DOCKER_BUILDKIT = '1'
        BUILD_PROXY = 'http://192.168.30.111:7890'
        BUILD_NO_PROXY = '127.0.0.1,localhost,192.168.0.220,192.168.0.221,192.168.30.111'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 60, unit: 'MINUTES')
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
    }

    stages {
        stage('Checkout Source') {
            steps {
                script {
                    String sourceBranch = env.gitlabSourceBranch ?: env.gitlabBranch ?: 'develop'
                    String targetBranch = env.gitlabTargetBranch ?: ''
                    String gitlabActionType = (env.gitlabActionType ?: env.GITLAB_OBJECT_KIND ?: '').trim().toUpperCase()
                    boolean hasMergeRequestId = ((env.gitlabMergeRequestId ?: '').trim()) as boolean
                    boolean isMergeRequest = gitlabActionType.contains('MERGE') || hasMergeRequestId

                    env.CI_SOURCE_BRANCH = sourceBranch
                    env.CI_TARGET_BRANCH = targetBranch
                    env.CI_EVENT_TYPE = gitlabActionType ?: 'MANUAL'
                    env.CI_IS_MERGE_REQUEST = isMergeRequest ? 'true' : 'false'

                    echo "📥 检出源码: source=${sourceBranch}, target=${targetBranch ?: '-'}, event=${env.CI_EVENT_TYPE}"

                    def extensions = [[$class: 'CleanBeforeCheckout']]
                    if (isMergeRequest && targetBranch) {
                        extensions << [
                            $class: 'PreBuildMerge',
                            options: [
                                fastForwardMode: 'FF',
                                mergeRemote: 'origin',
                                mergeTarget: targetBranch
                            ]
                        ]
                    }

                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: "origin/${sourceBranch}"]],
                        userRemoteConfigs: [[
                            name: 'origin',
                            url: 'http://192.168.0.220:9080/wes/wes_backend.git',
                            credentialsId: 'gitlab-http-creds',
                            refspec: '+refs/heads/*:refs/remotes/origin/*'
                        ]],
                        extensions: extensions
                    ])

                    String fullCommit = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
                    String shortCommit = fullCommit.take(7)
                    String branchTag = sourceBranch.replaceAll(/[^A-Za-z0-9_.-]+/, '-')
                    String channelTag = branchTag

                    switch (sourceBranch) {
                        case 'develop':
                            channelTag = 'develop'
                            break
                        case 'main':
                            channelTag = 'prod'
                            break
                    }

                    env.CI_COMMIT_SHA = fullCommit
                    env.CI_SHORT_COMMIT = shortCommit
                    env.CI_BRANCH_TAG = branchTag
                    env.CI_CHANNEL_TAG = channelTag
                    env.CI_IMAGE = "wes-backend-ci:${env.BUILD_NUMBER}-${shortCommit}"
                    env.RUNTIME_IMAGE_LOCAL = "wes-backend-runtime:${env.BUILD_NUMBER}-${shortCommit}"
                    env.RUNTIME_IMAGE_COMMIT = "${env.IMAGE_REPO}:${env.BUILD_NUMBER}-${shortCommit}"
                    env.RUNTIME_IMAGE_CHANNEL = "${env.IMAGE_REPO}:${channelTag}"

                    echo "🐳 CI 测试镜像: ${env.CI_IMAGE}"
                    echo "🐳 Runtime 镜像: ${env.RUNTIME_IMAGE_COMMIT}"
                    echo "🐳 Runtime 渠道镜像: ${env.RUNTIME_IMAGE_CHANNEL}"
                }
            }
        }

        stage('Build CI Image') {
            steps {
                sh '''
                    set -e
                    PROXY_BUILD_ARGS=""

                    if curl -sSI -m 5 -x "${BUILD_PROXY}" https://registry-1.docker.io/v2/ >/dev/null 2>&1; then
                        echo "🌐 Build proxy available: ${BUILD_PROXY}"
                        PROXY_BUILD_ARGS="--build-arg HTTP_PROXY=${BUILD_PROXY} --build-arg HTTPS_PROXY=${BUILD_PROXY} --build-arg http_proxy=${BUILD_PROXY} --build-arg https_proxy=${BUILD_PROXY} --build-arg NO_PROXY=${BUILD_NO_PROXY} --build-arg no_proxy=${BUILD_NO_PROXY}"
                    else
                        echo "⚠️ Build proxy unavailable, continuing without proxy"
                    fi

                    docker build \
                        --provenance=false \
                        --sbom=false \
                        ${PROXY_BUILD_ARGS} \
                        --target "${CI_BUILD_TARGET}" \
                        -t "${CI_IMAGE}" \
                        .
                '''
            }
        }

        stage('Quality Checks') {
            parallel {
                stage('Format Check') {
                    steps {
                        sh '''
                            set -e
                            docker run --rm "${CI_IMAGE}" sh -c './scripts/git-quality-gate.sh --check format --ci'
                        '''
                    }
                }

                stage('Lint Check') {
                    steps {
                        sh '''
                            set -e
                            docker run --rm "${CI_IMAGE}" sh -c './scripts/git-quality-gate.sh --check lint --ci'
                        '''
                    }
                }

                stage('Security Check') {
                    steps {
                        sh '''
                            set -e
                            mkdir -p reports
                            docker run --rm \
                                -v "$WORKSPACE/reports:/artifacts/reports" \
                                "${CI_IMAGE}" \
                                sh -c './scripts/git-quality-gate.sh --check security --bandit-json /artifacts/reports/bandit-report.json --ci'
                        '''
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'reports/bandit-report.json', allowEmptyArchive: true
                        }
                    }
                }
            }
        }

        stage('Tests') {
            parallel {
                stage('Unit Tests') {
                    steps {
                        sh '''
                            set -e
                            mkdir -p reports/coverage
                            docker run --rm \
                                --env-file "$WORKSPACE/.env.test" \
                                -e APP_DEBUG=false \
                                -e LOG_LEVEL=INFO \
                                -e CELERY_LOG_LEVEL=INFO \
                                -v "$WORKSPACE/reports:/artifacts/reports" \
                                "${CI_IMAGE}" \
                                sh -c '
                                    mkdir -p /artifacts/reports/coverage &&
                                    pytest tests/ --capture=fd -v --tb=short \
                                        --cov=src \
                                        --cov-report=term-missing \
                                        --cov-report=html:/artifacts/reports/coverage \
                                        --cov-report=xml:/artifacts/reports/coverage.xml \
                                        --junitxml=/artifacts/reports/junit.xml
                                '
                        '''
                    }
                    post {
                        always {
                            junit 'reports/junit.xml'
                            script {
                                if (fileExists('reports/coverage/index.html')) {
                                    try {
                                        publishHTML([
                                            allowMissing: false,
                                            alwaysLinkToLastBuild: true,
                                            keepAll: true,
                                            reportDir: 'reports/coverage',
                                            reportFiles: 'index.html',
                                            reportName: 'Coverage Report'
                                        ])
                                    } catch (Throwable error) {
                                        echo "⚠️ 跳过 HTML 覆盖率发布: ${error.getMessage()}"
                                    }
                                } else {
                                    echo '⚠️ 未找到 HTML 覆盖率报告，跳过 publishHTML'
                                }
                            }
                            archiveArtifacts artifacts: 'reports/**/*', allowEmptyArchive: true
                        }
                    }
                }

                stage('API Signature Tests') {
                    steps {
                        sh '''
                            set -e
                            docker run --rm \
                                --env-file "$WORKSPACE/.env.test" \
                                -e APP_DEBUG=false \
                                -e LOG_LEVEL=INFO \
                                -e CELERY_LOG_LEVEL=INFO \
                                "${CI_IMAGE}" \
                                sh -c 'pytest tests/api/test_signature.py --capture=fd -v --tb=short'
                        '''
                    }
                }
            }
        }

        stage('Build Runtime Image') {
            steps {
                sh '''
                    set -e
                    PROXY_BUILD_ARGS=""

                    if curl -sSI -m 5 -x "${BUILD_PROXY}" https://registry-1.docker.io/v2/ >/dev/null 2>&1; then
                        echo "🌐 Build proxy available: ${BUILD_PROXY}"
                        PROXY_BUILD_ARGS="--build-arg HTTP_PROXY=${BUILD_PROXY} --build-arg HTTPS_PROXY=${BUILD_PROXY} --build-arg http_proxy=${BUILD_PROXY} --build-arg https_proxy=${BUILD_PROXY} --build-arg NO_PROXY=${BUILD_NO_PROXY} --build-arg no_proxy=${BUILD_NO_PROXY}"
                    else
                        echo "⚠️ Build proxy unavailable, continuing without proxy"
                    fi

                    docker build \
                        --provenance=false \
                        --sbom=false \
                        ${PROXY_BUILD_ARGS} \
                        --target "${RUNTIME_BUILD_TARGET}" \
                        -t "${RUNTIME_IMAGE_LOCAL}" \
                        .
                '''
            }
        }

        stage('Push Runtime Image') {
            when {
                expression {
                    env.CI_IS_MERGE_REQUEST != 'true'
                }
            }
            steps {
                withCredentials([usernamePassword(credentialsId: 'gitlab-http-creds', usernameVariable: 'GITLAB_USER', passwordVariable: 'GITLAB_TOKEN')]) {
                    sh '''
                        set -e
                        export REGISTRY_URL="${REGISTRY_URL}"
                        sh ./docker/test/registry-login.sh

                        docker tag "${RUNTIME_IMAGE_LOCAL}" "${RUNTIME_IMAGE_COMMIT}"
                        docker tag "${RUNTIME_IMAGE_LOCAL}" "${RUNTIME_IMAGE_CHANNEL}"
                        docker push "${RUNTIME_IMAGE_COMMIT}"
                        docker push "${RUNTIME_IMAGE_CHANNEL}"
                    '''
                }
            }
        }

        stage('Trigger Test Deploy') {
            when {
                expression {
                    env.CI_SOURCE_BRANCH == 'develop' &&
                    env.CI_EVENT_TYPE == 'PUSH'
                }
            }
            steps {
                script {
                    echo "🚀 Trigger Test Deploy: source=${env.CI_SOURCE_BRANCH}, event=${env.CI_EVENT_TYPE}, is_mr=${env.CI_IS_MERGE_REQUEST}, backend_tag=${env.CI_CHANNEL_TAG}"
                    build job: 'wes_test_deploy',
                        wait: false,
                        parameters: [
                            string(name: 'BACKEND_IMAGE_TAG', value: env.CI_CHANNEL_TAG),
                            string(name: 'FRONTEND_IMAGE_TAG', value: 'develop'),
                            string(name: 'SOURCE_BRANCH', value: env.CI_SOURCE_BRANCH)
                        ]
                }
            }
        }
    }

    post {
        always {
            sh '''
                docker image rm -f "${CI_IMAGE}" >/dev/null 2>&1 || true
                docker image rm -f "${RUNTIME_IMAGE_LOCAL}" >/dev/null 2>&1 || true
                docker image rm -f "${RUNTIME_IMAGE_COMMIT}" >/dev/null 2>&1 || true
                docker image rm -f "${RUNTIME_IMAGE_CHANNEL}" >/dev/null 2>&1 || true
            '''
            cleanWs()
        }
        success {
            echo '✅ Backend CI Pipeline 执行成功'
        }
        failure {
            echo '❌ Backend CI Pipeline 执行失败'
        }
    }
}
