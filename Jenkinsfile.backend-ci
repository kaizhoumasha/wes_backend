pipeline {
    agent {
        label 'WES'
    }

    environment {
        REGISTRY_URL = '192.168.0.220:5050'
        IMAGE_REPO = '192.168.0.220:5050/wes/wes_backend'
        CI_BUILD_TARGET = 'testing'
        RUNTIME_BUILD_TARGET = 'production'
        DOCKER_BUILDKIT = '1'
        BUILD_PROXY = 'http://192.168.30.111:7890'
        BUILD_NO_PROXY = '127.0.0.1,localhost,192.168.0.220,192.168.0.221,192.168.30.111'
    }

    options {
        buildDiscarder(logRotator(daysToKeepStr: '14', numToKeepStr: '10', artifactDaysToKeepStr: '7', artifactNumToKeepStr: '3'))
        timeout(time: 60, unit: 'MINUTES')
        skipDefaultCheckout(true)
        disableConcurrentBuilds(abortPrevious: true)
        timestamps()
    }

    stages {
        stage('Checkout Source') {
            steps {
                script {
                    String sourceBranch = env.gitlabSourceBranch ?: env.gitlabBranch ?: 'develop'
                    String targetBranch = env.gitlabTargetBranch ?: ''
                    String gitlabActionType = (env.gitlabActionType ?: env.GITLAB_OBJECT_KIND ?: '').trim().toUpperCase()
                    String beforeCommit = (env.gitlabBefore ?: '').trim()
                    String afterCommit = (env.gitlabAfter ?: '').trim()
                    boolean hasMergeRequestId = ((env.gitlabMergeRequestId ?: '').trim()) as boolean
                    boolean isMergeRequest = gitlabActionType.contains('MERGE') || hasMergeRequestId
                    boolean isDevelopPush = gitlabActionType == 'PUSH' && sourceBranch == 'develop' && !isMergeRequest
                    if (isMergeRequest && !targetBranch) {
                        error('Merge request build requires gitlabTargetBranch')
                    }

                    env.CI_SOURCE_BRANCH = sourceBranch
                    env.CI_TARGET_BRANCH = targetBranch
                    env.CI_EVENT_TYPE = gitlabActionType ?: 'MANUAL'
                    env.CI_IS_MERGE_REQUEST = isMergeRequest ? 'true' : 'false'
                    env.CI_DIFF_BASE = isMergeRequest ? "origin/${targetBranch}" : ''
                    env.CI_RELEASE_GATE_READY = 'false'

                    echo "📥 检出源码: source=${sourceBranch}, target=${targetBranch ?: '-'}, event=${env.CI_EVENT_TYPE}"

                    def extensions = [[$class: 'CleanBeforeCheckout']]
                    if (isMergeRequest && targetBranch) {
                        extensions << [
                            $class: 'PreBuildMerge',
                            options: [
                                fastForwardMode: 'FF',
                                mergeRemote: 'origin',
                                mergeTarget: targetBranch
                            ]
                        ]
                    }

                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: "origin/${sourceBranch}"]],
                        userRemoteConfigs: [[
                            name: 'origin',
                            url: 'http://192.168.0.220:9080/wes/wes_backend.git',
                            credentialsId: 'gitlab-http-creds',
                            refspec: '+refs/heads/*:refs/remotes/origin/*'
                        ]],
                        extensions: extensions
                    ])

                    String fullCommit = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
                    String sourceTree = sh(returnStdout: true, script: 'git rev-parse HEAD^{tree}').trim()
                    String shortCommit = fullCommit.take(7)
                    String branchTag = sourceBranch.replaceAll(/[^A-Za-z0-9_.-]+/, '-')
                    String channelTag = branchTag

                    if (isDevelopPush) {
                        if (!(beforeCommit ==~ /^[0-9a-fA-F]{40}$/) || beforeCommit ==~ /^0{40}$/) {
                            error('Develop push requires a non-zero 40-character gitlabBefore')
                        }
                        if (!(afterCommit ==~ /^[0-9a-fA-F]{40}$/) || !afterCommit.equalsIgnoreCase(fullCommit)) {
                            error('Develop push gitlabAfter must match the checked out HEAD')
                        }
                        int ancestryStatus = sh(
                            returnStatus: true,
                            script: "git merge-base --is-ancestor '${beforeCommit}' '${fullCommit}'"
                        )
                        if (ancestryStatus != 0) {
                            error('Develop push must fast-forward from gitlabBefore')
                        }
                        env.CI_DIFF_BASE = beforeCommit
                        env.CI_RELEASE_GATE_READY = 'true'
                    }

                    switch (sourceBranch) {
                        case 'develop':
                            channelTag = 'develop'
                            break
                        case 'main':
                            channelTag = 'prod'
                            break
                    }

                    env.CI_COMMIT_SHA = fullCommit
                    env.CI_SOURCE_TREE = sourceTree
                    env.CI_SHORT_COMMIT = shortCommit
                    env.CI_BRANCH_TAG = branchTag
                    env.CI_CHANNEL_TAG = channelTag
                    env.CI_IMAGE = "wes-backend-ci:${env.BUILD_NUMBER}-${shortCommit}"
                    env.MOCK_ECS_IMAGE = "wes-mock:${env.BUILD_NUMBER}-${shortCommit}-ecs"
                    env.MOCK_WMS_IMAGE = "wes-mock:${env.BUILD_NUMBER}-${shortCommit}-wms"
                    env.HEAVY_COMPOSE_PROJECT = "wes-backend-heavy-${env.EXECUTOR_NUMBER}-${env.BUILD_NUMBER}-${shortCommit}"
                    env.RUNTIME_IMAGE_LOCAL = "wes-backend-runtime:${env.BUILD_NUMBER}-${shortCommit}"
                    env.RUNTIME_IMAGE_COMMIT = "${env.IMAGE_REPO}:${env.BUILD_NUMBER}-${shortCommit}"
                    env.RUNTIME_IMAGE_CHANNEL = "${env.IMAGE_REPO}:${channelTag}"

                    echo "🐳 CI 测试镜像: ${env.CI_IMAGE}"
                    echo "🐳 Runtime 镜像: ${env.RUNTIME_IMAGE_COMMIT}"
                    echo "🐳 Runtime 渠道镜像: ${env.RUNTIME_IMAGE_CHANNEL}"
                }
            }
        }

        stage('Build CI Image') {
            steps {
                sh '''
                    set -e
                    PROXY_BUILD_ARGS=""

                    if curl -sSI -m 5 -x "${BUILD_PROXY}" https://registry-1.docker.io/v2/ >/dev/null 2>&1; then
                        echo "🌐 Build proxy available: ${BUILD_PROXY}"
                        PROXY_BUILD_ARGS="--build-arg HTTP_PROXY=${BUILD_PROXY} --build-arg HTTPS_PROXY=${BUILD_PROXY} --build-arg http_proxy=${BUILD_PROXY} --build-arg https_proxy=${BUILD_PROXY} --build-arg NO_PROXY=${BUILD_NO_PROXY} --build-arg no_proxy=${BUILD_NO_PROXY}"
                    else
                        echo "⚠️ Build proxy unavailable, continuing without proxy"
                    fi

                    docker build \
                        --provenance=false \
                        --sbom=false \
                        ${PROXY_BUILD_ARGS} \
                        --build-arg "WES_VCS_REVISION=${CI_COMMIT_SHA}" \
                        --build-arg "WES_SOURCE_TREE=${CI_SOURCE_TREE}" \
                        --target "${CI_BUILD_TARGET}" \
                        -t "${CI_IMAGE}" \
                        .
                '''
            }
        }

        stage('Verification') {
            parallel {
                stage('Quality Gate') {
                    steps {
                        sh '''
                            set -e
                            mkdir -p reports
                            docker run --rm \
                                --cpus=2 \
                                --memory=4g \
                                --env-file "$WORKSPACE/.env.test" \
                                -e ARCHITECTURE_GUARDRAIL_MODE=${ARCHITECTURE_GUARDRAIL_MODE:-enforced} \
                                -v "$WORKSPACE/.git:/app/.git:ro" \
                                -v "$WORKSPACE/reports:/app/reports" \
                                "${CI_IMAGE}" \
                                sh -c 'git config --global --add safe.directory /app && ./scripts/git-quality-gate.sh --profile quality --bandit-json /app/reports/bandit-report.json --ci'
                        '''
                    }
                    post {
                        always {
                            junit testResults: 'reports/fast-tests.xml', allowEmptyResults: true
                        }
                    }
                }

                stage('Compose Contracts') {
                    steps {
                        sh '''
                            set -eu
                            export BACKEND_IMAGE="${RUNTIME_IMAGE_LOCAL}"
                            export FRONTEND_IMAGE="example.invalid/wes/wes_frontend:compose-contract-${CI_SHORT_COMMIT}"
                            export WMS_PROVIDER_PROFILE_HOST_FILE="$WORKSPACE/.env.test"

                            docker compose \
                                --env-file .env.prod \
                                -f docker-compose.yml \
                                -f docker-compose.deploy.yml \
                                --profile prod \
                                config --no-env-resolution --quiet
                            docker compose \
                                --env-file .env.test \
                                -f docker-compose.test-deploy.yml \
                                config --no-env-resolution --quiet
                        '''
                    }
                }

                stage('RuntimeInbox PostgreSQL Acceptance') {
                    steps {
                        sh '''
                            set -e
                            chmod +x scripts/run_runtime_inbox_postgresql_acceptance_ci.sh
                            scripts/run_runtime_inbox_postgresql_acceptance_ci.sh run
                        '''
                    }
                    post {
                        always {
                            sh 'scripts/run_runtime_inbox_postgresql_acceptance_ci.sh cleanup'
                            junit testResults: 'reports/runtime-inbox-acceptance/junit/*.xml', allowEmptyResults: true
                            archiveArtifacts artifacts: 'reports/runtime-inbox-acceptance/**/*', allowEmptyArchive: true, fingerprint: true
                        }
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'reports/**/*', allowEmptyArchive: true
                }
            }
        }

        stage('Mock Image Contracts') {
            when {
                expression {
                    env.CI_IS_MERGE_REQUEST == 'true' || env.CI_RELEASE_GATE_READY == 'true'
                }
            }
            steps {
                sh '''
                    set -eu
                    docker build -f tests/mock/Dockerfile -t ${MOCK_ECS_IMAGE} -t ${MOCK_WMS_IMAGE} .
                    docker run --rm ${MOCK_ECS_IMAGE} python -c 'import ecs_mock_server'
                    docker run --rm ${MOCK_WMS_IMAGE} python -c 'import wms_mock_server'
                    docker run --rm ${MOCK_WMS_IMAGE} \
                        python -c "import asyncio; import wms_mock_server as module; status=asyncio.run(module.root()); assert status['transport_path'] == '/api/v1/wes/transport-requests'; assert status['authentication'] == 'NONE'"
                '''
            }
            post {
                always {
                    sh 'docker image rm -f ${MOCK_ECS_IMAGE} ${MOCK_WMS_IMAGE} >/dev/null 2>&1 || true'
                }
            }
        }

        stage('HEAVY Required') {
            when {
                expression {
                    (env.CI_IS_MERGE_REQUEST == 'true' || env.CI_RELEASE_GATE_READY == 'true') &&
                    env.CI_DIFF_BASE?.trim()
                }
            }
            steps {
                sh '''
                    set -eu
                    mkdir -p reports

                    docker run --rm \
                        -e CI_DIFF_BASE="${CI_DIFF_BASE}" \
                        -v "$WORKSPACE/.git:/app/.git:ro" \
                        "${CI_IMAGE}" \
                        sh -c 'git config --global --add safe.directory /app && uv run --no-sync scripts/select_heavy_tests.py --base "${CI_DIFF_BASE}"' \
                        > reports/heavy-tests.txt

                    printf '%s\n' \
                        'tests/integration/test_runtime_inbox_migration_postgresql.py' \
                        'tests/integration/test_runtime_inbox_processing_postgresql.py' \
                        'tests/resilience/test_runtime_inbox_crash_recovery_postgresql.py' \
                        'tests/load/test_runtime_inbox_claim_benchmark.py' \
                        > reports/runtime-inbox-acceptance-owned.txt
                    if grep -Fvx -f reports/runtime-inbox-acceptance-owned.txt \
                        reports/heavy-tests.txt > reports/heavy-tests.remaining.txt; then
                        :
                    else
                        grep_status=$?
                        if [ "${grep_status}" -ne 1 ]; then
                            exit "${grep_status}"
                        fi
                    fi
                    mv reports/heavy-tests.remaining.txt reports/heavy-tests.txt

                    if [ ! -s reports/heavy-tests.txt ]; then
                        echo '除已完成的 RuntimeInbox 专项验收外，本次差异未选择其它核心 HEAVY 测试。'
                        exit 0
                    fi

                    docker compose \
                        -f docker-compose.ci-heavy.yml \
                        --env-file .env.test \
                        --project-name "${HEAVY_COMPOSE_PROJECT}" \
                        up -d --wait
                    docker run --rm \
                        --env-file "$WORKSPACE/.env.test" \
                        --network "${HEAVY_COMPOSE_PROJECT}_default" \
                        -e RUN_WORKLINE_INTEGRATION=1 \
                        -v "$WORKSPACE/.git:/app/.git:ro" \
                        -v "$WORKSPACE/reports/heavy-tests.txt:/artifacts/heavy-tests.txt:ro" \
                        -v "$WORKSPACE/reports:/reports" \
                        "${CI_IMAGE}" \
                        sh -c '
                            set -eu
                            git config --global --add safe.directory /app
                            export INTEGRATION_DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}"
                            export INTEGRATION_REDIS_URL="redis://:${REDIS_PASSWORD}@redis:6379/15"
                            uv run --no-sync alembic upgrade head
                            uv run --no-sync scripts/run_selected_heavy_tests.py /artifacts/heavy-tests.txt /reports/heavy-required.xml
                        '
                '''
            }
            post {
                always {
                    junit testResults: 'reports/heavy-required.xml', allowEmptyResults: true
                    archiveArtifacts artifacts: 'reports/heavy-tests.txt,reports/heavy-required.xml,reports/runtime-inbox-acceptance-owned.txt', allowEmptyArchive: true
                    sh '''
                        docker compose \
                            -f docker-compose.ci-heavy.yml \
                            --env-file .env.test \
                            --project-name "${HEAVY_COMPOSE_PROJECT}" \
                            down --volumes --remove-orphans >/dev/null 2>&1 || true
                    '''
                }
            }
        }

        stage('Build Runtime Image') {
            steps {
                sh '''
                    set -e
                    PROXY_BUILD_ARGS=""

                    if curl -sSI -m 5 -x "${BUILD_PROXY}" https://registry-1.docker.io/v2/ >/dev/null 2>&1; then
                        echo "🌐 Build proxy available: ${BUILD_PROXY}"
                        PROXY_BUILD_ARGS="--build-arg HTTP_PROXY=${BUILD_PROXY} --build-arg HTTPS_PROXY=${BUILD_PROXY} --build-arg http_proxy=${BUILD_PROXY} --build-arg https_proxy=${BUILD_PROXY} --build-arg NO_PROXY=${BUILD_NO_PROXY} --build-arg no_proxy=${BUILD_NO_PROXY}"
                    else
                        echo "⚠️ Build proxy unavailable, continuing without proxy"
                    fi

                    docker build \
                        --provenance=false \
                        --sbom=false \
                        ${PROXY_BUILD_ARGS} \
                        --build-arg "WES_VCS_REVISION=${CI_COMMIT_SHA}" \
                        --build-arg "WES_SOURCE_TREE=${CI_SOURCE_TREE}" \
                        --target "${RUNTIME_BUILD_TARGET}" \
                        -t "${RUNTIME_IMAGE_LOCAL}" \
                        .
                '''
            }
        }

        stage('Push Runtime Image') {
            when {
                expression {
                    env.CI_EVENT_TYPE == 'PUSH' &&
                    env.CI_IS_MERGE_REQUEST != 'true' &&
                    env.CI_SOURCE_BRANCH == 'develop' &&
                    env.CI_RELEASE_GATE_READY == 'true'
                }
            }
            steps {
                withCredentials([usernamePassword(credentialsId: 'gitlab-http-creds', usernameVariable: 'GITLAB_USER', passwordVariable: 'GITLAB_TOKEN')]) {
                    sh '''
                        set -e
                        export REGISTRY_URL="${REGISTRY_URL}"
                        sh ./docker/test/registry-login.sh

                        docker tag "${RUNTIME_IMAGE_LOCAL}" "${RUNTIME_IMAGE_COMMIT}"
                        docker tag "${RUNTIME_IMAGE_LOCAL}" "${RUNTIME_IMAGE_CHANNEL}"
                        docker push "${RUNTIME_IMAGE_COMMIT}"
                        docker push "${RUNTIME_IMAGE_CHANNEL}"
                    '''
                }
            }
        }
    }

    post {
        always {
            sh '''
                docker image rm -f "${CI_IMAGE}" >/dev/null 2>&1 || true
                docker image rm -f "${RUNTIME_IMAGE_LOCAL}" >/dev/null 2>&1 || true
                docker image rm -f "${RUNTIME_IMAGE_COMMIT}" >/dev/null 2>&1 || true
                docker image rm -f "${RUNTIME_IMAGE_CHANNEL}" >/dev/null 2>&1 || true
            '''
            cleanWs()
        }
        success {
            echo '✅ Backend CI Pipeline 执行成功'
        }
        failure {
            echo '❌ Backend CI Pipeline 执行失败'
        }
    }
}
