# ============================================
# 环境配置 - 生产环境
# ============================================
# 使用方式: docker-compose --profile prod --env-file .env.prod up -d
#
# ⚠️  安全提醒:
# 1. 修改所有默认密码
# 2. 使用强随机密钥 (至少 32 字符)
# 3. 配置防火墙规则
# 4. 公网或跨网访问必须启用 HTTPS；隔离局域网内按已评审的 profile 安全策略执行
# 5. 定期备份数据

# 环境标识
ENV=prod
PROJECT_NAME=P9 WES
VERSION=0.1.0
DESCRIPTION=英伟达休斯顿 P9 仓库自动化执行系统
DATETIME_FORMAT=%Y-%m-%d
DATETIME_TIMEZONE=Asia/Shanghai
API_PATH=/api

# ============================================
# 构建配置
# ============================================
BACKEND_ENV_FILE=.env.prod
BUILD_TARGET=production
RESTART_POLICY=always

# ============================================
# 应用配置
# ============================================
APP_ENV=prod
APP_DEBUG=false
APP_PORT=8001

# ============================================
# WMS typed transport（生产部署必须提供一份宿主机 Provider profile）
# ============================================
# 宿主机文件会只读挂载到所有 WMS 进程的固定路径 /run/wes/wms-provider.yaml；留空时 Compose 拒绝渲染。
# 传输安全由 profile 决定：isolated_lan + NONE 允许使用 HTTP，其它环境按已评审的 profile 安全策略配置。
WMS_PROVIDER_PROFILE_HOST_FILE=
WMS_EFFECT_ADMISSION_ENABLED=false
WMS_EFFECT_STATUS_TIMEOUT_SECONDS=10
WMS_EFFECT_SUBMIT_TIMEOUT_SECONDS=30
WMS_EFFECT_STATUS_MAX_RESPONSE_BYTES=65536
WMS_EFFECT_IDEMPOTENCY_RETENTION_SECONDS=604800
WMS_EFFECT_STATUS_VISIBILITY_SLA_SECONDS=30
WES_EFFECT_MAX_CONFIRMATION_AGE_SECONDS=518400
WES_EFFECT_NOT_FOUND_GRACE_SECONDS=60
WES_EFFECT_STATUS_SAFETY_MARGIN_SECONDS=86400
WES_EFFECT_STATUS_SCAN_BATCH_SIZE=1
WES_EFFECT_STATUS_MAX_IN_FLIGHT=1
WES_EFFECT_STATUS_CLAIM_LEASE_SECONDS=80
WES_EFFECT_STATUS_MAX_QUERY_ATTEMPTS=20
WES_EFFECT_STATUS_INITIAL_BACKOFF_SECONDS=1
WES_EFFECT_STATUS_MAX_BACKOFF_SECONDS=60
# active revision 只决定新 binding；v1 必须保留到所有旧 Intent 的最大确认窗口结束。
WMS_QUERY_IN_PROCESS_SIMULATION_ENABLED=false
WMS_MATERIAL_FLOW_PRODUCTION_HMAC_SECRET_V1=
WMS_MATERIAL_FLOW_PRODUCTION_HMAC_SECRET_V2=
# 逗号分隔的精确版本 reference；用于紧急阻断已泄露或失效的 EXTERNAL_HTTP 凭据。
WES_REVOKED_EXTERNAL_HTTP_CREDENTIAL_REFERENCES=

# ============================================
# 安全配置
# ============================================
# 可信反向代理 IP/CIDR；生产环境必须配置为 Nginx/CDN/LB 的真实来源范围
# 示例: TRUSTED_PROXY_IPS=["10.0.0.10","192.168.0.0/16"]
TRUSTED_PROXY_IPS=[]

# JWT 密钥（用于 Token 签名，长度 ≥ 32）
# ⚠️ 必须使用强随机密钥
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=prod_jwt_token_placeholder_v1_q4w6e8r2t5y7u9i3o1p

# API 加密密钥（用于敏感数据加密，Fernet 格式）
# ⚠️ 必须使用强随机密钥
# 生成方法: python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
API_SECRET_ENCRYPTION_KEY=prod_fernet_key_change_me_immediately_XXXXXXXXXXX

# JWT Token 过期时间（秒）
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=86400

# ============================================
# 数据库配置
# ============================================
POSTGRES_HOST=postgres  # 或外部数据库 IP
POSTGRES_PORT=5432
POSTGRES_USER=wes_user
# ⚠️ 必须修改: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=5oLnQuARGsLRG2CD_ynVcfUVAML6edo7cvDhxWk3n_M
POSTGRES_DB=wes_db
DATABASE_RUNTIME_ROLE=cli
DATABASE_POOL_SIZE=1
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT=30
DATABASE_APPLICATION_NAME=prod

# 主键策略（生产环境建议开启雪花 ID）
# datacenter / worker 取值范围均为 0-7，必须保证同一套部署内唯一组合
USE_SNOWFLAKE_ID=true
SNOWFLAKE_DATACENTER_ID=1
SNOWFLAKE_WORKER_ID=1
# 默认纪元：2024-01-01T00:00:00Z；通常无需修改
SNOWFLAKE_EPOCH=1704067200000

# ============================================
# Redis 配置
# ============================================
REDIS_HOST=redis  # 或外部 Redis IP
REDIS_PORT=6379
# ⚠️ 必须修改: python -c "import secrets; print(secrets.token_urlsafe(16))"
REDIS_PASSWORD=r8KxPpMnNmRsLRG2CD_ynVcfUVAML6edo

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO
LOG_JSON_OUTPUT=true
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

# ============================================
# CORS 配置
# ============================================
# ⚠️ 生产环境必须明确配置允许的前端域名列表，不允许使用通配符
# 格式示例（三种方式均可）:
#   1. JSON 数组: CORS_ALLOWED_ORIGINS=["https://example.com","https://app.example.com"]
#   2. 逗号分隔: CORS_ALLOWED_ORIGINS=https://example.com,https://app.example.com
#   3. 单个地址: CORS_ALLOWED_ORIGINS=https://example.com
# ⚠️ 请根据实际部署域名修改以下配置
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_ORIGINS=

# Cookie 策略
# 同站点部署（推荐）:
COOKIE_SAMESITE=lax
COOKIE_SECURE=true
# 跨站点部署（前后端不同站点）:
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true  # SameSite=None 时必须为 true

# ============================================
# API 服务配置 (生产环境多实例)
# ============================================
API_REPLICAS=1
API_CPU_LIMIT=2.0
API_MEMORY_LIMIT=2G
API_CPU_RESERVATION=0.5
API_MEMORY_RESERVATION=512M

# ============================================
# Celery 配置 (生产环境多实例)
# ============================================
CELERY_WORKER_REPLICAS=4
CELERY_LOG_LEVEL=INFO
CELERY_CONCURRENCY=4
CELERY_MAX_TASKS=1000
ECS_BASE_URL=
ECS_CONNECT_TIMEOUT_SECONDS=1
ECS_READ_TIMEOUT_SECONDS=2
DEVICE_COMMAND_QUEUE=device-command
CELERY_CPU_LIMIT=2.0
CELERY_MEMORY_LIMIT=2G
CELERY_CPU_RESERVATION=0.5
CELERY_MEMORY_RESERVATION=512M

# ============================================
# Nginx 配置
# ============================================
FRONTEND_ENV_FILE=.env.frontend.prod
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_CPU_LIMIT=0.5
NGINX_MEMORY_LIMIT=256M

# ============================================
# Flower 监控配置
# ============================================
FLOWER_PORT=5555
# ⚠️ 必须修改: python -c "import secrets; print(secrets.token_urlsafe(16))"
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE_THIS_FLOWER_PASSWORD
FLOWER_CPU_LIMIT=0.25
FLOWER_MEMORY_LIMIT=256M

# ============================================
# 数据库配置
# ============================================
POSTGRES_CONFIG_FILE=./postgresql/prod.conf
POSTGRES_COMMAND=postgres -c config_file=/etc/postgresql/postgresql.conf
POSTGRES_CPU_LIMIT=4.0
POSTGRES_MEMORY_LIMIT=8G
POSTGRES_CPU_RESERVATION=1.0
POSTGRES_MEMORY_RESERVATION=2G

# ============================================
# Redis 配置
# ============================================
REDIS_CONFIG_FILE=./redis/prod.conf
REDIS_COMMAND=redis-server /usr/local/etc/redis/redis.conf
REDIS_CPU_LIMIT=2.0
REDIS_MEMORY_LIMIT=4G
REDIS_CPU_RESERVATION=0.5
REDIS_MEMORY_RESERVATION=1G

# ============================================
# 备份配置
# ============================================
BACKUP_DIR=./backups

# ============================================
# SSL 证书配置 (Let's Encrypt)
# ============================================
NGINX_SSL_DIR=./nginx/ssl

# 生产首个超级管理员 bootstrap（仅在系统中尚无超级管理员时使用）
# 推荐在首次部署时通过外部 env 覆盖，不要把真实密码提交到仓库
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=系统管理员
BOOTSTRAP_ADMIN_EMAIL=

# ============================================
# 监控和告警 (可选)
# ============================================
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
